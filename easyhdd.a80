;adresa 144 v hdd_bnk

;tabulku musime presouvat jinam, protoze leze do kodu PITa
/*
KKK
		jp	PRESKOC

TAB		equ	$-KKK+SEM1
TAB_DRV
		block	VDTLEN
*/
;; obsluha sluzeb bsdosu
PRESKOC
		push	hl
		ld	hl,RET
		ex	(sp),hl

		ld	a,b

		cp	12
		jr	z,AKTIVE1
		cp	13
		jr	z,PASIVE1
		cp	14
		jr	z,INFO1

		cp	4
; zmena, nyni se skace pouze na rutiny LBA
;SET_RDM
		jp	z,RD_SEC2
		cp	5
; zmena, nyni se skace pouze na rutiny LBA

;SET_WRM1
		jp	z,WR_SEC2
;        cp   7			;ver. 1.11
;        jp   z,WR_TRK		;end 1.11
	cp 18			;ver 1.16
	jr z,WRENA		;end 1.16
	or a		;ver 1.18
	jr z,bios_reset
         xor  a

         ret


RET
		ld	b,a
		jp	27


;---------

INFO1		ld	a,e
		call	TST_DRV
		ld	a,255
		ret	z
 	        ld de,#FF09	        ;ver. 1.08, vracime v D pocet stop a v E do bitu 3 davame BS-DOSu info, ze se jedna o IDE zarizeni
;      		ld   de,128*256+3	;end 1.08, puv. hodnota ve verzi 1.05
		xor	a
		ret

;---------

PASIVE1		ld	a,201
		ld	hl,ACT
		ld	b,a
		rst	16
		ld	a,255
		ret

;---------

AKTIVE1		call	PASIVE1
		ld	a,e
		ld (curd+1),a		;ver 1.16, end 1.16

		call	TST_DRV
		ld	a,255
		ret	z
		xor	a
		ld	hl,ACT
		ld	b,a
		rst	16
;sem umistit vycteni boot sektoru	;ver 1.14
;	ld hl,rd512_1			;pro tento ucel treba patchnout rutinu RD512, aby nacitala sektor boot do stranky EH, nasledujici pouky pouzit tehdy, kdyz potrebuju cist do stranky EH
;	ld a,#ed
;	ld (hl),a
;	inc hl
;	ld a,#41
;	ld (hl),a
;	ld hl,mbbootsec		;adresa kam vycist boot sektor

lastd	ld a,0			;ver 1.16, tady je cislo disku, se kterym se naposledy pracovalo. Pokud je AKTIVE volan se stale jednim a tim samym diskem, pak se nebude dit vycitani boot sektoru na #3800. Je to proto, protoze bsdos si na #3800 kesuje napr. DIRs sektor, a pocita s tim, ze disk nebyl vymenen a ze ten DIRs sektor na #3800 stale ma. No a pokud mu ho pokazde premazeme boot sektorem, tak pri SEARCH vyhodi chybu.	
curd	ld e,#55		;je porovnavan posledni disk a soucasny disk. Pokud pracujeme s diskem poprve, vykonej sluzbu komplet (tzn. vycti boot sektor na #3800 a vycti z nej oba udaje) a zapamatuj si cislo disku. Pokud pracujeme s diskem, se kterym jsme uz pracovali, nic nedelej a vrat se s a=2.
	cp e			
	ld a,e
	jr z,akret
	ld (lastd+1),a		;end 1.16

	ld a,#C9
	ld (rds2),a		;v RD_SEC2 nebudeme nic menit, jde jen o nacteni bootu	
	ld hl,#3800		;ctu do bufferu pro jeden sektor v bsdosu
	ld de,1			;boot sektor
	call RD_SEC2
;	ld a,(mbbootsec+6)
	push af
	ld a,#C0		;nastav RD_SEC2 aby pri nacteni boot sektoru na jakoukoliv adresu opravila bit write protectu, aby bsdos umel s timto diskem pracovat a nehazel chybu
	ld (rds2),a		;end 1.15
	pop af
	or a
	ld a,1
	ret nz			;vrat se ze sluzby AKTIVE s priznakem DISK NOT READY, pokud pri cteni sektoru nastala jakakoliv chyba
	ld hl,#3806		;vyctu pocet sektoru z boot sektoru z dosu
	call 43
	ld a,b
	ld (sctrk+1),a
				
	ld hl,#380A		;ver 1.15, vyctu info o writeprotectu. 7.bit=0= zapis povolen, 1= zapis zakazan
	call 43
	bit 7,b
	ld a,%01000000		;ver 1.18, rovnou nastavime status WP pro BSDOS	
	jr nz,ak1
	xor a			;nastavime WP interne pro EH
;ak1	ld (TAB_DRV+4),a
;	ld (TAB_DRV+4+(VDTLEN/2)),a	
ak1	ld (WR_PROT+1),a
;	ld hl,rd512_1		;vrat puvodni hodnoty
;	ld a,#cd
;	ld (hl),a
;	inc hl
;	ld a,#21
;	ld (hl),a	;end ver 1.14
akret	ld   a,2
         ret

;--------------------

WRENA xor a			;ver 1.16, sluzba WRENA nastavi interne EH na prepis boot sektoru, i kdyz ma na offsetu #A, zakazany zapis, slouzi pro vypnuti write protectu
	ld (WR_PROT+1),a
	ld (lastd+1),a
	ret			;end 1.16
;------------------------------

bios_reset		;ver 1.18
	ld hl,#222
	call 43
	ld c,b
	dec hl
	call 43
	ld a,(WR_PROT+1)	;v A nam sluzba AKTIVE primo nastavuje hotovy status pro BSDOS
	ret		;end ver 1.18
