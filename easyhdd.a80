;"osetreni stavu karty (neni MBR, partition je prazdny, oddil neni FAT, atd....implementace nove VDT tabulky, jeji format je ve zdroji GUI.a80- a eji vyplneni. Zbyva vybrat user defined partisnu, tj dodat kurzor, a taky doladit degault byte, jaka tabulka se ma sama vybrat ajko auto, aby uzivatel nemusel porad jezdit kurzorem"

;doma pushujeme 
;piseme: podpora 4 partisen. FAT16/FAT32

;LMN Patch (EasyHDD) build on Dron's HDDpatch 1.62
;public version for GIT
;20200830 - zmena rychlosti portu z 2T na 3T. Pro CPU vetsi nez 7MHz uz CF nestiha
;version 2.07
;change driver identification text "HddDrive" to "HddEH207"
;change/speed up splash screen, removed anykey
;version 2.06
; update ATA command, some was obsolete
;verze 2.05
; vylepseni detekce prvniho datoveho souboru, nyni se prohledava root a vypocte datovy sektor podle prvniho nalezeneho souboru mbd nebo mbh
; http://www.tavi.co.uk/phobos/fat.html
; detekce zda-li se jedna o disk s MBR nebo bez
; oprava vypisu kapacity velkych disku
;verze 2.04
;-uprava pro jenom master, zato muzou byt jednotky 3-255
;verze 2.03
;-porty HOOD
;verze 2.02
;- zruseni detekce slave
;- vypis rychlosti DMA prenosu
;- zmena rychlosti DMA na 3T memory a 2T port
;verze 2.01
;- deaktivace zapisu na port #0F kvuli kolizi s SounDrive
;- update 8BC logo
;verze 2.00
;- only for MB03+ Ultimate
;- deaktivace cteni portu #0F (FDC statusu)
;verze 1.06
;- oprava aplikace zmeny DMA portu, navesti se projevilo jen GUI a ne v rutinach prenosu patche
;- kosmeticke upravy zdrojoveho kodu
;- zmena barvy copyright na fialovou
;verze 1.05
;- nova DMA sekvence umoznujici pouziti i originalniho Z80-DMA chipu
;- oprava chyby ve zvukovem efektu
;- oprava detekce jednotky @127
;- upravena DMAOUT sekvence pro pouziti s originalnim Z80DMA obvodem
;verze 1.04
;- do VDT pridano General setting
;- pri autoconfiguraci se do VDT (CHS udaje) zapisuji zjistene udaje
;- vypocet prvniho datoveho sectoru
;- pridany zvukove efekty (diky pro Factor6)
;verze 1.03
;- pridano GUI
;- zobrazovani CHS a kapacity disku
;- graficka uprava
;-vsechny loga prevedeny do formatu SpriteEditoru typ 2
;verze 1.02
;- odstranen nadbytecny kod ze zdrojaku
;- opraveny chyby
;- prvni funkcni verze
;- pridana obsluha WriteProtect a master/slave
;- kontrola DMA prog. sekvence, orig. Z80DMA ready (nutno vyzkouset)
;verze 1.01 
;- zruseny vsechny rezimy krome LBA, podpora zatim pouze master disku a wp disable
;- nova VDT tabulka
;verze 1.00 
;- upraveno pro preklad SjASM   
;- zrusena modifikace portu, nyni jsou porty natvrdo, pro jine je treba nova kompilace


;poznamky
;-pri formatovani pres ff17, se disk formatuje presto ze je WP. Chyba se projevi az na konci. Delal to i hddpatch 162.

;pouziva dma prenosy
;kapacita diskimage - 2MB
;diskimage format   - 128x8x2
;slave/master, write protect
;------------------------------

	DEVICE ZXSPECTRUM48

		include "math_macros.a80"
		include "sd_macros.a80"


	org	32768
START
	IFDEF DUAL_GUI_INSTALL_TEST
	IFNDEF ELEMENT
; Kompatibilni EasyCF over jeste pred vstupem do GUI a pred prvnim
; pristupem k SD kartam. Pri chybe pouze vykresli prazdny ramec a skonci.
		di
		call	MAIN.CHECK_EASYCF_11
		jr	z,.easycf_ready
		call	GUI.draw_dual_error_overview
		ld	hl,GUI.TEXT_EASYCF_REQUIRED
		jp	MAIN.INSTALL_ERROR
.easycf_ready
	ENDIF
	ENDIF
		call	GUI.gui
		jp	MAIN.INSTALL

;virtual (floppy)disk table
;General settings
@autoinstall	db	0		;auto install (/wait for any key)
@autoconfig	db	1		;1=auto configure (automatic search for first sector & set hdd parameters to VDT)
;new parameter for EasySD. If set to 0, selection will be done manually.
@partition	db	4		;if @autoconfi=1, use values 1-4 (for SD0), 5-8 (for SD1), use partition. If not usable, use the first available from start
; EasySD 1.1: nezavisla preferovana fyzicka partition pro kazdy SD slot.
; Hodnota 1-4; neni-li pouzitelna, vybere se prvni platna na stejne karte.
@dual_partition_sd1	db	1
@dual_partition_sd2	db	1
@showsplash	db	0		;show splash screen
@playnoise	db	0		;playnoise
		db	1		;show gui
@noverify 	db	0		;disable write verify
;@dmar3		db	1		;install dma patch (oprava hodnoty dma registru R3)
@dmar3		db	0		;install dma patch (oprava hodnoty dma registru R3)	pro ucely SD vypiname DMA

; EasySD/EasyCF 1.1 - sdilena konfigurace SRAM stran pro MB03+.
; ACTIVE_PAGE je instalacni kopie. Za behu BSDOSu je aktivni stranka
; ulozena jako operand instrukce na DOS_ACTIVE_PAGE (#001C v page 97).
PAGE_BSDOS		equ	97
PAGE_CF			equ	98		;pevna zapisova hodnota pro fyzickou stranku 2
PAGE_WRITE_BASE		equ	96
PAGE_SD_MIN		equ	6		;0=BSROM, 1=BSDOS, 2=CF, 3-5=NMI
PAGE_SD_MAX		equ	32
PAGE_SD			db	9		;konfigurovatelne fyzicke cislo stranky 6-32
ACTIVE_DEVICE		db	1		;0=CF, 1=SD1, 2=SD2
ACTIVE_PAGE		db	0		;zapisova hodnota PAGE_WRITE_BASE+PAGE_SD


	IFDEF ELEMENT
;------------------------------------------------------------
; eLeMeNt ZX: enable DivSD + MB02+ compatible memory.
; On MB03+ the eLeMeNt ID is not present, so this routine
; returns without changing anything.
; eLeMeNt ZXi ports: #783B = register select, #793B = data.
; e_zxi_0FF returns #E1 on eLeMeNt ZX.
; e_zxi_001 = #02 selects DivSD + MB02+.
EL_MB02_INIT
		push	af
		push	bc

		ld	bc,#783B
		ld	a,#FF
		out	(c),a
		ld	bc,#793B
		in	a,(c)
		cp	#E1
		jr	nz,.done

		ld	bc,#783B
		ld	a,#01
		out	(c),a
		ld	bc,#793B
		ld	a,#02
		out	(c),a

.done		pop	bc
		pop	af
		ret

	ENDIF


/* presouvame na konec RAMky
;master disk
VDT		db	32,16		;Sectors/Heads
		dw	980		;Cylinders
		db	0		;Write protect
		dw	128		;first LBA sector of first file on disk

;slave disk
		db	32,16		;Sectors/Heads
		dw	980		;Cylinders
		db	0		; Write protect
		dw	128		; first LBA sector of first file on disk

VDTLEN		equ 	$-VDT
*/
VDTLEN		equ	256
;		org	align		; "align" neni definovane navesti - puvodni radek docasne vypnut

HDD_MAIN_START		equ	#0090		;zacatek hlavniho EasySD driveru v HDD bance
PIT_START		equ	#0383		;odtud zacina oblast prepisovana PIT patchem
SD_ROUTINES_START	equ	#F00		;SD routines start here- due to collision with PIT103 patch
SD1_LBA_STORE		equ	#3C90		;4B LBA vybrane partition SD1 v page 105
SD2_LBA_STORE		equ	#3C94		;4B LBA vybrane partition SD2 v page 105
	ASSERT	SD2_LBA_STORE+4 <= #3D00

;porty HOOD
P_DAT		equ	195		;8'b110xx011
P_ERR		equ	167		;8'b101xx111
P_HSE		equ	203		;8'b110xx011
P_NSE		equ	175		;8'b101xx111
P_CYL		equ	211		;8'b110xx011
P_CYH		equ	183		;8'b101xx111
P_HEA		equ	219		;8'b110xx011
P_COM		equ	191		;8'b101xx111

;porty hdd interface DRON
;P_DAT		equ	195
;P_ERR		equ	199
;P_HSE		equ	203
;P_NSE		equ	207
;P_CYL		equ	211
;P_CYH		equ	215
;P_HEA		equ	219
;P_COM		equ	223

;porty hdd interface PVL
;P_DAT		equ	163
;P_ERR		equ	167
;P_HSE		equ	171
;P_NSE		equ	175
;P_CYL		equ	179
;P_CYH		equ	183
;P_HEA		equ	187
;P_COM		equ	191

;MB02 porty
DMA		equ	11

;;;;;;;;;;;;;;;;;;;;;
; Instalace driveru ;
;;;;;;;;;;;;;;;;;;;;;
	module	MAIN

; VDT kopie pro bezici BSDOS bude fyzicky v RAM az za SD rutinami.
; Adresa SDroutines.BSDOS_VDT je dopocitana assemblerem automaticky.
TAB		equ	SDroutines.BSDOS_VDT
TAB_DRV		equ	SDroutines.BSDOS_VDT

INSTALL		di
	IFDEF ELEMENT
		call	EL_MB02_INIT
	ENDIF

; Uzivatelska konfigurace pouziva fyzicke cislo 6-32. Pro port 23
; z nej vytvor zapisovou hodnotu prictenim PAGE_WRITE_BASE (=96).
		ld	a,(PAGE_SD)
		cp	PAGE_SD_MIN
		jr	c,.bad_sd_page
		cp	PAGE_SD_MAX+1
		jr	nc,.bad_sd_page
		add	a,PAGE_WRITE_BASE
		ld	(ACTIVE_PAGE),a
		jr	.sd_page_ready
.bad_sd_page
		ld	hl,GUI.TEXT_BAD_SD_PAGE
		jp	INSTALL_ERROR
.sd_page_ready

; Je-li zvolena SD1, zacneme na ni. Pokud uzivatel vybral pouze SD2,
; aktivujeme po instalaci rovnou druhy slot.
		ld	a,(GUI.DUAL_PARTITION_SD1)
		or	a
		ld	a,1
		jr	nz,.initial_device_ready
		inc	a
.initial_device_ready
		ld	(ACTIVE_DEVICE),a

; Tato mezifaze instaluje a aktivuje SD driver na ACTIVE_PAGE. CF driver na
; page 98 tim zustava nedotceny a lze se k nemu vratit zmenou #001C na 98.

;;presun fontu do HDD banky
		ld	hl,15616
		ld	de,endfile
		ld	bc,768
		ldir

; VDT se sem uz NEkopiruje.
; Cilem je adresa v HDD/patch bance, ktera bude pripojena az pozdeji.
	call #3c9c
	ld hl,zamek	;ver 1.18
	ld de,#3cE8
	ld bc,8
	push hl
	push de
	push bc
	ldir		;end ver 1.18

	ld a,PAGE_BSDOS
	out (23),a	

	pop bc		;ver 1.18
	pop de
	pop hl
	ldir
	ld a,#1d	;rozsir bsdos o jeden znak, a to zamek
	ld (#21a1),a	;end 1.18


; ███████████████ MB03+ only ███████████████████████████████████████
		; by BusySoft
		; disable cteni portu #0F pro vyblokovani detekce WP z FDC
		; nahrada instrukce in a,(#0F) za ld a,0
		ld	hl,#020E 	;adresa v bsdosram
		ld	(hl),62		;ld a,
		inc	hl
		ld	(hl),0		;0
		; disable sending data to fdc port #0F
		; prepsani instrukce out(#0F),a dvema nopy
		ld	hl,0
		ld	(#019F),hl
		ld	(#0233),hl
; ███████████████ end - MB03+ only ███████████████████████████████████████		
		
		ld	hl,DOS_DRIVER_ENTRY_SRC
		ld	de,27			;#001B
		ld	bc,DOS_DRIVER_ENTRY_LEN
		ldir

		ld	hl,DOS_BANK_HELPERS
		ld	de,DOS_BANK_HELPERS_START
		ld	bc,DOS_BANK_HELPERS_LEN
		ldir

; Jediny runtime stav dispatcheru: operand LD A,n na page 97:#001C.
		ld	a,(ACTIVE_PAGE)
		ld	(DOS_ACTIVE_PAGE),a
		ld	a,(ACTIVE_DEVICE)
		ld	(DOS_ACTIVE_DEVICE),a
		ld	a,(ACTIVE_PAGE)
		ld	(DOS_PAGE_SD),a

; Zapamatuj si tri fyzicka cisla partition pro katalogovy text.
; SD1/SD2 jsou v poslednich dvou volnych bajtech pred PIT oblasti.
; CF pouziva samostatny bajt #3C90 v BSDOS page 97. Stejna adresa
; SD1_LBA_STORE patri do jine fyzicke stranky, proto se neprekryvaji.
		ld	a,(GUI.DUAL_PARTITION_SD1)
		ld	(DOS_SD1_PARTITION),a
		ld	a,(GUI.DUAL_PARTITION_SD2)
		ld	(DOS_SD2_PARTITION),a

		ld	a,(#DC8)			; stary EasyCF: cislice P1-P4 uvnitr textu
		sub	'0'
		cp	1
		jr	c,.cf_try_saved
		cp	5
		jr	c,.cf_partition_ready
.cf_try_saved
		ld	a,(#22F6)		; migrace ze STAGE12
		cp	1
		jr	c,.cf_try_current
		cp	5
		jr	c,.cf_partition_ready
.cf_try_current
		ld	a,(#22FE)		; migrace z kratke testovaci STAGE15
		cp	1
		jr	c,.cf_try_legacy
		cp	5
		jr	c,.cf_partition_ready
.cf_try_legacy
		ld	a,(#22FC)		; migrace ze STAGE13-20
		cp	1
		jr	c,.cf_try_stage21
		cp	5
		jr	c,.cf_partition_ready
.cf_try_stage21
		ld	a,(DOS_CF_PARTITION)	; opakovana instalace STAGE21+
		cp	1
		jr	c,.cf_partition_default
		cp	5
		jr	c,.cf_partition_ready
.cf_partition_default
		ld	a,1
.cf_partition_ready
		ld	(DOS_CF_PARTITION),a

;		ld	hl,ADR43
;		ld	de,43
;		ld	c,5
;		ldir

		ld	hl,ADR62
		ld	de,62
		ld	c,11
		ldir

	ld hl,qform	;ver. 1.13
	ld de,#123A
	ld bc,#7
	ldir		;end 1.13
         
        
	ld hl,#1CEA	;ver. 1.12, nejdrive vycistime vsech 38 bajtu
	ld de,#1CEB
	ld bc,#39
	ld hl,(0)
	ldir

	ld hl,new_r	;preneseme novou rutinu
	ld de,#1CEA	
	ld bc,newlen
	ldir
	ld (fspldir1+1),de
	ld (FREE_JP+1),de

	; Kriticka BSDOS sekvence zustava cela presne puvodni. WP cache se
	; zapisuje uz v driveru pri AKTIVE, bez hooku v teto vetvi.
	ld	hl,wp_status_call
	ld	de,#17C3
	ld	bc,8
	ldir
	ld	hl,wp_catalog_call
	ld	de,#0DF8
	ld	bc,3
	ldir
	ld	hl,wp_catalog_body
	ld	de,#0358
	ld	bc,WP_CATALOG_BODY_SIZE
	ldir
	ld	hl,wp_catalog_router
	ld	de,WP_CATALOG_ROUTER_ADDR
	ld	bc,WP_CATALOG_ROUTER_SIZE
	ldir

	IFDEF SEARCH_RETURN_DIAG
	; Docasna diagnostika pro realny MB03+: puvodni System Error #17D3
	; nahradi cislem ACTIVE_PAGE*256+A, kde A=navrat AKTIVE pred testem.
	ld	hl,search_diag_call
	ld	de,#17D0
	ld	bc,3
	ldir
	ENDIF

	jp fspldir		;STAGE20 obsahuje kontrolu EasyCF a konfiguraci page
new_r
	disp #1cea
nr	ld e,#01
	call #1d2d	;bootrd
	or a
	ret z
	ld e,#00
	call #1d2d	;bootrd
	or a
	ret z
cant	call #1EFA	;error
	db	"Can",39,"t "			;39 = ´                  		
	db	"read the ",2,0 	

adr144_cont		;ver 1.16- zde je zbytek rutiny AAA, v miste dosu #90-#FF uz nebylo misto
	jp c,RDWRSEC
	cp 18		
	jp z,RDWRSEC
	cp 8		;ver. 1.11- pri volani cteni a zapisu stopy se vrat s chybou
	ld a,#80
	ret c
;LOOP12   cp   7
;         jr   z,RDWRSEC
;         xor  a
LOOP12	xor a
LO11      ret		;end 1.11
					
newrend
newlen equ newrend-nr		;end 1.12
	ent

qform	nop		;ver 1.13
form3	inc bc
	bit 3,b
	nop
	db #28,#ed ;jr z,form2	;end 1.13

; Cela puvodni sekvence #17C3-#17CA. Ani RST #18, ani jeho bezprostredni
; navrat se nesmi premistit nebo prerusit skokem do pomocneho hooku.
wp_status_call
	push	af
	xor	a
	rst	#18
	and	#40
	jp	nz,#1DCB

; Nahrada puvodniho CALL #219E (SPACE) na #0DF8.
wp_catalog_call
	call	WP_CATALOG_ROUTER_ADDR

; Osvědcena 19B rutina ze STAGE11 musi zustat na #0358. Presun RST #18
; na #22DF ve STAGE12 zpusobil regresi .SEARCH s neprazdnym retezcem.
wp_catalog_body
	push	hl		; tiskova rutina potrebuje puvodni ukazatel
	push	bc		; bios_reset pouziva B/C pri cteni statusu
	xor	a
	rst	#18
	bit	6,a
	ld	a,#20		; nezamceny disk: mezera
	jr	z,.print
	ld	a,#1D		; zamceny disk: uzivatelsky znak zamek
.print	pop	bc
	pop	hl
	jp	#21A0		; preskoc LD A,#20, zachovej mezeru nebo zamek v A
	block	19-($-wp_catalog_body),0
WP_CATALOG_BODY_SIZE	equ $-wp_catalog_body
	ASSERT	WP_CATALOG_BODY_SIZE = 19

; #0DF8 se pouziva i pri tisku cisla adresare. Tato 10B rutina se pri
; instalaci kopiruje do rezidentniho BSDOSu #22F6-#22FF, hned za
; case_insen koncicim na #22F5. LOAD ji proto nemuze prepsat.
wp_catalog_router
	ld	a,ixh
	cp	#23
	jp	nz,#219E	;adresar/jiny text: puvodni LD A,#20
	jp	#0358		;cislo disku: osvedcena WP rutina STAGE11
WP_CATALOG_ROUTER_SIZE	equ $-wp_catalog_router
	ASSERT	WP_CATALOG_ROUTER_SIZE = 10
	ASSERT	WP_CATALOG_ROUTER_ADDR+WP_CATALOG_ROUTER_SIZE = #2300

	IFDEF SEARCH_RETURN_DIAG
search_diag_call
	call	nz,search_diag_hook

; Hook zustava v chranene casti instalatoru nad #8000 (loader pouziva
; CLEAR 32767). V BSDOSu se tedy s nicim neprekryva, zejmena ne se
; znakem zamku na #3CE8-#3CEF.
search_diag_hook
	pop	hl		;odstran puvodni navrat #17D3
	add	a,2		;L = hodnota obnovena po WP kontrole
	ld	l,a
	ld	a,(search_diag_before_wp)
	ld	h,a		;H = hodnota pred WP kontrolou (po prvnim DEC)
	push	hl		;#2264 jej vytiskne misto adresy chyby
	jp	#2264
search_diag_before_wp
	db	0
SEARCH_DIAG_HOOK_SIZE	equ $-search_diag_hook
	ASSERT	SEARCH_DIAG_HOOK_SIZE = 13
	ENDIF

;definice znaku zamek
zamek	defb 0,60,36,126,110,102,126,0		;end 1.18

CAT_DEVICE	equ	#0DC1
CAT_PARTITION	equ	#0DDF

; Over kompatibilni EasyCF v pevne strance 98. Jeho bankovni vstup
; #001B-#0020 musi po prepnuti do BSDOS page 97 pokracovat JR #0090.
; OUT ani LD nemeni priznaky, proto rutina vraci Z=kompatibilni.
CHECK_EASYCF_11
	ld	a,PAGE_CF
	out	(23),a
	ld	hl,#0008
	ld	de,EASYCF_ID
	ld	b,EASYCF_ID_LEN
	call	.compare
	jr	nz,.bad
	ld	hl,#001B
	ld	de,EASYCF_11_SIGNATURE
	ld	b,EASYCF_11_SIGNATURE_LEN
	call	.compare
	jr	nz,.bad
	xor	a
	jr	.restore
.compare
	ld	a,(de)
	cp	(hl)
	ret	nz
	inc	hl
	inc	de
	djnz	.compare
	ret
.bad	or	1
.restore
	ld	a,#40
	out	(23),a
	ret

EASYCF_11_SIGNATURE
	db	#3E,#61,#D3,#17,#18,#6F
EASYCF_11_SIGNATURE_LEN	equ	$-EASYCF_11_SIGNATURE
EASYCF_ID
	db	"EasyCF10"
EASYCF_ID_LEN	equ	$-EASYCF_ID
INSTALL_SIGNATURE_DATA
	db	"ES11"

; HL ukazuje na barevny text chyby. BSDOS ani driver se jeste nezmenil,
; takze lze bezpecne skoncit zpet do BASICu.
INSTALL_ERROR
	ld	a,#40
	out	(23),a
	ei
	push	hl
	ld	hl,GUI.TEXT_CLR
	ld	bc,#1602
	call	GUI.T42_TEXT
	pop	hl
	ld	bc,#1602
	call	GUI.T42_TEXT
	call	GUI.ANYKEY
	ret



fspldir	LD HL,FREE_JP	;ver. 1.09, ldir patche na opravu volného místa v BSDOSu 308, tento usek ponechavame i ve verzi 1.10
	 ld DE,FREE2
	 ld BC,3
         LDIR
;         LD HL,FRE2
fspldir1 ld de,#55
;	 ld DE,FREEDOS	;ver. 1.12
         LD BC,FREE_SPLEN
         LDIR		;end 1.09


;set no_verify patch
		ld	a,(@noverify)
		or	a
		jr	z,verifyyes
					
		ld	a,(#13CA)
		cp	205
		jr	nz,verifyyes	;alespon nejaka kontrola, jesli se upravuje spravne misto

;uprava dle BUSYho
		ld	a,#21
		ld	(#13CA),a	;patch ROM obsluhy #04C6
		ld	a,(#1447)
		cp	205
		jr	nz,verifyyes	;alespon nejaka kontrola, jesli se upravuje spravne misto
		ld	a,#C3
		ld	(#1447),a	;patch sluzby #25 SAVEX

;noverify podle drona ; proc se skace na adresu 62?
;(lebo je tam test, ktory pre drajvy @1-@4 povoli verify a pre drajvy @5 a vyssie ho zakaze)
;		ld	a,205
;		ld	(#13CA),a
;		ld	hl,62
;		ld	(#13CA+1),hl

verifyyes
;dmapatch; uprava cele DMA sekvence pro pouziti i originalniho Z80-DMA chipu
		ld	a,(@dmar3)
		or	a
		jr	z,dmano

		ld	a,(#1BA)
		cp	#C3
		jr	nz,dmano 	;alespon nejaka kontrola, jesli se upravuje spravne misto
		ld	a,(#1BB)
		cp	#C7
		jr	nz,dmano 	;alespon nejaka kontrola, jesli se upravuje spravne misto

;prepsani sekvence
		ld	hl,ADR442
		ld	de,#1BA		;442
		ld	bc,17
		ldir

;prepsani odkazu do nove sekvence
;		ld	a,#1c8
		ld	a,#C8
		ld	(#148),a
		ld	(#166),a
;		ld	a,#1bc
		ld	a,#BC
		ld	(#144),a
		ld	(#162),a
;		ld	a,#1BE
		ld	a,#BE
		ld	(#1B7),a
dmano
		ld	hl,SEM
		ld	de,HDD_MAIN_START
		ld	bc,112
		ldir

; Pevna pole v puvodnim hornim radku katalogu:
; #DC1-#DC2 = S1/S2/CF, #DDF-#DE0 = P1-P4.
		; Nejprve obnov cely puvodni 32znakovy radek. Tim zmizi stare
		; CF/P3 vlozene drive do prostredniho textu starsim EasyCF.
		ld	hl,CATALOG_HEADER_TEMPLATE
		ld	de,CAT_DEVICE
		ld	bc,32
		ldir

		ld	a,(ACTIVE_DEVICE)
		cp	2
		ld	hl,#3153		; v pameti "S1"
		ld	de,GUI.DUAL_PARTITION_SD1
		jr	nz,.catalog_device_ready
		ld	hl,#3253		; v pameti "S2"
		ld	de,GUI.DUAL_PARTITION_SD2
.catalog_device_ready
		ld	(CAT_DEVICE),hl
		ld	a,(de)
		add	a,'0'
		ld	h,a
		ld	l,'P'
		ld	(CAT_PARTITION),hl

		ld	a,(ACTIVE_PAGE)
		out	(23),a

		ld	hl,ADR16
		ld	de,0
		ld	bc,ADR16_LEN
;bez inir
		ldir

		ld	hl,201*256+251
		ld	(56),hl

		ld	hl,SEM1
		ld	de,144
;		ld	bc,LEN
		ld	bc,LEN_MAIN
		ldir

		ld	de,SD_ROUTINES_START
		ld	bc,LEN_SD
		ldir

; Ted je stale pripojena HDD/patch banka (98).
; Az nyni preneseme pracovni VDT na zarovnanou adresu za SD rutinami.
		ld	hl,VDT
		ld	de,SDroutines.BSDOS_VDT
		push	de
		ld	bc,VDTLEN
		ldir


		pop	de			;vyrovnej PUSH pred kopii VDT

; Uloz obe nezavisla LBA do volne oblasti driverove page 105.
		ld	hl,GUI.DUAL_LBA_SD1
		ld	de,SD1_LBA_STORE
		ld	bc,4
		ldir
		ld	hl,GUI.DUAL_LBA_SD2
		ld	de,SD2_LBA_STORE
		ld	bc,4
		ldir

; Nastav LBA a fyzicky slot prvniho aktivniho SD zarizeni.
		ld	a,(ACTIVE_DEVICE)
		cp	2
		ld	hl,GUI.DUAL_LBA_SD1
		ld	a,#FE
		jr	nz,.initial_sd_ready
		ld	hl,GUI.DUAL_LBA_SD2
		ld	a,#FD
.initial_sd_ready
		ld	(SDroutines.card_select),a
		ld	e,(hl)
		inc	hl
		ld	d,(hl)
		ex	de,hl
		ld	(current_1st_sector+1),hl
	ex	de,hl
		inc	hl
		ld	e,(hl)
		inc	hl
		ld	d,(hl)
		ex	de,hl
		ld	(current_1st_sector+4),hl

		
;mezera na PIT103
;a pokracujeme s rutinami obsluhy SD karty

;presun fontu do HDD banky
		ld	hl,endfile
		ld	de,15616
		ld	bc,768
		ldir

;------------------------------------------------------------
; Vystup z EasySD
; ELEMENT: korektni start BSDOSu pres systemovou sluzbu #30.
;          Pokud AUTOSYS neni nalezen / vrati se, provedeme
;          velky 128K reset pres BSROM (BusySoft).
; MB03+:   puvodni zpusob ukonceni zustava beze zmeny.
;
; Pri buildu pro eLeMeNt definuj symbol ELEMENT.
	IFDEF ELEMENT
		ld	a,PAGE_BSDOS	; BSDOS banka 1, zapis povolen
		out	(23),a
		ld	a,1		; aktualni BSDOS disk @1
		ld	(#03EE),a
		ld	a,#30		; BSDOS service #30 START
		rst	#20		; pokud se AUTOSYS nenajde, sluzba se vrati
		call	GUI.AUTOSYS_NOT_FOUND
		call	#3C98		; prepne na BSROM + zakaz zapisu
		xor	a
		jp	#3978		; velky 128K reset (BSROM 1.18/1.40)
	ELSE
		; Podpis zapis az po uspesnem dokonceni vsech BSDOS i SD patchu.
		; #3C90 obsahuje CF partition, #3C91-#3C94 jsou data Stage23+.
		ld	a,PAGE_BSDOS
		out	(23),a
		ld	hl,INSTALL_SIGNATURE_DATA
		ld	de,DOS_INSTALL_SIGNATURE
		ld	bc,DOS_INSTALL_SIGNATURE_LEN
		ldir
		ld	a,%01000000
		out	(23),a
		ei
		ret
	ENDIF

