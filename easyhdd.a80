v1      out (23),a	;ver 1.07, vycteni bajtu z DOSu z adresy v HL do B, Hood
vycti   ld a,97		;ADR43rutina bude vypadat: ld hl,adresa:call vycti: B=vycteny bajt
         db 24, 250	;jr v1;skok na v1;end 1.07
         

