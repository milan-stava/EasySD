ADR442
		db	$c3		;stop DMA
		db	$79		;r0 must be temporary B->A for Zilog DMA
		dw	$5555		;rd:kam
		dw	$ffff		;dlzka
		db	$14		;r1
		db	$28		;r2
		db	$80		;r3
		db	$8d		;r4
		dw	$006f		;rd:odkud (fdd)
		db	$92		;r5 Zmena:Enable wait state
		db	$cf		;zapis udajov do kanalu B
		db	$01		;r0 rd:B->A wr:A->B
		db	$cf,$87		;zapis udajov,start

