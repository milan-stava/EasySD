;adresa 144 v dos_bnk


SEM
		DISP	144
;;		DISP	SEM
;;		put	SEM


ADR144D
		push	hl
		ld	hl,255
		ld	(hl),a
		dec	hl
		ex	(sp),hl

		cp	12
;		jr	z,PRYC
		jr	c,SKIP1
		cp	15
		jr	c,SLUZ1214
SKIP1
		cp 18		;ver. 1.16, WRENA probehne pouze pokud byla predtim volana sluzba AKTIVE, vraci v a=0 pokud probehne, pokud ne, vraci 18
		jr z,ACT	;end 1.16

		cp	16
		jr	z,SETMLT
		cp	15
		ret	nc
		or	a
ACT		ret

		inc	sp
		inc	sp
AAA
		jr	z,RDWRSEC
		cp	4
		jp	c,LOOP12
		cp	6
		jp	adr144_cont	;ver 1.16, skok na #1DOC, zbytek rutiny umistujeme za patch volneho mista v dosu
;	cp 8		;ver. 1.11- pri volani cteni a zapisu stopy se vrat s chybou
;	ld a,#80
;	jr c,LO11
;LOOP12   cp   7
;         jr   z,RDWRSEC
;         xor  a
;LOOP12	xor a
;LO11      ret		;end 1.11


RDWRSEC		push	hl
		push	de
		ld	b,a
		ld	(SP_ST+1),sp
		ld	sp,128		;!!!
		call	27		;rutina v im2 by radeji nemela strankovat rom...
SP_ST		ld	sp,0		;im1 fpohode, nmi nevim
		push	bc
RUT		call	NIC
		pop	af
		pop	de
		pop	hl
NIC		ret


SETMLT		ld	a,h
		or	l
		jr	nz,LOOP14
		ld	hl,NIC
LOOP14		ld	(RUT+1),hl
		ret


SLUZ1214
		push	de
		push	hl
		ld	b,a
		ld	(SP_ST+1),sp
		ld	sp,128
		call	27
		ld	sp,(SP_ST+1)
		ld	a,b
		pop	hl
		or	a
		jr	nz,NO_NFO
		inc	sp
		inc	sp
		push	de
NO_NFO
		pop	de
		cp	255
		ret	z
;nz=hned se vrat
;z=predej dal
PRYC
		inc	sp
		inc	sp
		ret

;         nop		;oba nopy vyhodit, zvetsila se nam rutina AAA
         nop		;ver 1.18

A1_254
		ld	a,85
;tady je uz adresa 256


;------------------------------
; HDD banka
;------------------------------
					ent

					
SEM1     	;equ	$-ADR144D+SEM
		disp	144
;;		DISP	SEM1
;;		put	SEM1

;adresa 144 v hdd_bnk

;tabulku musime presouvat jinam, protoze leze do kodu PITa
/*
KKK
		jp	PRESKOC

TAB		equ	$-KKK+SEM1
TAB_DRV
		block	VDTLEN
*/
;; obsluha sluzeb bsdosu
PRESKOC
		push	hl
		ld	hl,RET
		ex	(sp),hl

		ld	a,b

		cp	12
		jr	z,AKTIVE1
		cp	13
		jr	z,PASIVE1
		cp	14
		jr	z,INFO1

		cp	4
; zmena, nyni se skace pouze na rutiny LBA
;SET_RDM
		jp	z,RD_SEC2
		cp	5
; zmena, nyni se skace pouze na rutiny LBA

;SET_WRM1
		jp	z,WR_SEC2
;        cp   7			;ver. 1.11
;        jp   z,WR_TRK		;end 1.11
	cp 18			;ver 1.16
	jr z,WRENA		;end 1.16
	or a		;ver 1.18
	jr z,bios_reset
         xor  a

         ret


RET
		ld	b,a
		jp	27


;---------

INFO1		ld	a,e
		call	TST_DRV
		ld	a,255
		ret	z
 	        ld de,#FF09	        ;ver. 1.08, vracime v D pocet stop a v E do bitu 3 davame BS-DOSu info, ze se jedna o IDE zarizeni
;      		ld   de,128*256+3	;end 1.08, puv. hodnota ve verzi 1.05
		xor	a
		ret

;---------

PASIVE1		ld	a,201
		ld	hl,ACT
		ld	b,a
		rst	16
		ld	a,255
		ret

;---------

AKTIVE1		call	PASIVE1
		ld	a,e
		ld (curd+1),a		;ver 1.16, end 1.16

		call	TST_DRV
		ld	a,255
		ret	z
		xor	a
		ld	hl,ACT
		ld	b,a
		rst	16
;sem umistit vycteni boot sektoru	;ver 1.14
;	ld hl,rd512_1			;pro tento ucel treba patchnout rutinu RD512, aby nacitala sektor boot do stranky EH, nasledujici pouky pouzit tehdy, kdyz potrebuju cist do stranky EH
;	ld a,#ed
;	ld (hl),a
;	inc hl
;	ld a,#41
;	ld (hl),a
;	ld hl,mbbootsec		;adresa kam vycist boot sektor

lastd	ld a,0			;ver 1.16, tady je cislo disku, se kterym se naposledy pracovalo. Pokud je AKTIVE volan se stale jednim a tim samym diskem, pak se nebude dit vycitani boot sektoru na #3800. Je to proto, protoze bsdos si na #3800 kesuje napr. DIRs sektor, a pocita s tim, ze disk nebyl vymenen a ze ten DIRs sektor na #3800 stale ma. No a pokud mu ho pokazde premazeme boot sektorem, tak pri SEARCH vyhodi chybu.	
curd	ld e,#55		;je porovnavan posledni disk a soucasny disk. Pokud pracujeme s diskem poprve, vykonej sluzbu komplet (tzn. vycti boot sektor na #3800 a vycti z nej oba udaje) a zapamatuj si cislo disku. Pokud pracujeme s diskem, se kterym jsme uz pracovali, nic nedelej a vrat se s a=2.
	cp e			
	ld a,e
	jr z,akret
	ld (lastd+1),a		;end 1.16

	ld a,#C9
	ld (rds2),a		;v RD_SEC2 nebudeme nic menit, jde jen o nacteni bootu	
	ld hl,#3800		;ctu do bufferu pro jeden sektor v bsdosu
	ld de,1			;boot sektor
	call RD_SEC2
;	ld a,(mbbootsec+6)
	push af
	ld a,#C0		;nastav RD_SEC2 aby pri nacteni boot sektoru na jakoukoliv adresu opravila bit write protectu, aby bsdos umel s timto diskem pracovat a nehazel chybu
	ld (rds2),a		;end 1.15
	pop af
	or a
	ld a,1
	ret nz			;vrat se ze sluzby AKTIVE s priznakem DISK NOT READY, pokud pri cteni sektoru nastala jakakoliv chyba
	ld hl,#3806		;vyctu pocet sektoru z boot sektoru z dosu
	call 43
	ld a,b
	ld (sctrk+1),a
				
	ld hl,#380A		;ver 1.15, vyctu info o writeprotectu. 7.bit=0= zapis povolen, 1= zapis zakazan
	call 43
	bit 7,b
	ld a,%01000000		;ver 1.18, rovnou nastavime status WP pro BSDOS	
	jr nz,ak1
	xor a			;nastavime WP interne pro EH
;ak1	ld (TAB_DRV+4),a
;	ld (TAB_DRV+4+(VDTLEN/2)),a	
ak1	ld (WR_PROT+1),a
;	ld hl,rd512_1		;vrat puvodni hodnoty
;	ld a,#cd
;	ld (hl),a
;	inc hl
;	ld a,#21
;	ld (hl),a	;end ver 1.14
akret	ld   a,2
         ret

;--------------------

WRENA xor a			;ver 1.16, sluzba WRENA nastavi interne EH na prepis boot sektoru, i kdyz ma na offsetu #A, zakazany zapis, slouzi pro vypnuti write protectu
	ld (WR_PROT+1),a
	ld (lastd+1),a
	ret			;end 1.16
;------------------------------

bios_reset		;ver 1.18
	ld hl,#222
	call 43
	ld c,b
	dec hl
	call 43
	ld a,(WR_PROT+1)	;v A nam sluzba AKTIVE primo nastavuje hotovy status pro BSDOS
	ret		;end ver 1.18
;------------------------------



;------------------------------
;vypocita log.cislo sektoru
;z udaju pro disketu
;hl se nezmeni, udaj je vlozen
;primo do rutiny prepoc
;SECT_NUM
;
;         push hl
;         ld   l,d
;         ld   h,0
;         add  hl,hl
;         add  hl,hl
;         add  hl,hl
;         add  hl,hl
;*16
;         ld   a,e
;         dec  a
;         and  %00000111
;         bit  7,e
;         jr   z,RDS1
;         or   %00001000
;RDS1
;         or   l
;         ld   l,a

;hl = log. cislo sectoru
;     pocita se od 0

;ver 1.07, radne pocitani cisla sektoru, napsal Busy
SECT_NUM           ;Vstup: DE = fyzicke cislo sektora z BSDOSu
        push hl
        ld hl,#2306
        call 43       ;skok na rutinu vycti
        ld a,b
        ld (sctrk+1),a  
        xor a
        ld b,a
        ld c,d
        ld l,b
        ld h,b
        ld d,b
        ld a,e
        add a,e
        rl c
        rl b         ;BC=2*stopa+strana
sctrk ld a,#55 ;A=sectrk
nasob   add hl,bc
        dec a
        jr nz,nasob  ;hl=sectrk*(2*stopa+strana)
        res 7,e
        dec e        ;e=sektor-1
        add hl,de    ;hl=sectrk*(2*stopa+strana)+(sektor-1)
        add hl,hl    ;hl=2*(sectrk*(2*stopa+strana)+(sektor-1))	;end 1.07

;jeste se vynasobi dvema
;harddisk ma sektor 512 bajtu
;musime precist dva sektory

		ld	(PREPOC+1),hl
		ld	a,h
		pop	hl
		and	%11110000
		ret	z

		ld	a,%00010000
		or	a
		ret
;seek error (zapis za hranici)
;------------------------------

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;pricte sector vyzadovany bsdosem k prvnimu LBA sectoru dane disk. jednotku
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
PREP_LBA
PREPOC		ld	hl,0
LOW24		ld	de,0
		add	hl,de
HIG24		ld	de,0
		jr	nc,PREP2
		inc	de
;b - hlavicka 219
;c - sektor 207
;de - cyl  e - 211, d -215
PREP2
		ex	de,hl
; vystup primo pro SD rutiny:
; HL = horni 16 bitu LBA, DE = dolni 16 bitu LBA
		ret

; fyzicke cteni sectoru
READ1				;cteni sektoru z SD karty
; vstup: IX=buffer, HL=horni 16 bitu LBA, DE=dolni 16 bitu LBA
	push	ix
	pop	bc
	ld	(rea1+1),bc
	push	hl		;horni 16 bitu LBA
	push	de		;dolni 16 bitu LBA
	call	@SDroutines.SD_READ	;1x 512 bytes
rea1	ld	hl,#5555
	ld	bc,512
	add	hl,bc
	push	hl
	pop	ix
	pop	de		;dolni reg
	pop	hl		;horni reg
	inc	de		;zvys sektor o 1
	ld	a,d
	or	e
	jr	nz,rea2
	inc	hl
rea2	call	@SDroutines.SD_READ	;1x 512 bytes, tj celkem 1024 bajtu=1 sektor BSDOSu
	xor	a
	ret			;later change to JP only.... call is for tetsing purposes	


/*
READ1
		call	TST_BSY
		jp	nz,ERROR
		ld	a,b
; nyni je navrdo LBA nastavuje se v rut. TST_DRV
HEA_RD1		or	%11100000
		out	(P_HEA),a
;cislo hlavicky

		ld	a,2
		out	(P_HSE),a
;pocet sektoru

		ld	a,c
		out	(P_NSE),a
;cislo sektoru od 1

		ld	a,e
		out	(P_CYL),a
		ld	a,d
		out	(P_CYH),a
;cislo cylindru

		ld	a,#20
;		ld	a,#21		;LMN - #21 obsolete command
		out	(P_COM),a
;read with retries

		call	TST_BSY
		jr	nz,ERROR

		call	RD_512

		call	TST_ERR
		jr	nz,ERROR

		call	TST_BSY
		jr	nz,ERROR

		call	RD_512

		call	TST_ERR
		jr	nz,ERROR

		xor	a
		ret
*/
;------------------------------
; fyzicky zapis sectoru
WRITE1
; vstup: IX=buffer, HL=horni 16 bitu LBA, DE=dolni 16 bitu LBA
	push	ix
	pop	bc
	ld	(wri1+1),bc
	push	hl		;horni 16 bitu LBA
	push	de		;dolni 16 bitu LBA
	call	@SDroutines.SD_WRITE
wri1	ld	hl,#5555
	ld	bc,512
	add	hl,bc
	push	hl
	pop	ix
	pop	de		;dolni reg
	pop	hl		;horni reg
	inc	de		;zvys sektor o 1
	ld	a,d
	or	e
	jr	nz,wri2
	inc	hl
wri2	call	@SDroutines.SD_WRITE	;1x 512 bytes, tj celkem 1024 bajtu=1 sektor BSDOSu
	xor	a
	ret			;later change to JP only.... call is for tetsing purposes	


/*
WRITE1

		call	TST_BSY
		jr	nz,ERROR

		ld	a,b
; nyni je navrdo LBA nastavuje se v rut. TST_DRV
HEA_WR1		or	%11100000
		out	(P_HEA),a
;hlavicka

		ld	a,2
		out	(P_HSE),a
;pocet sektoru
		ld	a,c
		out	(P_NSE),a
;cislo sektoru od 1
		ld	a,e
		out	(P_CYL),a
		ld	a,d
		out	(P_CYH),a
;cislo cylindru
		ld	a,#30
;		ld	a,#31		;LMN - #31 obsolete command
		out	(P_COM),a
;write with retries

		call	TST_BSY
		jr	nz,ERROR

		call	WR_512

		call	TST_BSY
		jr	nz,ERROR
		call	TST_ERR
		jr	nz,ERROR

		call	WR_512

		call	TST_BSY
		jr	nz,ERROR
		call	TST_ERR
		jr	nz,ERROR


		xor	a
		ret
*/
;------------------------------
; fyzicky zapis tracku		;ver 1.11- vyhozen pryc, v praci s hdd netreba
;
;WR_TRK
;		ld	a,e
;		and	128
;		ld	e,a
;		xor	a
;WTRK1
;		inc	e
;		push	de
;		push	hl
;		push	af
; zmena, nyni se skace pouze na rutiny LBA
;SET_WRM2 
;		call	WR_SEC2
;		pop	af
;		pop	hl
;		ld	de,1024
;		add	hl,de
;		pop	de
;		inc	a
;		cp	9
;pocet sektoru -1
;		jr	nz,WTRK1
;
;		ret		;end 1.11

ERROR
		cp	255
		jr	nz,ERR1
		ld	a,1
		ret
ERR1
		and	%01010011
		jr	z,ERR2
		ld	a,8
		ret
ERR2
		ld	a,128
		ret

;------------------------------
;-------- LBA MODE 010 --------
;------------------------------

RD_SEC2
; prepocita log. cislo BSDOS diskety na log. cislo hdd
	ld (rdadr+1),hl			;ver 1.15- opatreni write protectu, oprava a nahrada verzi 1.16
	ld (rds1+1),de

		call	SECT_NUM
		ret	nz

; pricte pozadovany pocet LBA sektoru
; HL je adresa bufferu, proto ji dame rovnou do IX.
; PREP_LBA pak vrati LBA primo jako HLDE pro SD_READ.
		push	ix
		push	hl
		pop	ix
		call	PREP_LBA
; cte
		call	READ1
		pop	ix
	or a		;ver 1.17
	ret nz		;vrat se, doslo-li pri cteni k chybe
rdadr	ld hl,#5555	;nove ver 1.16, oprava push/popu. V HL a DE budou adresa pameti a fyzicky sektor posledniho cteni.
rds1	ld de,#5555
	dec de
	ld a,d
	or e
	ld a,0		;signalizace cteni bez chyby
rds2	ret nz		;ret nz=#C0, ret=#C9. Ver 1.17 default je #C0=RET NZ
	ld a,h		;ver 1.17
	cp #40
	jr nc,rds3	;nahravame do RAM>#4000, takze nic v boot sektoru menit nebudeme
			;nahravame boot sektor do dosu, a tam menit info o WP budeme, end 1.17
	ld de,#A	
	add hl,de
	call 43
	res 7,b
	rst 16
rds3	xor a

		ret

;------------------------------

WR_SEC2
;		ld	a,(WR_PROT+1)
;zde se testoval write protect, musi se dodelat
WR_PROT 	ld	a,0
		or	a
		ld	a,%01000000 ; status pro Bsdos - writeprotect
		ret	nz

		call	SECT_NUM
		ret	nz

; HL je adresa bufferu -> IX, PREP_LBA vrati LBA primo jako HLDE
		push	ix
		push	hl
		pop	ix
		call	PREP_LBA

		call	WRITE1
		pop	ix

		ret


;------------------------------
;---- END OF LBA MODE 010 -----
;------------------------------



;------------------------------

TST_BSY
		push	hl
		push	bc
		ld	hl,0

TST1
		dec	hl
		ld	a,l
		or	h
		jr	z,TOUT1
P84		in	a,(P_COM)
		inc	a
		jr	z,P84
		dec	a
		bit	7,a
		jr	nz,TST1
		pop	bc
		pop	hl
		ret
TOUT1
		ld	a,255
		or	a
		pop	bc
		pop	hl
		ret

;------------------------------

TST_ERR
P85		in	a,(P_COM)
		inc	a
		jr	z,P85
		dec	a
		and	1
		ret	z
		in	a,(P_ERR)
		ret

;------------------------------

;------------------------------


RD_512
		ld	(DMA_ADR1),hl
		push	hl
		ld	hl,DMA_IN
;		ld	bc,14*256+DMA
		ld	bc,((DMA_INEND-DMA_IN)*256)+DMA
		otir
		ld	a,97
		ld	b,#87
		call	OTIR
; start DMA transfer
		pop	hl
		ld	bc,512
		add	hl,bc
		ret

DMA_IN		db	195		;WR6-reset
		db	%01111101	;WR0 A->B, transfer
		dw	P_DAT		;source port
		dw	511		;lenght

;		db	%00101100	;WR1 A-port,A-fixed
		db	%01101100	;WR1 A-port,A-fixed,variable cycle
;		db	%11001110 	;2T no early cycle ends
		db	%11001101 	;3T no early cycle ends			
		 
		db	%00010000	;WR2 B-memory, B-increment - standard cycle
;		db	%01010000	;WR2 B-memory, B-increment,variable cycle
;		db	%11001110	;2T no early cycle ends

		db	%10101101	;WR4 continuous,
DMA_ADR1	dw	0		;destination
		db	%10010010	;WR5 ready low,CE/WAIT,stop on end of block
		db	#CF		;WR6 load
		db	#B3		;WR6 force ready
DMA_INEND
;-------------

WR_512
		ld	(DMA_ADR2),hl
		push	hl
		ld	hl,DMA_OUT
		ld	bc,((DMA_OUTEND-DMA_OUT)*256)+DMA
		ld	a,97
		otir
		ld	a,97
		ld	b,#87
		call	OTIR
		pop	hl
		ld	bc,512
		add	hl,bc
		ret
; nova sekvence o pro DMAOUT kompatibilni s orig. Z80DMA
DMA_OUT
		db	#C3		;WR6-reset
		db	%00000001	;WR0-Temporarily declare Port B as source in WR0 (bit 2 = 0)

		db	%00010100	;WR1-PA memory,increment, - standard cycle
;		db	%01010100	;WR1-PA memory,increment,variable cycle
;		db	%11001110	;2T no early cycle ends

;		db	%00101000	;WR2-PB io, fixed,
		db	%01101000	;WR2-PB io, fixed, variable cycle
;		db	%11001110	;2T no early cycle ends
	    db	%11001101 	;3T no early cycle ends		

		db	%10000000	;WR3
		db	%10101101	;WR4-Write Port B (fixed destination) address to WR4.
		dw	P_DAT
		db	#CF		;WR6-load
		db	%01111101	;WR0-transfer,portAtoB,block length
DMA_ADR2	dw	0
		dw	511
		db	%10010010	;WR5-stop on end,/CE/WAIT,Ready low
		db	#CF		;WR6-load
		db	#B3		;WR6-force ready
DMA_OUTEND

;DMA_out	db	195
; reset

;		db	#C7
; reset PA timing
;		db	#CB
; reset PB timing

;		db	%01111101	;WR0 transfer,portA,block length
;DMA_ADR2	dw	0
;		dw	511
; transfer,PA->PB
; start adr
; block length
;		db	%00010100	;WR1
; PA is memory,inc
;		db	%00101000	;WR2
; PB is IO,fixed

;		db	%11000100
; ?

;		db	%10101101	;WR4
;		dw	P_DAT
; continuous
; starting address
;		db	%10010010	;WR5
; stop on end,/CE/WAIT,Ready lo
;		db	#CF		;WR6
; load
;		db	#B3
; force ready

;------------------------------

; tady se musi podle cisla disk. jednotky (napr. @4) urcit master/slave a cislo LBA sectoru
; 3-127 master
; 131-255 slave
; 0,1,2,128,129,130 ret z a mozna a=0 jako nepouzite jednotky
;;uprava pro pouziti na MB03+ kde je jenom master, zato muzou byt jednotky 3-255
TST_DRV

		ld	d,a		;schovam a
		or	a		;disk 0 je neplatny, ostatni jsou ok
;		inc	a
;;		jr	z,slave		;@255 je OK a je slave
;;		jr	master		;zatim natvrdo, pak vyresit, aby disky 0,1,2 fungovaly
;;;		jr	z,master	;@255 je OK
;;					and %01111111
;;					jr z,master ;@127 je OK
;;					and %01111100
;;		and	%11111100
;;		ret	z		;test jednotek 0,1,2,128,129,130 ret z
		ret	z		;; jednotky 0,1,2
;;		bit	7,d		;test master/slave
;;		jr	nz,slave


/*
;master		ld	hl,TAB_DRV+1	;VDT tabulka					
		ld	a,(hl)
		or	a
		ret	z		;master disk neexistuje, testuje se pocest sectoru disku uvedeneho v VDT
		push	hl		;VDT tabulka
*/
;		ld	a,%11100000
;		ld	(HEA_RD1+1),a	;davame pryc zatim, pro SD verzi
;		ld	(HEA_WR1+1),a	;nastaveni master	;davame pryc zatim, pro SD verzi
					
;		ld a,(TAB_DRV+4)	;ver 1.16- zruseno, obsluha WP byla presunuta do rutiny AKTIVE 
;		ld (WR_PROT+1),a ; nastaveni WriteProtect, end 1.16
					
		ld	a,d
		dec	a		;snizime, abychom se dostali na spravny disk. Zaciname diskem 1.

		ld	de,0
		ld	hl,4096		;4096x512=delka jednoho MBD image
		call	MUL32x8
					;DEHL= vysledek
		exx
/*
;		ld	hl,VDT+1	;zatim to bereme z prvni partisny, vyresit
;		inc	hl
		pop	hl
		ld	c,(hl)
		inc	hl
		ld	b,(hl)
		inc	hl
		ld	e,(hl)
		inc	hl
		ld	d,(hl)
		ld	l,c
		ld	h,b
*/
current_1st_sector			;dulezite, tady je aktualne vybrana partisna/1 datovy sektor
		ld	hl,#5555	;nizsi LBA
		ld	de,#5555	;vyssi LBA

		call	ADD32_32
		ld	(LOW24+1),hl
		ld	(HIG24+1),de
		xor	a		;set NZ
		inc	a
		ret

/*piseme pro EasySD- pro 32 bajtove pocitani
;		dec	a		;dulezite, temito dvema dec a snizujeme disky od 1
;		dec	a
		dec	a		;odecteme 3 protoze HDD jednotky zacinaji az od 3
; A je cislo jednotky uz od nuly napr. 1 (odpovida jednotce @4)
					
		ld	l,a
		ld	h,0
		ld	d,h
		add	hl,hl
		add	hl,hl
		add	hl,hl
		add	hl,hl
; A je vynasobeno 16 a ulozeno do HL (16*256=4096 LBA sertoru= 2MB na jednotku)
		
		ld	a,(TAB_DRV+6)
		ld	e,a
; vytahneme z VDT vyssi byte adresy prvniho sectoru prvni jednotky, mel by to byt zaroven prvni sector prvniho souboru na HDD
				
		add	hl,de
; pricteme k L					
		ld	a,(TAB_DRV+5)
		ld	e,a
; vytahneme z VDT nizsi byte adresy					
					
		ld	d,l
		ld	l,h
		ld	h,0
; spravne usporadame pro LBA24 (registry lde)					
		ld	(LOW24+1),de
		ld	(HIG24+1),hl

		ld	a,e
		or	d
		or	l
; jeste test jestli lde<>0, je v podstate zbytecny, ale musi byt nz
		ret
*/

/*
;slave rusime, bude jen 1 karta, zatim
; ted to same pro slave
slave		ld	hl,TAB_DRV+(VDTLEN/2)
		ld	a,(hl)
		or	a
		ret	z		;slave disk neexistuje
					
		ld	a,%11110000
;;;		ld	(HEA_RD1+1),a	;davame pryc zatim, pro SD verzi
;;;		ld	(HEA_WR1+1),a	;nastaveni slave	;davame pryc zatim, pro SD verzi
					
;		ld a,(TAB_DRV+4+(VDTLEN/2))	;ver 1.16- zruseno, obsluha WP byla presunuta do rutiny AKTIVE 
;		ld (WR_PROT+1),a ; nastaveni WriteProtect, end 1.16
					
		res	7,d		;slave nutno zrusit bit 7
		ld	a,d
		dec	a
		dec	a
		dec	a		;odecteme 3 protoze HDD jednotky zacinaji az od 3
; A je cislo jednotky uz od nuly napr. 1 (odpovida jednotce @4)
					
		ld	l,a
		ld	h,0
		ld	d,h
		add	hl,hl
		add	hl,hl
		add	hl,hl
		add	hl,hl
; A je vynasobeno 16 a ulozeno do HL (16*256=4096 LBA sertoru= 2MB na jednotku)
		
		ld	a,(TAB_DRV+6+(VDTLEN/2))
		ld	e,a
; vytahneme z VDT vyssi byte adresy prvniho sectoru prvni jednotky, mel by to byt zaroven prvni sector prvniho souboru na HDD
				
		add	hl,de
; pricteme k L					
		ld	a,(TAB_DRV+5+(VDTLEN/2))
		ld	e,a
; vytahneme z VDT nizsi byte adresy					
					
		ld	d,l
		ld	l,h
		ld	h,0
; spravne usporadame pro LBA24 (registry lde)					
		ld	(LOW24+1),de
		ld	(HIG24+1),hl

		ld	a,e
		or	d
		or	l
; jeste test jestli lde<>0, je v podstate zbytecny, ale musi byt nz
		ret
konec ruseni slave*/

;------------------------------------------------------------------------------
; Matematicke rutiny - fyzicka kopie pro hlavni cast EasySD (MODULE MAIN)
;------------------------------------------------------------------------------
MUL32x8:
	MATH_MUL32x8

ADD32_16:
	MATH_ADD32_16

SUB32_8:
	MATH_SUB32_8

ADD32_32:
	MATH_ADD32_32

LEN_MAIN	equ	$-HDD_MAIN_START
	ASSERT	HDD_MAIN_START+LEN_MAIN <= PIT_START
		
		ent

	endmodule	; MAIN


		disp	SD_ROUTINES_START			;musime dat na adresu #F00- nize to koliduje s PIT103
	module	SDroutines
	SD_DRIVER 1

; Pracovni 256B VDT pro BSDOS:
; pouze EQU - nevklada zadnou vypln do binarky.
; Zarovnani na nejblizsi dalsi adresu xx00 za skutecnym koncem SD rutin.
BSDOS_VDT	equ	($+#FF)&$FF00
	ASSERT	(BSDOS_VDT & #FF) == 0

	endmodule
LEN_SD		equ	$-SD_ROUTINES_START

	ent

;LEN		equ	$-144			;posun kvuli PITovi


; TAB/TAB_DRV uz zde zadne bajty negeneruji.
; Pracovni VDT je v RAM na SDroutines.BSDOS_VDT.

;END1		equ	$-MAIN.KKK+MAIN.SEM1
END1		equ	$-MAIN.PRESKOC+MAIN.SEM1

;		ent

		include "GUI.a80"


	ALIGN	256
VDT		ds	256,0			;VDT tabulka bude 256 bajtu (8 zaznamu po 32 bajtech)

endfile

patchLEN	equ 	$-START

		savesna "EasySD.sna",START
;		savebin "EasySD.bin",START,patchLEN	;binarky se resi v ramci compile.bat od AI
