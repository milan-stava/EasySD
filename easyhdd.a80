;------------------------------
;adresa 62 v dos_bnk
ADR62
		ld	c,a		;test, jestli je treba verify
		ld	a,(#03EF)	;to pujde do dosu urcite
		cp	5
		ld	a,c
		ret	nc
		jp	#1463

CATALOG_HEADER_TEMPLATE
	db	"S1 BS-DOS 308b * BUSY SOFT'19 P1"
	ASSERT	$-CATALOG_HEADER_TEMPLATE = 32

;------------------------------
;------------------------------

; adresa 27 (#001B) - spolecny vstup do aktivniho driveru
DOS_DRIVER_ENTRY_SRC
		ld	a,0		;operand na #001C instalator prepise ACTIVE_PAGE
		out	(23),a
DOS_ACTIVE_PAGE	equ	#001C
		ret			;page 97: RET, driver page: JR #0090
DOS_DRIVER_ENTRY_END
DOS_DRIVER_ENTRY_LEN	equ	DOS_DRIVER_ENTRY_END-DOS_DRIVER_ENTRY_SRC

DOS_ACTIVE_DEVICE	equ	#0032
DOS_PAGE_SD		equ	#0033
DOS_SD1_PARTITION	equ	#0034
DOS_SD2_PARTITION	equ	#0035
WP_CATALOG_ROUTER_ADDR	equ	#22F6
DOS_CF_PARTITION	equ	#3C90
DOS_INSTALL_SIGNATURE	equ	#3C91
DOS_INSTALL_SIGNATURE_LEN equ	4
DRIVER_DMA_SWITCH	equ	#0367

;------------------------------
;------------------------------

; Pomocne rutiny hned za NMI #0340-#0357 a reset patchem #0358-#036A.
DOS_BANK_HELPERS_START	equ	#036B
DOS_BANK_HELPERS
		out	(c),b		;#036B: start DMA
		ld	a,(DOS_ACTIVE_PAGE)
		out	(23),a		;dalsi opcode: driver RET #0372
		ld	(hl),b		;#0372: zapis bajtu do BSDOS page
		ld	a,(DOS_ACTIVE_PAGE)
		out	(23),a		;dalsi opcode: driver RET #0378
		ld	b,(hl)		;#0378: vycteni bajtu z BSDOS page
		ld	a,(DOS_ACTIVE_PAGE)
		out	(23),a		;dalsi opcode: driver RET #037E
DOS_BANK_HELPERS_END
DOS_BANK_HELPERS_LEN	equ	DOS_BANK_HELPERS_END-DOS_BANK_HELPERS
		ASSERT	DOS_BANK_HELPERS_START+DOS_BANK_HELPERS_LEN = #037E
		ASSERT	DOS_SD2_PARTITION+1 = #0036

;------------------------------
;------------------------------

;adresa 43 v dos_bnk

;ADR43
;		inir			;puvodni non-dma prenos
;		inc	a
;		out	(23),a

;------------------------------
;------------------------------

;------------------------------
;------------------------------

;adresa 16 v hdd_bnk

;INIR		equ	41
OTIR		equ	33

ADR16
		di
		xor	a
		ld	de,65535
		jp	5
		db	"EasySD10"
;		db	"HddEH207"

		jp	DRIVER_WRITE_SWITCH	;#0010
		block	#001B-#0013,0

; #001B: navrat do BSDOS page. Pri vstupu z BSDOSu se misto JR vykona
; kod page 97 a prepne na aktivni driverovou stranku.
		ld	a,PAGE_BSDOS
		out	(23),a
		db	#18,#6F		;#001F: JR #0090

; #0021: zachovany vstup OTIR.
		jp	DRIVER_DMA_SWITCH
		block	#002B-#0024,0

; #002B: vycteni bajtu z BSDOS page 97 do B (CALL 43).
		jp	DRIVER_READ_SWITCH

ADR16_END
ADR16_LEN	equ	ADR16_END-ADR16
         

;adr41
;musi byt ld  a,97
;a taky ld bc,data_port
