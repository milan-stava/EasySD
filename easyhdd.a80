;------------------------------
;vypocita log.cislo sektoru
;z udaju pro disketu
;hl se nezmeni, udaj je vlozen
;primo do rutiny prepoc
;SECT_NUM
;
;         push hl
;         ld   l,d
;         ld   h,0
;         add  hl,hl
;         add  hl,hl
;         add  hl,hl
;         add  hl,hl
;*16
;         ld   a,e
;         dec  a
;         and  %00000111
;         bit  7,e
;         jr   z,RDS1
;         or   %00001000
;RDS1
;         or   l
;         ld   l,a

;hl = log. cislo sectoru
;     pocita se od 0

;ver 1.07, radne pocitani cisla sektoru, napsal Busy
SECT_NUM           ;Vstup: DE = fyzicke cislo sektora z BSDOSu
        push hl
        ld hl,#2306
        call 43       ;skok na rutinu vycti
        ld a,b
        ld (sctrk+1),a  
        xor a
        ld b,a
        ld c,d
        ld l,b
        ld h,b
        ld d,b
        ld a,e
        add a,e
        rl c
        rl b         ;BC=2*stopa+strana
sctrk ld a,#55 ;A=sectrk
nasob   add hl,bc
        dec a
        jr nz,nasob  ;hl=sectrk*(2*stopa+strana)
        res 7,e
        dec e        ;e=sektor-1
        add hl,de    ;hl=sectrk*(2*stopa+strana)+(sektor-1)
        add hl,hl    ;hl=2*(sectrk*(2*stopa+strana)+(sektor-1))	;end 1.07

;jeste se vynasobi dvema
;harddisk ma sektor 512 bajtu
;musime precist dva sektory

		ld	(PREPOC+1),hl
		ld	a,h
		pop	hl
		and	%11110000
		ret	z

		ld	a,%00010000
		or	a
		ret
;seek error (zapis za hranici)
;------------------------------

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;pricte sector vyzadovany bsdosem k prvnimu LBA sectoru dane disk. jednotku
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
PREP_LBA
PREPOC		ld	hl,0
LOW24		ld	de,0
		add	hl,de
HIG24		ld	de,0
		jr	nc,PREP2
		inc	de
;b - hlavicka 219
;c - sektor 207
;de - cyl  e - 211, d -215
PREP2
		ex	de,hl
; vystup primo pro SD rutiny:
; HL = horni 16 bitu LBA, DE = dolni 16 bitu LBA
		ret

; fyzicke cteni sectoru
READ1				;cteni sektoru z SD karty
; vstup: IX=buffer, HL=horni 16 bitu LBA, DE=dolni 16 bitu LBA
	push	ix
	pop	bc
	ld	(rea1+1),bc
	push	hl		;horni 16 bitu LBA
	push	de		;dolni 16 bitu LBA
	call	@SDroutines.SD_READ	;1x 512 bytes
rea1	ld	hl,#5555
	ld	bc,512
	add	hl,bc
	push	hl
	pop	ix
	pop	de		;dolni reg
	pop	hl		;horni reg
	inc	de		;zvys sektor o 1
	ld	a,d
	or	e
	jr	nz,rea2
	inc	hl
rea2	call	@SDroutines.SD_READ	;1x 512 bytes, tj celkem 1024 bajtu=1 sektor BSDOSu
	xor	a
	ret			;later change to JP only.... call is for tetsing purposes	


/*
READ1
		call	TST_BSY
		jp	nz,ERROR
		ld	a,b
; nyni je navrdo LBA nastavuje se v rut. TST_DRV
HEA_RD1		or	%11100000
		out	(P_HEA),a
;cislo hlavicky

		ld	a,2
		out	(P_HSE),a
;pocet sektoru

		ld	a,c
		out	(P_NSE),a
;cislo sektoru od 1

		ld	a,e
		out	(P_CYL),a
		ld	a,d
		out	(P_CYH),a
;cislo cylindru

		ld	a,#20
;		ld	a,#21		;LMN - #21 obsolete command
		out	(P_COM),a
;read with retries

		call	TST_BSY
		jr	nz,ERROR

		call	RD_512

		call	TST_ERR
		jr	nz,ERROR

		call	TST_BSY
		jr	nz,ERROR

		call	RD_512

		call	TST_ERR
		jr	nz,ERROR

		xor	a
		ret
*/
;------------------------------
; fyzicky zapis sectoru
WRITE1
; vstup: IX=buffer, HL=horni 16 bitu LBA, DE=dolni 16 bitu LBA
	push	ix
	pop	bc
	ld	(wri1+1),bc
	push	hl		;horni 16 bitu LBA
	push	de		;dolni 16 bitu LBA
	call	@SDroutines.SD_WRITE
wri1	ld	hl,#5555
	ld	bc,512
	add	hl,bc
	push	hl
	pop	ix
	pop	de		;dolni reg
	pop	hl		;horni reg
	inc	de		;zvys sektor o 1
	ld	a,d
	or	e
	jr	nz,wri2
	inc	hl
wri2	call	@SDroutines.SD_WRITE	;1x 512 bytes, tj celkem 1024 bajtu=1 sektor BSDOSu
	xor	a
	ret			;later change to JP only.... call is for tetsing purposes	


/*
WRITE1

		call	TST_BSY
		jr	nz,ERROR

		ld	a,b
; nyni je navrdo LBA nastavuje se v rut. TST_DRV
HEA_WR1		or	%11100000
		out	(P_HEA),a
;hlavicka

		ld	a,2
		out	(P_HSE),a
;pocet sektoru
		ld	a,c
		out	(P_NSE),a
;cislo sektoru od 1
		ld	a,e
		out	(P_CYL),a
		ld	a,d
		out	(P_CYH),a
;cislo cylindru
		ld	a,#30
;		ld	a,#31		;LMN - #31 obsolete command
		out	(P_COM),a
;write with retries

		call	TST_BSY
		jr	nz,ERROR

		call	WR_512

		call	TST_BSY
		jr	nz,ERROR
		call	TST_ERR
		jr	nz,ERROR

		call	WR_512

		call	TST_BSY
		jr	nz,ERROR
		call	TST_ERR
		jr	nz,ERROR


		xor	a
		ret
*/
;------------------------------
; fyzicky zapis tracku		;ver 1.11- vyhozen pryc, v praci s hdd netreba
;
;WR_TRK
;		ld	a,e
;		and	128
;		ld	e,a
;		xor	a
;WTRK1
;		inc	e
;		push	de
;		push	hl
;		push	af
; zmena, nyni se skace pouze na rutiny LBA
;SET_WRM2 
;		call	WR_SEC2
;		pop	af
;		pop	hl
;		ld	de,1024
;		add	hl,de
;		pop	de
;		inc	a
;		cp	9
;pocet sektoru -1
;		jr	nz,WTRK1
;
;		ret		;end 1.11

ERROR
		cp	255
		jr	nz,ERR1
		ld	a,1
		ret
ERR1
		and	%01010011
		jr	z,ERR2
		ld	a,8
		ret
ERR2
		ld	a,128
		ret

;------------------------------
;-------- LBA MODE 010 --------
;------------------------------

RD_SEC2
; prepocita log. cislo BSDOS diskety na log. cislo hdd
	ld (rdadr+1),hl			;ver 1.15- opatreni write protectu, oprava a nahrada verzi 1.16
	ld (rds1+1),de

		call	SECT_NUM
		ret	nz

; pricte pozadovany pocet LBA sektoru
; HL je adresa bufferu, proto ji dame rovnou do IX.
; PREP_LBA pak vrati LBA primo jako HLDE pro SD_READ.
		push	ix
		push	hl
		pop	ix
		call	PREP_LBA
; cte
		call	READ1
		pop	ix
	or a		;ver 1.17
	ret nz		;vrat se, doslo-li pri cteni k chybe
rdadr	ld hl,#5555	;nove ver 1.16, oprava push/popu. V HL a DE budou adresa pameti a fyzicky sektor posledniho cteni.
rds1	ld de,#5555
	dec de
	ld a,d
	or e
	ld a,0		;signalizace cteni bez chyby
rds2	ret nz		;ret nz=#C0, ret=#C9. Ver 1.17 default je #C0=RET NZ
	ld a,h		;ver 1.17
	cp #40
	jr nc,rds3	;nahravame do RAM>#4000, takze nic v boot sektoru menit nebudeme
			;nahravame boot sektor do dosu, a tam menit info o WP budeme, end 1.17
	ld de,#A	
	add hl,de
	call 43
	res 7,b
	rst 16
rds3	xor a

		ret

;------------------------------

WR_SEC2
;		ld	a,(WR_PROT+1)
;zde se testoval write protect, musi se dodelat
WR_PROT 	ld	a,0
		or	a
		ld	a,%01000000 ; status pro Bsdos - writeprotect
		ret	nz

		call	SECT_NUM
		ret	nz

; HL je adresa bufferu -> IX, PREP_LBA vrati LBA primo jako HLDE
		push	ix
		push	hl
		pop	ix
		call	PREP_LBA

		call	WRITE1
		pop	ix

		ret


;------------------------------
;---- END OF LBA MODE 010 -----
;------------------------------



;------------------------------

TST_BSY
		push	hl
		push	bc
		ld	hl,0

TST1
		dec	hl
		ld	a,l
		or	h
		jr	z,TOUT1
P84		in	a,(P_COM)
		inc	a
		jr	z,P84
		dec	a
		bit	7,a
		jr	nz,TST1
		pop	bc
		pop	hl
		ret
TOUT1
		ld	a,255
		or	a
		pop	bc
		pop	hl
		ret

;------------------------------

TST_ERR
P85		in	a,(P_COM)
		inc	a
		jr	z,P85
		dec	a
		and	1
		ret	z
		in	a,(P_ERR)
		ret

;------------------------------

;------------------------------


RD_512
		ld	(DMA_ADR1),hl
		push	hl
		ld	hl,DMA_IN
;		ld	bc,14*256+DMA
		ld	bc,((DMA_INEND-DMA_IN)*256)+DMA
		otir
		ld	a,PAGE_BSDOS
		ld	b,#87
		call	OTIR
; start DMA transfer
		pop	hl
		ld	bc,512
		add	hl,bc
		ret

DMA_IN		db	195		;WR6-reset
		db	%01111101	;WR0 A->B, transfer
		dw	P_DAT		;source port
		dw	511		;lenght

;		db	%00101100	;WR1 A-port,A-fixed
		db	%01101100	;WR1 A-port,A-fixed,variable cycle
;		db	%11001110 	;2T no early cycle ends
		db	%11001101 	;3T no early cycle ends			
		 
		db	%00010000	;WR2 B-memory, B-increment - standard cycle
;		db	%01010000	;WR2 B-memory, B-increment,variable cycle
;		db	%11001110	;2T no early cycle ends

		db	%10101101	;WR4 continuous,
DMA_ADR1	dw	0		;destination
		db	%10010010	;WR5 ready low,CE/WAIT,stop on end of block
		db	#CF		;WR6 load
		db	#B3		;WR6 force ready
DMA_INEND
;-------------

WR_512
		ld	(DMA_ADR2),hl
		push	hl
		ld	hl,DMA_OUT
		ld	bc,((DMA_OUTEND-DMA_OUT)*256)+DMA
		ld	a,PAGE_BSDOS
		otir
		ld	a,PAGE_BSDOS
		ld	b,#87
		call	OTIR
		pop	hl
		ld	bc,512
		add	hl,bc
		ret
; nova sekvence o pro DMAOUT kompatibilni s orig. Z80DMA
DMA_OUT
		db	#C3		;WR6-reset
		db	%00000001	;WR0-Temporarily declare Port B as source in WR0 (bit 2 = 0)

		db	%00010100	;WR1-PA memory,increment, - standard cycle
;		db	%01010100	;WR1-PA memory,increment,variable cycle
;		db	%11001110	;2T no early cycle ends

;		db	%00101000	;WR2-PB io, fixed,
		db	%01101000	;WR2-PB io, fixed, variable cycle
;		db	%11001110	;2T no early cycle ends
	    db	%11001101 	;3T no early cycle ends		

		db	%10000000	;WR3
		db	%10101101	;WR4-Write Port B (fixed destination) address to WR4.
		dw	P_DAT
		db	#CF		;WR6-load
		db	%01111101	;WR0-transfer,portAtoB,block length
DMA_ADR2	dw	0
		dw	511
		db	%10010010	;WR5-stop on end,/CE/WAIT,Ready low
		db	#CF		;WR6-load
		db	#B3		;WR6-force ready
DMA_OUTEND

;DMA_out	db	195
; reset

;		db	#C7
; reset PA timing
;		db	#CB
; reset PB timing

;		db	%01111101	;WR0 transfer,portA,block length
;DMA_ADR2	dw	0
;		dw	511
; transfer,PA->PB
; start adr
; block length
;		db	%00010100	;WR1
; PA is memory,inc
;		db	%00101000	;WR2
; PB is IO,fixed

;		db	%11000100
; ?

;		db	%10101101	;WR4
;		dw	P_DAT
; continuous
; starting address
;		db	%10010010	;WR5
; stop on end,/CE/WAIT,Ready lo
;		db	#CF		;WR6
; load
;		db	#B3
; force ready

;------------------------------

; tady se musi podle cisla disk. jednotky (napr. @4) urcit master/slave a cislo LBA sectoru
; 3-127 master
; 131-255 slave
; 0,1,2,128,129,130 ret z a mozna a=0 jako nepouzite jednotky
;;uprava pro pouziti na MB03+ kde je jenom master, zato muzou byt jednotky 3-255
TST_DRV

		ld	d,a		;schovam a
		or	a		;disk 0 je neplatny, ostatni jsou ok
;		inc	a
;;		jr	z,slave		;@255 je OK a je slave
;;		jr	master		;zatim natvrdo, pak vyresit, aby disky 0,1,2 fungovaly
;;;		jr	z,master	;@255 je OK
;;					and %01111111
;;					jr z,master ;@127 je OK
;;					and %01111100
;;		and	%11111100
;;		ret	z		;test jednotek 0,1,2,128,129,130 ret z
		ret	z		;; jednotky 0,1,2
;;		bit	7,d		;test master/slave
;;		jr	nz,slave


/*
;master		ld	hl,TAB_DRV+1	;VDT tabulka					
		ld	a,(hl)
		or	a
		ret	z		;master disk neexistuje, testuje se pocest sectoru disku uvedeneho v VDT
		push	hl		;VDT tabulka
*/
;		ld	a,%11100000
;		ld	(HEA_RD1+1),a	;davame pryc zatim, pro SD verzi
;		ld	(HEA_WR1+1),a	;nastaveni master	;davame pryc zatim, pro SD verzi
					
;		ld a,(TAB_DRV+4)	;ver 1.16- zruseno, obsluha WP byla presunuta do rutiny AKTIVE 
;		ld (WR_PROT+1),a ; nastaveni WriteProtect, end 1.16
					
		ld	a,d
		dec	a		;snizime, abychom se dostali na spravny disk. Zaciname diskem 1.

		ld	de,0
		ld	hl,4096		;4096x512=delka jednoho MBD image
		call	MUL32x8
					;DEHL= vysledek
		exx
/*
;		ld	hl,VDT+1	;zatim to bereme z prvni partisny, vyresit
;		inc	hl
		pop	hl
		ld	c,(hl)
		inc	hl
		ld	b,(hl)
		inc	hl
		ld	e,(hl)
		inc	hl
		ld	d,(hl)
		ld	l,c
		ld	h,b
*/
current_1st_sector			;dulezite, tady je aktualne vybrana partisna/1 datovy sektor
		ld	hl,#5555	;nizsi LBA
		ld	de,#5555	;vyssi LBA
		ASSERT	current_1st_sector+1 = #02AB
		ASSERT	current_1st_sector+4 = #02AE

		call	ADD32_32
		ld	(LOW24+1),hl
		ld	(HIG24+1),de
		xor	a		;set NZ
		inc	a
		ret

/*piseme pro EasySD- pro 32 bajtove pocitani
;		dec	a		;dulezite, temito dvema dec a snizujeme disky od 1
;		dec	a
		dec	a		;odecteme 3 protoze HDD jednotky zacinaji az od 3
; A je cislo jednotky uz od nuly napr. 1 (odpovida jednotce @4)
					
		ld	l,a
		ld	h,0
		ld	d,h
		add	hl,hl
		add	hl,hl
		add	hl,hl
		add	hl,hl
; A je vynasobeno 16 a ulozeno do HL (16*256=4096 LBA sertoru= 2MB na jednotku)
		
		ld	a,(TAB_DRV+6)
		ld	e,a
; vytahneme z VDT vyssi byte adresy prvniho sectoru prvni jednotky, mel by to byt zaroven prvni sector prvniho souboru na HDD
				
		add	hl,de
; pricteme k L					
		ld	a,(TAB_DRV+5)
		ld	e,a
; vytahneme z VDT nizsi byte adresy					
					
		ld	d,l
		ld	l,h
		ld	h,0
; spravne usporadame pro LBA24 (registry lde)					
		ld	(LOW24+1),de
		ld	(HIG24+1),hl

		ld	a,e
		or	d
		or	l
; jeste test jestli lde<>0, je v podstate zbytecny, ale musi byt nz
		ret
*/

/*
;slave rusime, bude jen 1 karta, zatim
; ted to same pro slave
slave		ld	hl,TAB_DRV+(VDTLEN/2)
		ld	a,(hl)
		or	a
		ret	z		;slave disk neexistuje
					
		ld	a,%11110000
;;;		ld	(HEA_RD1+1),a	;davame pryc zatim, pro SD verzi
;;;		ld	(HEA_WR1+1),a	;nastaveni slave	;davame pryc zatim, pro SD verzi
					
;		ld a,(TAB_DRV+4+(VDTLEN/2))	;ver 1.16- zruseno, obsluha WP byla presunuta do rutiny AKTIVE 
;		ld (WR_PROT+1),a ; nastaveni WriteProtect, end 1.16
					
		res	7,d		;slave nutno zrusit bit 7
		ld	a,d
		dec	a
		dec	a
		dec	a		;odecteme 3 protoze HDD jednotky zacinaji az od 3
; A je cislo jednotky uz od nuly napr. 1 (odpovida jednotce @4)
					
		ld	l,a
		ld	h,0
		ld	d,h
		add	hl,hl
		add	hl,hl
		add	hl,hl
		add	hl,hl
; A je vynasobeno 16 a ulozeno do HL (16*256=4096 LBA sertoru= 2MB na jednotku)
		
		ld	a,(TAB_DRV+6+(VDTLEN/2))
		ld	e,a
; vytahneme z VDT vyssi byte adresy prvniho sectoru prvni jednotky, mel by to byt zaroven prvni sector prvniho souboru na HDD
				
		add	hl,de
; pricteme k L					
		ld	a,(TAB_DRV+5+(VDTLEN/2))
		ld	e,a
; vytahneme z VDT nizsi byte adresy					
					
		ld	d,l
		ld	l,h
		ld	h,0
; spravne usporadame pro LBA24 (registry lde)					
		ld	(LOW24+1),de
		ld	(HIG24+1),hl

		ld	a,e
		or	d
		or	l
; jeste test jestli lde<>0, je v podstate zbytecny, ale musi byt nz
		ret
konec ruseni slave*/

;------------------------------------------------------------------------------
; Matematicke rutiny - fyzicka kopie pro hlavni cast EasySD (MODULE MAIN)
;------------------------------------------------------------------------------
MUL32x8:
	MATH_MUL32x8

ADD32_16:
	MATH_ADD32_16

SUB32_8:
	MATH_SUB32_8

ADD32_32:
	MATH_ADD32_32

;------------------------------------------------------------------------------
; Page-independent bank switching stubs (EasySD/EasyCF 1.1)
;------------------------------------------------------------------------------
; Po OUT se dalsi opcode nacita uz z nove stranky. Proto jsou pokracovani
; v BSDOS page 97 a v kazde driver page na stejnych adresach.
; Rozsah NMI #0340-#0357 zustava nedotceny.

		block	#0367-$,0

DRIVER_DMA_SWITCH_SRC		;#0367
		ld	a,PAGE_BSDOS
		out	(23),a

		block	#036E-$,0

DRIVER_WRITE_SWITCH		;#036E
		ld	a,PAGE_BSDOS
		out	(23),a
		ret			;#0372 - navrat z DMA

		block	#0374-$,0

DRIVER_READ_SWITCH		;#0374
		ld	a,PAGE_BSDOS
		out	(23),a
		ret			;#0378 - navrat ze zapisu
		block	#037E-$,0
		ret			;#037E - navrat ze cteni

LEN_MAIN	equ	$-HDD_MAIN_START
	ASSERT	HDD_MAIN_START+LEN_MAIN <= PIT_START
		
		ent

	endmodule	; MAIN


		disp	SD_ROUTINES_START			;musime dat na adresu #F00- nize to koliduje s PIT103
	module	SDroutines
	SD_DRIVER 1

; Pracovni 256B VDT pro BSDOS:
; pouze EQU - nevklada zadnou vypln do binarky.
; Zarovnani na nejblizsi dalsi adresu xx00 za skutecnym koncem SD rutin.
BSDOS_VDT	equ	($+#FF)&$FF00
	ASSERT	(BSDOS_VDT & #FF) == 0

	endmodule
LEN_SD		equ	$-SD_ROUTINES_START

	ent

;LEN		equ	$-144			;posun kvuli PITovi


; TAB/TAB_DRV uz zde zadne bajty negeneruji.
; Pracovni VDT je v RAM na SDroutines.BSDOS_VDT.

;END1		equ	$-MAIN.KKK+MAIN.SEM1
END1		equ	$-MAIN.PRESKOC+MAIN.SEM1

;		ent

		include "GUI.a80"


	ALIGN	256
VDT		ds	256,0			;VDT tabulka bude 256 bajtu (8 zaznamu po 32 bajtech)

endfile

patchLEN	equ 	$-START

		savesna "EasySD.sna",START
;		savebin "EasySD.bin",START,patchLEN	;binarky se resi v ramci compile.bat od AI
