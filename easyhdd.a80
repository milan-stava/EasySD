			;ver. 1.09, patch na opravu vypoctu volneho mista, v pripade ze formatujeme maximalni mozny format pro BSDOS308, t.j. 128x8x2
;adr856 (#358)		;ver. 1.10
;FREEDOS EQU #358	;ver. 1.12, ver. 1.10,here we place the patch
FREE2   EQU #1B7A	;routine that will be repaired

FREE_JP JP #55		;to be placed on #1B7A(FREE2)
;FR2
;	PHASE FREEDOS	;ver. 1.12
FRE2 INC HL		;to be placed at free space on #1CFB
        PUSH AF
        LD A,H
        CP #34
        JR NC,YES
        POP AF
        AND E
        INC A
        JP #1B7D
YES     POP AF
        JP #1B7F
FREE_SPEND
FREE_SPLEN=FREE_SPEND-FRE2
;	DEPHASE		;ver. 1.12
PATCHEND		;end ver. 1.09

