  98  8008              ; EasySD 1.1: puvodni pozici partition z 1.0.1 pouziva preference SD1.
  99  8008              ; Alias @partition zachovava kompatibilitu starsich rutin bez dalsiho bajtu.
 100  8008 01           @dual_partition_sd1	db	1
 101  8009              @partition		equ	@dual_partition_sd1
 102  8009 00           @showsplash	db	0		;show splash screen
 103  800A 00           @playnoise	db	0		;playnoise
 104  800B 01           		db	1		;show gui
