2605  0F00              	SD_DRIVER 1
2605  0F00             >
2605  0F00             >;;;    device zxspectrum48
2605  0F00             >;;;    org 32768
2605  0F00             >DMA_SD  equ 1
2605  0F00             >start_sd
2605  0F00 CD 22 0F    >    call SD_INIT
2605  0F03 DD 21 00 11 >    ld ix,buff
2605  0F07 11 00 00    >    ld de,0
2605  0F0A 21 00 00    >    ld hl,0
2605  0F0D CD 33 10    >    call SD_READ
2605  0F10             >    ; call nz,SD_IDLE
2605  0F10 18 EE       >    jr start_sd
2605  0F12             >
2605  0F12             >card_select
2605  0F12 FE          >     db SD_0
2605  0F13             >;    db SD_1
2605  0F13             >
2605  0F13             >; based on doc http://elm-chan.org/docs/mmc/mmc_e.html
2605  0F13             >
2605  0F13             >SPI_PORT	equ 0xeb
2605  0F13             >OUT_PORT	equ 0xe7	; port for CS control (D1:D0)
2605  0F13             >DMA_PORT    equ 11
2605  0F13             >
2605  0F13             >SD_0		equ 0xFE    ;0xFE,esxdos 0xF6	; D0 LOW = SLOT0 active; D3 low = NMI disabled
2605  0F13             >SD_1		equ 0xFD    ;0xFD,esxdos 0xF5	; D1 LOW = SLOT1 active; D3 low = NMI disabled
2605  0F13             >
2605  0F13             >CMD_0		equ	0x40	; Go idle state
2605  0F13             >CMD_1		equ	0x40+1	; SEND_OP_COND
2605  0F13             >CMD_8		equ 0x40+8	; SEND_IF_COND
2605  0F13             >CMD_9		equ 0x40+9	; SEND_CSD
2605  0F13             >CMD_10		equ	0x40+10	; SEND_CID
2605  0F13             >CMD_12		equ 0x40+12	; STOP_TRANSMISSION
2605  0F13             >CMD_16		equ	0x40+16	; SET_BLOCKLEN
2605  0F13             >CMD_17		equ	0x40+17	; READ_SINGLE_BLOCK
2605  0F13             >CMD_18		equ	0x40+18	; READ_MULTIPLE_BLOCK
2605  0F13             >;CMD_23		equ 0x40+23	; SET_BLOCK_COUNT (MMC ONLY)
2605  0F13             >ACMD23		equ 0x40+23	; SET_WR_BLOCK_ERASE_COUNT
2605  0F13             >CMD_24		equ 0x40+24	; WRITE_BLOCK
2605  0F13             >CMD_25		equ 0x40+25	; WRITE_MULTIPLE_BLOCK
2605  0F13             >ACMD41		equ 0x40+41	; APP_SEND_OP_COND
2605  0F13             >CMD_55		equ 0x40+55	; APP_CMD
2605  0F13             >CMD_58		equ 0x40+58	; READ_OCR
2605  0F13             >
2605  0F13             >BLOCKSIZE	equ	512		; SD/MMC block size (bytes)
2605  0F13             >WAIT_DATA_TIMEOUT	equ	0
2605  0F13             >WAIT_CMD_TIMEOUT	equ	0
2605  0F13             >; R1 response
2605  0F13             >; D0 = Idle state / init not completed yet
2605  0F13             >; D1 = Erase Reset
2605  0F13             >; D2 = Illegal Command
2605  0F13             >; D3 = Com CRC Error
2605  0F13             >; D4 = Erase Sequence Error
2605  0F13             >; D5 = Address Error
2605  0F13             >; D6 = Parameter Error
2605  0F13             >; D7 = ALWAYS LOW
2605  0F13             >
2605  0F13 3A 12 0F    >SD_ON	ld a,(card_select)
2605  0F16 D3 E7       >	out (OUT_PORT),a
2605  0F18 3E FF       >	ld a,0xff
2605  0F1A D3 EB       >	out (SPI_PORT),a
2605  0F1C C9          >	ret
2605  0F1D             >SD_OFF
