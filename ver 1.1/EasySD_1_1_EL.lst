2605  0F47 3E FF       >    ld a,0xff                   ; cannot initialise
2605  0F49 C9          >    ret
2605  0F4A             >
2605  0F4A             >SD_POWER_ON
2605  0F4A             >; Set DI and CS high and apply 74 or more clock pulses to SCLK.
2605  0F4A             >; The card will enter its native operating mode and go ready to accept native command.
2605  0F4A 3E FF       >    ld a,0xff
2605  0F4C D3 E7       >    out (OUT_PORT),a
2605  0F4E             >    ; send 80 clocks = 10x8 bits
2605  0F4E 06 0A       >    ld b,10
2605  0F50 3E FF       >    ld a,0xff
2605  0F52             >1
2605  0F52 D3 EB       >    out (SPI_PORT),a
2605  0F54 10 FC       >    djnz 1B
2605  0F56 C9          >    ret
2605  0F57             >
2605  0F57             >SD_RESET
2605  0F57             >    ; activate CS for selected card
