 137  8019              	IFDEF ELEMENT
 138  8019              ;------------------------------------------------------------
 139  8019              ; eLeMeNt ZX: enable DivSD + MB02+ compatible memory.
 140  8019              ; On MB03+ the eLeMeNt ID is not present, so this routine
 141  8019              ; returns without changing anything.
 142  8019              ; eLeMeNt ZXi ports: #783B = register select, #793B = data.
 143  8019              ; e_zxi_0FF returns #E1 on eLeMeNt ZX.
 144  8019              ; e_zxi_001 = #02 selects DivSD + MB02+.
 145  8019              EL_MB02_INIT
 146  8019 F5           		push	af
 147  801A C5           		push	bc
 148  801B
 149  801B 01 3B 78     		ld	bc,#783B
 150  801E 3E FF        		ld	a,#FF
 151  8020 ED 79        		out	(c),a
 152  8022 01 3B 79     		ld	bc,#793B
 153  8025 ED 78        		in	a,(c)
 154  8027 FE E1        		cp	#E1
 155  8029 20 0E        		jr	nz,.done
 156  802B
 157  802B 01 3B 78     		ld	bc,#783B
 158  802E 3E 01        		ld	a,#01
 159  8030 ED 79        		out	(c),a
 160  8032 01 3B 79     		ld	bc,#793B
 161  8035 3E 02        		ld	a,#02
 162  8037 ED 79        		out	(c),a
 163  8039
 164  8039 C1           .done		pop	bc
 165  803A F1           		pop	af
 166  803B C9           		ret
 167  803C
 168  803C              	ENDIF
