2605  0F22             >;    ld b,10
2605  0F22 06 0C       >	ld b,12		;pri 20MHz byla hodnota 10 malo, pri vysunute karte je to 11 sec timeout
2605  0F24             >sd_init_loop
2605  0F24 C5          >    push bc
