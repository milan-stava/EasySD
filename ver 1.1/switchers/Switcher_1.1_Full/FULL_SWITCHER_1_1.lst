1017  84AD                      ; Normal 1.1 path: try the known active partition first.
1018  84AD 3A 4D 87             ld      a,(saved_cf_partition)
1019  84B0 CD 8D 84             call    full_valid_partition_a
1020  84B3 38 08                jr      c,.probe_all
1021  84B5
1022  84B5 3D                   dec     a
1023  84B6 CD E3 84             call    .load_expected_lba
1024  84B9 CD F3 84             call    .scan_driver
