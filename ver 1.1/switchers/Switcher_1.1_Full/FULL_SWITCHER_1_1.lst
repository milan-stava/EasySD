 385  8159              ; ACTIVATE_RECORD
 386  8159              ; API_INDEX = 0..11
 387  8159              ;
 388  8159              ; Checks VDT INFO bit 1.
 389  8159              ; Changes device + partition and puts the selected VDT LBA directly into
 390  8159              ; current_1st_sector. SD also updates SD1_LBA_STORE / SD2_LBA_STORE so the old
 391  8159              ; #8003/#8007 entries continue using the new partition.
 392  8159              ;------------------------------------------------------------------------------
