# file opened: FULL_SWITCHER_1_1.a80
   1  0000                      ORG #8000
   2  8000
   3  8000              ;==============================================================================
   4  8000              ; EasySD / EasyCF Switcher 1.1 Full - ASM backend, TEST 8d / NO DRIVER + NOT INSERTED + FAST EXIT
   5  8000              ; Hood + ChatGPT, 2026-09-17
   6  8000              ;
   7  8000              ; Target:
   8  8000              ;   EasyCF 1.0.1 in page 98
   9  8000              ;   EasySD 1.1   in configurable page stored in BSDOS page 97:#0033
  10  8000              ;
  11  8000              ; Old 1.1 entry points are kept unchanged:
  12  8000              ;   USR #8000 = switch CF
  13  8000              ;   USR #8003 = switch SD1
  14  8000              ;   USR #8007 = switch SD2
  15  8000              ;   USR #800B = active system
  16  8000              ;   USR #800E = availability mask
  17  8000              ;
  18  8000              ; New FULL API:
  19  8000              ;   USR #8011 = GET_RECORD
  20  8000              ;   USR #8014 = WRITE_TEXT
  21  8000              ;   USR #8017 = ACTIVATE_RECORD
  22  8000              ;   USR #801A = GET_ACTIVE_RECORD
  23  8000              ;
  24  8000              ; BASIC/API workspace:
  25  8000              ;   #9000  INDEX       0..11
  26  8000              ;                       0..3  = CF  P1..P4
  27  8000              ;                       4..7  = SD1 P1..P4
  28  8000              ;                       8..11 = SD2 P1..P4
  29  8000              ;   #9001  INFO        output VDT info byte
  30  8000              ;   #9002  LBA[4]      output, little endian
  31  8000              ;   #9006  TEXT[26]    input/output VDT user text
  32  8000              ;   #9020  RESULT      last result code
  33  8000              ;   #9021  ACTIVE      active record 0..11, #FF = unknown
  34  8000              ;   #9022  VDT_ADDR    debug: last resolved VDT base (word)
  35  8000              ;   #9025  DRIVER_MASK bit0 CF, bit1 SD1, bit2 SD2
  36  8000              ;   #9100..#927F CACHE 12 raw VDT records (12 x 32 bytes)
  37  8000              ;
  38  8000              ; RESULT / BC:
  39  8000              ;   0 = OK
  40  8000              ;   1 = EasySD/EasyCF 1.1 installation not available
  41  8000              ;   2 = bad INDEX
  42  8000              ;   3 = VDT not found / invalid
  43  8000              ;   4 = selected partition is not usable (INFO bit 1 = 0)
  44  8000              ;   5 = CF current_1st_sector patch not found
  45  8000              ;
  46  8000              ; VDT record, 32 bytes:
  47  8000              ;   +0      INFO
  48  8000              ;   +1..+4  LBA
  49  8000              ;   +5      reserved
  50  8000              ;   +6..31  user text (26 bytes)
  51  8000              ;
  52  8000              ; NOTE 1.1 SD98 FIX:
  53  8000              ;   Accepts EasySD SD-only resident page 98 on eLeMeNt ZX / MB03+ Slim.
  54  8000              ;   MB03+ dynamic SD pages remain 102..128; pages 99..101 stay rejected.
  55  8000              ;   Complete backend for partition/LBA switching and 26-byte VDT descriptions.
  56  8000              ;   BSDOS catalogue line 1 text is stored directly at #0DC4..#0DDD.
  57  8000              ;   On ACTIVATE_RECORD the selected VDT text is copied there. If all 26 VDT
  58  8000              ;   bytes are zero, the catalogue shows "EMPTY ENTRY" padded with spaces.
  59  8000              ;   WRITE_TEXT also refreshes the catalogue immediately when editing the
  60  8000              ;   currently active record.
  61  8000              ;==============================================================================
  62  8000
