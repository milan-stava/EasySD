1029  84BD                      ; and find which one is currently embedded in current_1st_sector.
1030  84BD 3E 01                ld      a,1
1031  84BF 32 4F 87             ld      (cf_probe_partition),a
1032  84C2
1033  84C2              .probe_loop
1034  84C2 3A 4F 87             ld      a,(cf_probe_partition)
1035  84C5 3D                   dec     a
1036  84C6 CD E3 84             call    .load_expected_lba
1037  84C9 CD F3 84             call    .scan_driver
1038  84CC 30 0D                jr      nc,.probe_found
1039  84CE
1040  84CE 3A 4F 87             ld      a,(cf_probe_partition)
1041  84D1 3C                   inc     a
1042  84D2 32 4F 87             ld      (cf_probe_partition),a
1043  84D5 FE 05                cp      5
1044  84D7 38 E9                jr      c,.probe_loop
1045  84D9 18 56                jr      .fail
