 994  84A4              ;------------------------------------------------------------------------------
 995  84A4              ; Find EasyCF 1.0.1 current_1st_sector self-modifying operands.
 996  84A4              ;
 997  84A4              ; Expected instruction:
 998  84A4              ;       LD HL,<low16>    21 ll hh
 999  84A4              ;       LD DE,<high16>   11 ll hh
1000  84A4              ;       CALL ...         CD ...
1001  84A4              ;
1002  84A4              ; We additionally require the four immediate bytes to equal the LBA belonging
1003  84A4              ; to the OLD saved CF partition, so a false positive in #0090..#0382 is very
1004  84A4              ; unlikely.
1005  84A4              ;
1006  84A4              ; OUT:
1007  84A4              ;   cf_lba_low_patch  = address of low16 operand
1008  84A4              ;   cf_lba_high_patch = address of high16 operand
1009  84A4              ;   carry clear = found
1010  84A4              ;------------------------------------------------------------------------------
1011  84A4
1012  84A4              full_find_cf_lba_patch
1013  84A4 21 00 10             ld      hl,CF_VDT_BASE
1014  84A7 CD FE 83             call    full_validate_vdt4
