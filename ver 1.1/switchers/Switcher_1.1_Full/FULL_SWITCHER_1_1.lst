1459  875A              ;==============================================================================
1460  875A              ; FULL cache helper
1461  875A              ;==============================================================================
1462  875A              ; ENTRY_GET_ACTIVE_RECORD (#801A) keeps its original semantics, but before
1463  875A              ; returning ACTIVE it now refreshes a contiguous 12-record cache for BASIC:
1464  875A              ;   #9100..#917F = CF  P1..P4  (4 x 32 B)
1465  875A              ;   #9180..#927F = SD1 P1..P4 + SD2 P1..P4 (8 x 32 B)
1466  875A              ; This means the BASIC frontend needs only one USR call at startup instead of
1467  875A              ; 12 GET_RECORD calls and never touches live VDT banks directly.
1468  875A
1469  875A              ; api_cache_all moved after renderer to keep #8800 fixed.
1470  875A
1471  875A              ; Keep backend below the alpha10 renderer at #8800.
1472  875A              ; For --raw output, physically fill the gap so #8800 is exactly offset #0800
1473  875A              ; from the CODE load address #8000. Do not use a second ORG here.
1474  875A                      ASSERT $ <= #8800
1475  875A 00 00 00...          defs    #8800-$,0
1476  8800                      ASSERT $ = #8800
