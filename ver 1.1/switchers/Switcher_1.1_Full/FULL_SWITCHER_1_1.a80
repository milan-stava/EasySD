        ORG #8000

;==============================================================================
; EasySD / EasyCF Switcher 1.1 Full - ASM backend, TEST 8d / NO DRIVER + NOT INSERTED + FAST EXIT
; Hood + ChatGPT, 2026-09-17
;
; Target:
;   EasyCF 1.0.1 in page 98
;   EasySD 1.1   in configurable page stored in BSDOS page 97:#0033
;
; Old 1.1 entry points are kept unchanged:
;   USR #8000 = switch CF
;   USR #8003 = switch SD1
;   USR #8007 = switch SD2
;   USR #800B = active system
;   USR #800E = availability mask
;
; New FULL API:
;   USR #8011 = GET_RECORD
;   USR #8014 = WRITE_TEXT
;   USR #8017 = ACTIVATE_RECORD
;   USR #801A = GET_ACTIVE_RECORD
;
; BASIC/API workspace:
;   #9000  INDEX       0..11
;                       0..3  = CF  P1..P4
;                       4..7  = SD1 P1..P4
;                       8..11 = SD2 P1..P4
;   #9001  INFO        output VDT info byte
;   #9002  LBA[4]      output, little endian
;   #9006  TEXT[26]    input/output VDT user text
;   #9020  RESULT      last result code
;   #9021  ACTIVE      active record 0..11, #FF = unknown
;   #9022  VDT_ADDR    debug: last resolved VDT base (word)
;   #9025  DRIVER_MASK bit0 CF, bit1 SD1, bit2 SD2
;   #9100..#927F CACHE 12 raw VDT records (12 x 32 bytes)
;
; RESULT / BC:
;   0 = OK
;   1 = EasySD/EasyCF 1.1 installation not available
;   2 = bad INDEX
;   3 = VDT not found / invalid
;   4 = selected partition is not usable (INFO bit 1 = 0)
;   5 = CF current_1st_sector patch not found
;
; VDT record, 32 bytes:
;   +0      INFO
;   +1..+4  LBA
;   +5      reserved
;   +6..31  user text (26 bytes)
;
; NOTE 1.1 SD98 FIX:
;   Accepts EasySD SD-only resident page 98 on eLeMeNt ZX / MB03+ Slim.
;   MB03+ dynamic SD pages remain 102..128; pages 99..101 stay rejected.
;   Complete backend for partition/LBA switching and 26-byte VDT descriptions.
;   BSDOS catalogue line 1 text is stored directly at #0DC4..#0DDD.
;   On ACTIVATE_RECORD the selected VDT text is copied there. If all 26 VDT
;   bytes are zero, the catalogue shows "EMPTY ENTRY" padded with spaces.
;   WRITE_TEXT also refreshes the catalogue immediately when editing the
;   currently active record.
;==============================================================================

PAGE_BSDOS              equ 97
PAGE_CF                 equ 98
PAGE_SD_ONLY_RAW         equ 98          ; eLeMeNt/Slim: SD1+SD2 v jedine page 98
PAGE_SD_MIN_RAW          equ 102         ; MB03+: fyzicka SD page 6 -> zapisova hodnota 102
PAGE_SD_MAX_RAW          equ 128

DOS_ACTIVE_PAGE         equ #001C
DOS_ACTIVE_DEVICE       equ #0032
DOS_PAGE_SD             equ #0033
DOS_SD1_PARTITION       equ #0034
DOS_SD2_PARTITION       equ #0035
DOS_CF_PARTITION        equ #3C90
DOS_INSTALL_SIGNATURE   equ #3C91

DRIVER_LASTD            equ #00E3

SD_CARD_SELECT          equ #0F12
SD_SLOT_1               equ #FE
SD_SLOT_2               equ #FD

SD1_LBA_STORE           equ #3C90
SD2_LBA_STORE           equ #3C94

CURRENT_LBA_LOW         equ #02AB
CURRENT_LBA_HIGH        equ #02AE

CF_VDT_BASE             equ #1000       ; EasyCF 1.0.1: CF routines at #0F00, VDT aligned to next xx00

CAT_DEVICE              equ #0DC1
CAT_TEXT                equ #0DC4
CAT_TEXT_LEN            equ 26
CAT_PARTITION           equ #0DDF

NORMAL_MAPPING          equ #40

API_INDEX               equ #9000
API_INFO                equ #9001
API_LBA                 equ #9002
API_TEXT                equ #9006
API_RESULT              equ #9020
API_ACTIVE              equ #9021
API_VDT_ADDR            equ #9022
API_DRIVER_MASK         equ #9025       ; bit0 CF, bit1 SD1, bit2 SD2
API_SLOT_MASK           equ #9026       ; bit1 SD1 card/data present, bit2 SD2 card/data present
API_CACHE_BASE          equ #9100

;------------------------------------------------------------------------------
; Compatibility jump table - exact addresses of Switcher 1.1
;------------------------------------------------------------------------------

ENTRY_CF
        xor     a
        jr      switch_start

ENTRY_SD1
        ld      a,1
        jr      switch_start

ENTRY_SD2
        ld      a,2
        jr      switch_start

ENTRY_STATUS
        jp      get_status

ENTRY_AVAILABILITY
        jp      get_availability

;------------------------------------------------------------------------------
; New FULL API jump table
;------------------------------------------------------------------------------

ENTRY_GET_RECORD
        jp      api_get_record

ENTRY_WRITE_TEXT
        jp      api_write_text

ENTRY_ACTIVATE_RECORD
        jp      api_activate_record

ENTRY_GET_ACTIVE_RECORD
        jp      api_cache_all

        ASSERT ENTRY_CF              = #8000
        ASSERT ENTRY_SD1             = #8003
        ASSERT ENTRY_SD2             = #8007
        ASSERT ENTRY_STATUS          = #800B
        ASSERT ENTRY_AVAILABILITY    = #800E
        ASSERT ENTRY_GET_RECORD      = #8011
        ASSERT ENTRY_WRITE_TEXT      = #8014
        ASSERT ENTRY_ACTIVATE_RECORD = #8017
        ASSERT ENTRY_GET_ACTIVE_RECORD = #801A

;==============================================================================
; Original Switcher 1.1 behaviour
;==============================================================================

switch_start
        di
        ld      (selected_device),a
        call    detect_all
        ld      b,a

        ld      a,(selected_device)
        or      a
        jr      z,.check_cf
        cp      2
        jr      z,.check_sd2

        bit     1,b
        jr      nz,.detected
        jp      switch_not_detected

.check_sd2
        bit     2,b
        jr      nz,.detected
        jp      switch_not_detected

.check_cf
        bit     0,b
        jp      z,switch_not_detected

.detected
        ld      a,PAGE_BSDOS
        out     (23),a
        ld      a,#1E                  ; KILLX only after successful detection
        rst     #20

        ld      a,(selected_device)
        or      a
        jr      z,switch_cf
        cp      2
        jr      z,switch_sd2

switch_sd1
        ld      a,1
        ld      (DOS_ACTIVE_DEVICE),a
        ld      a,(DOS_SD1_PARTITION)
        ld      h,'1'
        ld      bc,SD1_LBA_STORE
        ld      e,SD_SLOT_1
        jr      switch_sd_common

switch_sd2
        ld      a,2
        ld      (DOS_ACTIVE_DEVICE),a
        ld      a,(DOS_SD2_PARTITION)
        ld      h,'2'
        ld      bc,SD2_LBA_STORE
        ld      e,SD_SLOT_2

switch_sd_common
        add     a,'0'
        ld      d,a
        ld      a,e
        ld      (selected_slot),a

        ld      e,'P'
        ld      (CAT_PARTITION),de
        ld      l,'S'
        ld      (CAT_DEVICE),hl

        ld      h,b
        ld      l,c

        ld      a,(DOS_PAGE_SD)
        ld      (DOS_ACTIVE_PAGE),a
        out     (23),a

        ld      a,(selected_slot)
        ld      (SD_CARD_SELECT),a
        jr      finish_sd

switch_cf
        ld      a,(DOS_CF_PARTITION)
        add     a,'0'
        ld      h,a
        ld      l,'P'
        ld      (CAT_PARTITION),hl

        ld      hl,#4643                ; memory order "CF"
        ld      (CAT_DEVICE),hl

        xor     a
        ld      (DOS_ACTIVE_DEVICE),a
        ld      a,PAGE_CF
        ld      (DOS_ACTIVE_PAGE),a
        out     (23),a

        xor     a
        ld      (DRIVER_LASTD),a
        jr      finish_ok

finish_sd
        xor     a
        ld      (DRIVER_LASTD),a

        ld      de,CURRENT_LBA_LOW
        ld      bc,2
        ldir
        inc     de                       ; #02AD -> #02AE
        ld      bc,2
        ldir

finish_ok
        ld      a,NORMAL_MAPPING
        out     (23),a
        ld      bc,0
        ei
        ret

switch_not_detected
        ld      a,NORMAL_MAPPING
        out     (23),a
        ld      bc,1
        ei
        ret

get_status
        di
        call    detect_all
        ld      a,(current_device)
        cp      #FF
        call    z,detect_legacy_system
        ld      c,a
        ld      b,0
        ei
        ret

get_availability
        di
        call    detect_all
        ld      c,a
        ld      b,0
        ei
        ret

;==============================================================================
; FULL API
;==============================================================================

;------------------------------------------------------------------------------
; GET_RECORD
; API_INDEX = 0..11
; OUT:
;   API_INFO
;   API_LBA[4]
;   API_TEXT[26]
;   BC = RESULT
;------------------------------------------------------------------------------

api_get_record
        di
        call    full_load_state
        jp      nz,api_error_install

        ld      a,(API_INDEX)
        call    full_get_record_ptr
        jp      c,api_error_from_a

        ld      a,(hl)
        ld      (API_INFO),a

        inc     hl
        ld      de,API_LBA
        ld      bc,4
        ldir

        inc     hl                       ; skip reserved byte +5
        ld      de,API_TEXT
        ld      bc,26
        ldir

        xor     a
        jp      api_finish_a

;------------------------------------------------------------------------------
; WRITE_TEXT
; API_INDEX = 0..11
; API_TEXT[26] = exactly 26 bytes; BASIC may use zero padding.
;------------------------------------------------------------------------------

api_write_text
        di
        call    full_load_state
        jp      nz,api_error_install

        ld      a,(API_INDEX)
        call    full_get_record_ptr
        jp      c,api_error_from_a

        ld      de,6
        add     hl,de
        ex      de,hl                     ; DE = VDT text
        ld      hl,API_TEXT
        ld      bc,26
        ldir

        ; Standalone EasyCF has the legacy BSDOS catalogue layout.
        ; Never write the 1.1 26-byte catalogue fields in CF-only mode.
        ld      a,(standalone_cf_mode)
        or      a
        jr      nz,.write_done

        ; If the edited record is currently active, update the visible BSDOS
        ; catalogue description immediately.
        call    full_active_index_from_saved
        ld      b,a
        ld      a,(selected_index)
        cp      b
        jr      nz,.write_done

        ld      a,PAGE_BSDOS
        out     (23),a
        call    full_catalog_text

.write_done
        xor     a
        jp      api_finish_a

;------------------------------------------------------------------------------
; ACTIVATE_RECORD
; API_INDEX = 0..11
;
; Checks VDT INFO bit 1.
; Changes device + partition and puts the selected VDT LBA directly into
; current_1st_sector. SD also updates SD1_LBA_STORE / SD2_LBA_STORE so the old
; #8003/#8007 entries continue using the new partition.
;------------------------------------------------------------------------------

api_activate_record
        di
        call    full_load_state
        jp      nz,api_error_install

        ld      a,(API_INDEX)
        cp      12
        jp      nc,api_error_bad_index
        ld      (selected_index),a

        ; For CF we must find its self-modifying current_1st_sector while the
        ; old partition/LBA is still known.
        cp      4
        jr      nc,.not_cf

        ld      a,PAGE_CF
        out     (23),a
        ld      de,EASYCF_ID
        ld      a,(standalone_cf_mode)
        or      a
        jr      z,.cf_check_11
        call    check_id
        jr      .cf_checked
.cf_check_11
        call    check_driver
.cf_checked
        jp      nz,api_error_install_mapped

        call    full_find_cf_lba_patch
        jr      c,.cf_patch_error

.not_cf
        ld      a,(selected_index)
        call    full_get_record_ptr
        jp      c,api_error_from_a

        bit     1,(hl)
        jp      z,api_error_unusable

        ; Copy selected LBA and 26-byte description to stable RAM while the
        ; driver page is mapped. After the 4-byte LBA HL points at reserved +5.
        inc     hl
        ld      de,API_LBA
        ld      bc,4
        ldir
        inc     hl                       ; skip reserved byte +5 -> text +6
        ld      de,API_TEXT
        ld      bc,26
        ldir

        ; Keep the same safe switching semantics as the original 1.1 switcher:
        ; KILLX only after the target record has been validated and its LBA saved.
        ld      a,PAGE_BSDOS
        out     (23),a
        ld      a,#1E
        rst     #20

        ld      a,(selected_index)
        cp      4
        jr      c,.activate_cf
        cp      8
        jr      c,.activate_sd1
        jr      .activate_sd2

.cf_patch_error
        ld      a,5
        jp      api_finish_a

.activate_cf
        ; A = global index 0..3 -> partition 1..4
        ld      a,(selected_index)
        inc     a
        ld      (selected_partition),a

        ; In standalone EasyCF mode there is no ES11 state block in BSDOS.
        ; Only patch the CF driver itself; leave legacy BSDOS state/catalogue intact.
        ld      a,(standalone_cf_mode)
        or      a
        jr      nz,.activate_cf_driver

        ld      a,PAGE_BSDOS
        out     (23),a

        ld      a,(selected_partition)
        ld      (DOS_CF_PARTITION),a

        xor     a
        ld      (DOS_ACTIVE_DEVICE),a
        ld      a,PAGE_CF
        ld      (DOS_ACTIVE_PAGE),a

        call    full_catalog_cf
        call    full_catalog_text

.activate_cf_driver
        ld      a,PAGE_CF
        out     (23),a

        xor     a
        ld      (DRIVER_LASTD),a

        ; Write 4B LBA to operands found by full_find_cf_lba_patch.
        ld      hl,API_LBA
        ld      de,(cf_lba_low_patch)
        ld      bc,2
        ldir
        ld      de,(cf_lba_high_patch)
        ld      bc,2
        ldir

        ld      a,(selected_partition)
        ld      (saved_cf_partition),a

        xor     a
        jp      api_finish_a

.activate_sd1
        ld      a,(selected_index)
        sub     3                       ; 4..7 -> P1..P4
        ld      (selected_partition),a
        ld      a,1
        ld      (selected_device),a
        ld      a,SD_SLOT_1
        ld      (selected_slot),a
        ld      hl,SD1_LBA_STORE
        ld      (selected_lba_store),hl
        jr      full_activate_sd

.activate_sd2
        ld      a,(selected_index)
        sub     7                       ; 8..11 -> P1..P4
        ld      (selected_partition),a
        ld      a,2
        ld      (selected_device),a
        ld      a,SD_SLOT_2
        ld      (selected_slot),a
        ld      hl,SD2_LBA_STORE
        ld      (selected_lba_store),hl

full_activate_sd
        ld      a,PAGE_BSDOS
        out     (23),a

        ld      a,(selected_device)
        ld      (DOS_ACTIVE_DEVICE),a

        cp      2
        jr      z,.save_sd2_part
        ld      a,(selected_partition)
        ld      (DOS_SD1_PARTITION),a
        jr      .part_saved
.save_sd2_part
        ld      a,(selected_partition)
        ld      (DOS_SD2_PARTITION),a
.part_saved
        ld      a,(saved_sd_page)
        ld      (DOS_ACTIVE_PAGE),a

        call    full_catalog_sd
        call    full_catalog_text

        ld      a,(saved_sd_page)
        out     (23),a

        ld      a,(selected_slot)
        ld      (SD_CARD_SELECT),a

        xor     a
        ld      (DRIVER_LASTD),a

        ; current_1st_sector, fixed by EasySD 1.1 ASSERTs.
        ld      hl,API_LBA
        ld      de,CURRENT_LBA_LOW
        ld      bc,2
        ldir
        inc     de
        ld      bc,2
        ldir

        ; Keep the old #8003/#8007 switch entries coherent.
        ld      hl,API_LBA
        ld      de,(selected_lba_store)
        ld      bc,4
        ldir

        xor     a
        jp      api_finish_a

;------------------------------------------------------------------------------
; GET_ACTIVE_RECORD
; OUT API_ACTIVE = 0..11 or #FF
;------------------------------------------------------------------------------

api_get_active_record
        di
        call    full_load_state
        jp      nz,api_error_install

        ld      a,#FF
        ld      (API_ACTIVE),a

        ld      a,(current_device)
        or      a
        jr      z,.cf
        cp      1
        jr      z,.sd1
        cp      2
        jr      z,.sd2
        xor     a
        jp      api_finish_a

.cf
        ld      a,(saved_cf_partition)
        call    full_valid_partition_a
        jr      c,.unknown
        dec     a
        jr      .save
.sd1
        ld      a,(saved_sd1_partition)
        call    full_valid_partition_a
        jr      c,.unknown
        add     a,3                       ; P1 -> 4
        jr      .save
.sd2
        ld      a,(saved_sd2_partition)
        call    full_valid_partition_a
        jr      c,.unknown
        add     a,7                       ; P1 -> 8
        jr      .save
.unknown
        ld      a,#FF
.save
        ld      (API_ACTIVE),a
        xor     a
        jp      api_finish_a

;==============================================================================
; FULL helpers
;==============================================================================

;------------------------------------------------------------------------------
; Read/validate EasySD 1.1 resident state from BSDOS page 97.
; OUT Z = OK, NZ = not installed
; Also saves current device/page/partitions.
; Restores normal mapping before return.
;------------------------------------------------------------------------------

full_load_state
        xor     a
        ld      (standalone_cf_mode),a

        ld      a,PAGE_BSDOS
        out     (23),a

        ld      hl,(DOS_INSTALL_SIGNATURE)
        ld      de,#5345                  ; "ES"
        or      a
        sbc     hl,de
        jr      nz,.try_standalone_cf

        ld      hl,(DOS_INSTALL_SIGNATURE+2)
        ld      de,#3131                  ; "11"
        or      a
        sbc     hl,de
        jr      nz,.try_standalone_cf

        ld      a,(#001B)
        cp      #3E
        jr      nz,.try_standalone_cf
        ld      a,(#001D)
        cp      #D3
        jr      nz,.try_standalone_cf
        ld      a,(#001E)
        cp      #17
        jr      nz,.try_standalone_cf
        ld      a,(#001F)
        cp      #C9
        jr      nz,.try_standalone_cf

        ld      a,(DOS_ACTIVE_DEVICE)
        ld      (current_device),a
        ld      a,(DOS_PAGE_SD)
        ld      (saved_sd_page),a
        ld      a,(DOS_SD1_PARTITION)
        ld      (saved_sd1_partition),a
        ld      a,(DOS_SD2_PARTITION)
        ld      (saved_sd2_partition),a
        ld      a,(DOS_CF_PARTITION)
        ld      (saved_cf_partition),a

        ld      a,NORMAL_MAPPING
        out     (23),a
        xor     a
        ret

.try_standalone_cf
        ; Do not inspect or modify BSDOS catalogue/state here.
        ; Only prove that a standalone EasyCF and its VDT are present.
        ld      a,NORMAL_MAPPING
        out     (23),a
        ld      a,PAGE_CF
        out     (23),a
        ld      de,EASYCF_ID
        call    check_id                  ; standalone EasyCF need not have 1.1 bridge
        jr      nz,.bad_mapped
        ld      hl,CF_VDT_BASE
        call    full_validate_vdt4
        jr      c,.bad_mapped

        xor     a
        ld      (current_device),a        ; standalone CF
        ld      (saved_cf_partition),a    ; resolved below if driver LBA matches P1..P4
        ld      (saved_sd_page),a
        ld      (saved_sd1_partition),a
        ld      (saved_sd2_partition),a
        inc     a
        ld      (standalone_cf_mode),a

        ; Recover active CF partition and patch operand addresses directly from
        ; the installed EasyCF driver. Failure is non-fatal for browsing/editing.
        call    full_find_cf_lba_patch

        ld      a,NORMAL_MAPPING
        out     (23),a
        xor     a
        ret

.bad_mapped
        ld      a,NORMAL_MAPPING
        out     (23),a
        ld      a,1
        or      a
        ret

;------------------------------------------------------------------------------
; Resolve API/global record.
; IN  A = 0..11
; OUT HL = record address in currently mapped driver bank
;     CARRY clear = OK
;     CARRY set, A = result code (1,2,3)
;------------------------------------------------------------------------------

full_get_record_ptr
        cp      12
        jr      nc,.bad_index

        ld      (selected_index),a
        cp      4
        jr      c,.cf

        ; SD records: global 4..11 -> local 0..7
        sub     4
        ld      (local_record),a

        ld      a,(saved_sd_page)
        cp      PAGE_SD_ONLY_RAW
        jr      z,.sd_page_ok
        cp      PAGE_SD_MIN_RAW
        jr      c,.install_error
        cp      PAGE_SD_MAX_RAW+1
        jr      nc,.install_error
.sd_page_ok
        out     (23),a
        ld      de,EASYSD_ID
        call    check_driver
        jr      nz,.install_error_mapped

        call    full_find_sd_vdt
        jr      c,.vdt_error_mapped

        ld      (API_VDT_ADDR),hl
        ld      a,(local_record)
        call    full_add_record_offset
        or      a                       ; clear carry
        ret

.cf
        ld      (local_record),a
        ld      a,PAGE_CF
        out     (23),a
        ld      de,EASYCF_ID
        call    check_driver
        jr      nz,.install_error_mapped

        ld      hl,CF_VDT_BASE
        call    full_validate_vdt4
        jr      c,.vdt_error_mapped

        ld      hl,CF_VDT_BASE
        ld      (API_VDT_ADDR),hl
        ld      a,(local_record)
        call    full_add_record_offset
        or      a
        ret

.bad_index
        ld      a,2
        scf
        ret

.install_error_mapped
        ld      a,NORMAL_MAPPING
        out     (23),a
.install_error
        ld      a,1
        scf
        ret

.vdt_error_mapped
        ld      a,NORMAL_MAPPING
        out     (23),a
        ld      a,3
        scf
        ret

;------------------------------------------------------------------------------
; HL = base, A = record number; return HL += A*32.
;------------------------------------------------------------------------------

full_add_record_offset
        ld      e,a
        ld      d,0
        ex      de,hl                    ; HL = index, DE = base
        add     hl,hl
        add     hl,hl
        add     hl,hl
        add     hl,hl
        add     hl,hl                    ; *32
        add     hl,de
        ret

;------------------------------------------------------------------------------
; CF VDT v1.0.1 is fixed at #1000.
; Validate four records structurally:
;   reserved high INFO nibble must be zero
;   reserved byte +5 must be zero
; CARRY = invalid
;------------------------------------------------------------------------------

full_validate_vdt4
        ld      b,4
.loop
        ld      a,(hl)
        and     #F0
        jr      nz,.bad

        push    hl
        ld      de,5
        add     hl,de
        ld      a,(hl)
        pop     hl
        or      a
        jr      nz,.bad

        ld      de,32
        add     hl,de
        djnz    .loop
        or      a
        ret
.bad
        scf
        ret

;------------------------------------------------------------------------------
; Locate EasySD VDT without hardcoding its assembler-dependent address.
;
; EasySD 1.1 keeps the selected SD1/SD2 LBA at #3C90/#3C94 in the driver
; page. We scan aligned xx00 candidates and require their selected record(s)
; to contain the same four bytes. This keeps the switcher independent of the
; exact length of SD_DRIVER.
;
; OUT HL = VDT base, carry clear
;     carry set = not found
;------------------------------------------------------------------------------

full_find_sd_vdt
        ld      hl,#1000

.next_candidate
        push    hl
        call    full_validate_vdt8
        pop     hl
        jr      c,.next

        ld      a,(saved_sd1_partition)
        call    full_valid_partition_a
        jr      c,.skip_sd1

        push    hl
        dec     a
        call    full_add_record_offset
        inc     hl
        ld      de,SD1_LBA_STORE
        call    full_compare4
        pop     hl
        jr      nz,.next

.skip_sd1
        ld      a,(saved_sd2_partition)
        call    full_valid_partition_a
        jr      c,.skip_sd2

        push    hl
        dec     a
        add     a,4
        call    full_add_record_offset
        inc     hl
        ld      de,SD2_LBA_STORE
        call    full_compare4
        pop     hl
        jr      nz,.next

.skip_sd2
        ; At least one selected partition must be valid, otherwise an all-zero
        ; aligned page could look like a VDT.
        ld      a,(saved_sd1_partition)
        call    full_valid_partition_a
        jr      nc,.found
        ld      a,(saved_sd2_partition)
        call    full_valid_partition_a
        jr      nc,.found
        jr      .fail

.next
        ld      a,h
        inc     a
        ld      h,a
        ld      l,0
        cp      #30                     ; scan #1000..#2F00
        jr      c,.next_candidate

.fail
        scf
        ret

.found
        or      a
        ret

;------------------------------------------------------------------------------
; Structural validation of 8 SD records.
;------------------------------------------------------------------------------

full_validate_vdt8
        ld      b,8
.loop
        ld      a,(hl)
        and     #F0
        jr      nz,.bad

        push    hl
        ld      de,5
        add     hl,de
        ld      a,(hl)
        pop     hl
        or      a
        jr      nz,.bad

        ld      de,32
        add     hl,de
        djnz    .loop
        or      a
        ret
.bad
        scf
        ret

;------------------------------------------------------------------------------
; A partition number. Carry clear = 1..4, carry set = invalid.
; A is preserved.
;------------------------------------------------------------------------------

full_valid_partition_a
        cp      1
        jr      c,.bad
        cp      5
        jr      nc,.bad
        or      a
        ret
.bad
        scf
        ret

;------------------------------------------------------------------------------
; Compare 4 bytes: HL vs DE. Z = equal.
; Preserves HL/DE after comparison only conceptually not required by callers.
;------------------------------------------------------------------------------

full_compare4
        ld      b,4
.loop
        ld      a,(de)
        cp      (hl)
        ret     nz
        inc     hl
        inc     de
        djnz    .loop
        xor     a
        ret

;------------------------------------------------------------------------------
; Find EasyCF 1.0.1 current_1st_sector self-modifying operands.
;
; Expected instruction:
;       LD HL,<low16>    21 ll hh
;       LD DE,<high16>   11 ll hh
;       CALL ...         CD ...
;
; We additionally require the four immediate bytes to equal the LBA belonging
; to the OLD saved CF partition, so a false positive in #0090..#0382 is very
; unlikely.
;
; OUT:
;   cf_lba_low_patch  = address of low16 operand
;   cf_lba_high_patch = address of high16 operand
;   carry clear = found
;------------------------------------------------------------------------------

full_find_cf_lba_patch
        ld      hl,CF_VDT_BASE
        call    full_validate_vdt4
        jp      c,.fail

        ; Normal 1.1 path: try the known active partition first.
        ld      a,(saved_cf_partition)
        call    full_valid_partition_a
        jr      c,.probe_all

        dec     a
        call    .load_expected_lba
        call    .scan_driver
        ret     nc

.probe_all
        ; Standalone EasyCF has no ES11 partition byte. Try all four VDT LBAs
        ; and find which one is currently embedded in current_1st_sector.
        ld      a,1
        ld      (cf_probe_partition),a

.probe_loop
        ld      a,(cf_probe_partition)
        dec     a
        call    .load_expected_lba
        call    .scan_driver
        jr      nc,.probe_found

        ld      a,(cf_probe_partition)
        inc     a
        ld      (cf_probe_partition),a
        cp      5
        jr      c,.probe_loop
        jr      .fail

.probe_found
        ld      a,(cf_probe_partition)
        ld      (saved_cf_partition),a
        or      a
        ret

.load_expected_lba
        ; IN A = VDT record index 0..3
        ld      hl,CF_VDT_BASE
        call    full_add_record_offset
        inc     hl
        ld      de,cf_expected_lba
        ld      bc,4
        ldir
        ret

.scan_driver
        ld      hl,#0090

.scan
        ld      a,(hl)
        cp      #21
        jr      nz,.next

        push    hl
        inc     hl
        ld      de,cf_expected_lba
        ld      b,2
        call    full_compare_n
        jr      nz,.candidate_bad

        ld      a,(hl)
        cp      #11
        jr      nz,.candidate_bad
        inc     hl

        ld      de,cf_expected_lba+2
        ld      b,2
        call    full_compare_n
        jr      nz,.candidate_bad

        ld      a,(hl)
        cp      #CD
        jr      nz,.candidate_bad

        pop     hl
        inc     hl
        ld      (cf_lba_low_patch),hl
        ld      de,3
        add     hl,de
        ld      (cf_lba_high_patch),hl
        or      a
        ret

.candidate_bad
        pop     hl

.next
        inc     hl
        ld      a,h
        cp      #04
        jr      c,.scan

.fail
        scf
        ret

; B-byte compare, HL and DE advanced. Z if equal.
full_compare_n
.loop
        ld      a,(de)
        cp      (hl)
        ret     nz
        inc     hl
        inc     de
        djnz    .loop
        xor     a
        ret

;------------------------------------------------------------------------------
; Catalogue fields in BSDOS page 97.
;   #0DC1..#0DC2 device (CF / S1 / S2)
;   #0DC3         SPACE control byte already present in BSDOS
;   #0DC4..#0DDD  26-character description
;   #0DDF..       partition field used by Switcher 1.1
;------------------------------------------------------------------------------

; BSDOS page 97 must be mapped. API_TEXT contains exactly 26 bytes.
; If all bytes are zero, show EMPTY ENTRY. Otherwise copy all 26 bytes and
; translate zero padding to spaces for clean fixed-width catalogue output.
full_catalog_text
        ld      hl,API_TEXT
        ld      b,CAT_TEXT_LEN
.check_nonzero
        ld      a,(hl)
        or      a
        jr      nz,.normal_text
        inc     hl
        djnz    .check_nonzero

        ld      hl,EMPTY_ENTRY_TEXT
        ld      de,CAT_TEXT
        ld      bc,CAT_TEXT_LEN
        ldir
        ret

.normal_text
        ld      hl,API_TEXT
        ld      de,CAT_TEXT
        ld      b,CAT_TEXT_LEN
.copy_loop
        ld      a,(hl)
        or      a
        jr      nz,.store
        ld      a,' '
.store
        ld      (de),a
        inc     hl
        inc     de
        djnz    .copy_loop
        ret

; Compute the current global record index from state saved by full_load_state.
; OUT A = 0..11 or #FF. Does not change memory mapping.
full_active_index_from_saved
        ld      a,(current_device)
        or      a
        jr      z,.cf
        cp      1
        jr      z,.sd1
        cp      2
        jr      z,.sd2
        ld      a,#FF
        ret
.cf
        ld      a,(saved_cf_partition)
        call    full_valid_partition_a
        jr      c,.unknown
        dec     a
        ret
.sd1
        ld      a,(saved_sd1_partition)
        call    full_valid_partition_a
        jr      c,.unknown
        add     a,3                       ; P1..P4 -> 4..7
        ret
.sd2
        ld      a,(saved_sd2_partition)
        call    full_valid_partition_a
        jr      c,.unknown
        add     a,7                       ; P1..P4 -> 8..11
        ret
.unknown
        ld      a,#FF
        ret

full_catalog_cf
        ld      a,(selected_partition)
        add     a,'0'
        ld      h,a
        ld      l,'P'
        ld      (CAT_PARTITION),hl
        ld      hl,#4643                  ; "CF" in memory order
        ld      (CAT_DEVICE),hl
        ret

full_catalog_sd
        ld      a,(selected_partition)
        add     a,'0'
        ld      d,a
        ld      e,'P'
        ld      (CAT_PARTITION),de

        ld      a,(selected_device)
        add     a,'0'
        ld      h,a
        ld      l,'S'
        ld      (CAT_DEVICE),hl
        ret

;------------------------------------------------------------------------------
; API error/finish
;------------------------------------------------------------------------------

api_error_install_mapped
        ld      a,NORMAL_MAPPING
        out     (23),a
api_error_install
        ld      a,1
        jp      api_finish_a

api_error_bad_index
        ld      a,2
        jp      api_finish_a

api_error_unusable
        ld      a,4
        jp      api_finish_a

api_error_from_a
        ; A already carries the result code from full_get_record_ptr.
        jp      api_finish_a

api_finish_a
        ld      (API_RESULT),a
        ld      c,a
        ld      b,0
        ld      a,NORMAL_MAPPING
        out     (23),a
        ei
        ret

;==============================================================================
; Original Switcher 1.1 detection
;==============================================================================

; OUT A = mask: bit0 CF, bit1 SD1, bit2 SD2.
; Always restores #40 mapping.
detect_all
        xor     a
        ld      (availability_mask),a
        dec     a
        ld      (current_device),a

        ld      a,PAGE_BSDOS
        out     (23),a

        ld      hl,(DOS_INSTALL_SIGNATURE)
        ld      de,#5345
        or      a
        sbc     hl,de
        jp      nz,.restore

        ld      hl,(DOS_INSTALL_SIGNATURE+2)
        ld      de,#3131
        or      a
        sbc     hl,de
        jp      nz,.restore

        ld      a,(#001B)
        cp      #3E
        jp      nz,.restore
        ld      a,(#001D)
        cp      #D3
        jp      nz,.restore
        ld      a,(#001E)
        cp      #17
        jp      nz,.restore
        ld      a,(#001F)
        cp      #C9
        jp      nz,.restore

        ld      a,(DOS_ACTIVE_DEVICE)
        cp      3
        jr      nc,.active_saved
        ld      (current_device),a
.active_saved
        ld      a,(DOS_PAGE_SD)
        ld      (saved_sd_page),a
        ld      a,(DOS_SD1_PARTITION)
        ld      (saved_sd1_partition),a
        ld      a,(DOS_SD2_PARTITION)
        ld      (saved_sd2_partition),a
        ld      a,(DOS_CF_PARTITION)
        ld      (saved_cf_partition),a

        ; CF: valid selected partition + EasyCF10 + 1.1 banking bridge.
        cp      1
        jr      c,.check_sd
        cp      5
        jr      nc,.check_sd

        ld      a,PAGE_CF
        out     (23),a
        ld      de,EASYCF_ID
        call    check_driver
        jr      nz,.check_sd

        ld      a,1
        ld      (availability_mask),a

.check_sd
        ld      a,(saved_sd_page)
        cp      PAGE_SD_ONLY_RAW
        jr      z,.sd_page_ok
        cp      PAGE_SD_MIN_RAW
        jr      c,.restore
        cp      PAGE_SD_MAX_RAW+1
        jr      nc,.restore
.sd_page_ok
        out     (23),a
        ld      de,EASYSD_ID
        call    check_driver
        jr      nz,.restore

        ld      a,(saved_sd1_partition)
        cp      1
        jr      c,.check_sd2
        cp      5
        jr      nc,.check_sd2
        ld      a,(availability_mask)
        or      2
        ld      (availability_mask),a

.check_sd2
        ld      a,(saved_sd2_partition)
        cp      1
        jr      c,.restore
        cp      5
        jr      nc,.restore
        ld      a,(availability_mask)
        or      4
        ld      (availability_mask),a

.restore
        ld      a,NORMAL_MAPPING
        out     (23),a
        ld      a,(availability_mask)
        ret

; If 1.1 is not installed, identify a legacy standalone driver in page 98.
; OUT A=3 EasyHDD, 4 EasySD 1.0, 5 EasyCF, #FF unknown.
detect_legacy_system
        ld      a,PAGE_CF
        out     (23),a

        ld      de,EASYCF_ID
        call    check_id
        ld      a,5
        jr      z,.save

        ld      de,EASYSD_ID
        call    check_id
        ld      a,4
        jr      z,.save

        ld      de,EASYHDD_207_ID
        call    check_id
        ld      a,3
        jr      z,.save

        ld      de,EASYHDD_OLD_ID
        call    check_id
        ld      a,3
        jr      z,.save

        ld      a,#FF

.save
        ld      (current_device),a
        ld      a,NORMAL_MAPPING
        out     (23),a
        ld      a,(current_device)
        ret

; DE = expected 8-byte identifier. Z = compatible driver.
check_driver
        call    check_id
        ret     nz

        ld      hl,#001B
        ld      de,DRIVER_BRIDGE_SIGNATURE
        ld      b,6

compare_bytes
        ld      a,(de)
        cp      (hl)
        ret     nz
        inc     de
        inc     hl
        djnz    compare_bytes
        ret

; DE = expected 8-byte identifier at offset #0008.
check_id
        ld      hl,#0008
        ld      b,8
        jr      compare_bytes

;==============================================================================
; Data
;==============================================================================

EASYCF_ID               db "EasyCF10"
EASYSD_ID               db "EasySD10"
EASYHDD_207_ID          db "HddEH207"
EASYHDD_OLD_ID          db "HddDrive"
DRIVER_BRIDGE_SIGNATURE db #3E,#61,#D3,#17,#18,#6F
EMPTY_ENTRY_TEXT        db "EMPTY ENTRY               "   ; exactly 26 bytes

selected_device         db 0
selected_slot           db 0
selected_index          db 0
selected_partition      db 0
local_record            db 0

availability_mask       db 0
cache_driver_mask       db 0
current_device          db #FF
saved_sd_page           db 0
saved_sd1_partition     db 0
saved_sd2_partition     db 0
saved_cf_partition      db 0
standalone_cf_mode      db 0
cf_probe_partition      db 0

selected_lba_store      dw 0
cf_lba_low_patch        dw 0
cf_lba_high_patch       dw 0
cf_expected_lba         db 0,0,0,0


;==============================================================================
; FULL cache helper
;==============================================================================
; ENTRY_GET_ACTIVE_RECORD (#801A) keeps its original semantics, but before
; returning ACTIVE it now refreshes a contiguous 12-record cache for BASIC:
;   #9100..#917F = CF  P1..P4  (4 x 32 B)
;   #9180..#927F = SD1 P1..P4 + SD2 P1..P4 (8 x 32 B)
; This means the BASIC frontend needs only one USR call at startup instead of
; 12 GET_RECORD calls and never touches live VDT banks directly.

; api_cache_all moved after renderer to keep #8800 fixed.

; Keep backend below the alpha10 renderer at #8800.
; For --raw output, physically fill the gap so #8800 is exactly offset #0800
; from the CODE load address #8000. Do not use a second ORG here.
        ASSERT $ <= #8800
        defs    #8800-$,0
        ASSERT $ = #8800

;==============================================================================
; Fast display helper for Switcher 1.1 Full / alpha10 GUI
; #8800 draw all 12 cached rows
; #8803 draw one cached row, API_INDEX=#9000
; #8806 copy API_TEXT -> selected cache record
; #8809 print active VDT name (fast X-exit helper)
;==============================================================================

UI_SELECTED     equ #9024
UI_DRIVER_MASK  equ #9025
UI_SLOT_MASK    equ #9026

        jp ui_draw_all
        jp ui_draw_one
        jp ui_sync_text
        jp ui_print_active_name

ui_draw_all
        xor a
.loop
        push af
        ld (API_INDEX),a
        call ui_draw_one
        pop af
        inc a
        cp 12
        jr c,.loop
        ret

ui_draw_one
        ld a,(API_INDEX)
        cp 12
        ret nc
        ld c,a

        add a,2
        ld d,a
        ld a,22
        call ui_putc
        ld a,d
        call ui_putc
        xor a
        call ui_putc

        ld a,17
        call ui_putc
        ld a,(UI_SELECTED)
        cp c
        ld a,0
        jr nz,.paper_ready
        ld a,1                         ; selected row: BLUE paper
.paper_ready
        call ui_putc

        ld a,19
        call ui_putc
        ld a,1
        call ui_putc

        ld a,16
        call ui_putc
        ld a,6
        call ui_putc
        ld a,(API_ACTIVE)
        cp c
        ld a,' '
        jr nz,.marker_ready
        ld a,'*'
.marker_ready
        call ui_putc

        ld a,c
        call ui_get_record_ptr

        ; Row state in E:
        ;   0 = resident driver + slot/card present (normal VDT row)
        ;   1 = resident driver missing -> NO DRIVER
        ;   2 = EasySD driver exists, but this SD slot has no card/data block
        ;       -> not inserted
        ; C = 0..3 CF, 4..7 SD1, 8..11 SD2.
        ld a,c
        cp 4
        jr c,.drv_cf
        cp 8
        jr c,.drv_sd1
        ld d,4                         ; SD2 driver bit
        jr .drv_test
.drv_sd1
        ld d,2                         ; SD1 driver bit
        jr .drv_test
.drv_cf
        ld d,1                         ; CF driver bit
.drv_test
        ld a,(UI_DRIVER_MASK)
        and d
        ld e,1                         ; assume NO DRIVER
        jr z,.row_state_ready

        xor a
        ld e,a                         ; driver exists -> normal by default

        ; CF has no removable SD slot state here. For SD1/SD2 additionally
        ; require the corresponding 4-record VDT block to be present.
        ld a,c
        cp 4
        jr c,.row_state_ready
        cp 8
        ld a,2                         ; SD1 slot bit
        jr c,.slot_test
        ld a,4                         ; SD2 slot bit
.slot_test
        ld d,a
        ld a,(UI_SLOT_MASK)
        and d
        jr nz,.row_state_ready
        ld e,2                         ; driver exists, card/slot absent

.row_state_ready
        ; NO DRIVER, not inserted and unusable partition are red.
        ; Present + usable remains cyan.
        ld a,e
        or a
        jr nz,.ink_red
        bit 1,(hl)
        jr z,.ink_red
        ld a,5
        jr .ink_ready
.ink_red
        ld a,2
.ink_ready
        ld d,a
        ld a,16
        call ui_putc
        ld a,d
        call ui_putc

        ld a,c
        cp 4
        jr c,.label_cf
        cp 8
        jr c,.label_s1

        ld a,'S'
        call ui_putc
        ld a,'2'
        call ui_putc
        ld a,'P'
        call ui_putc
        ld a,c
        sub 8
        add a,'1'
        call ui_putc
        ld a,' '
        call ui_putc
        jr .label_done

.label_s1
        ld a,'S'
        call ui_putc
        ld a,'1'
        call ui_putc
        ld a,'P'
        call ui_putc
        ld a,c
        sub 4
        add a,'1'
        call ui_putc
        ld a,' '
        call ui_putc
        jr .label_done

.label_cf
        ld a,'C'
        call ui_putc
        ld a,'F'
        call ui_putc
        ld a,'P'
        call ui_putc
        ld a,c
        add a,'1'
        call ui_putc
        ld a,' '
        call ui_putc

.label_done
        ; Missing resident driver and missing SD card are distinct from an
        ; empty VDT description.
        ld a,e
        or a
        jr z,.driver_text
        cp 2
        jr z,.no_card_text
        ld hl,ui_no_driver_text
        ld b,26
        jr .print_fixed
.no_card_text
        ld hl,ui_not_inserted_text
        ld b,26
        jr .print_fixed

.driver_text
        ld de,6
        add hl,de
        push hl
        ld b,26
.scan_nonzero
        ; Standalone EasyCF 1.0.1 may leave old/undefined bytes in the
        ; 26-byte Full text area. Only printable ASCII 32..126 counts as text.
        ld a,(hl)
        cp 32
        jr c,.scan_next
        cp 127
        jr c,.normal_text
.scan_next
        inc hl
        djnz .scan_nonzero

        pop hl
        ld hl,ui_empty_text
        ld b,26
.print_fixed
        ld a,(hl)
        call ui_putc
        inc hl
        djnz .print_fixed
        jr .row_done

.normal_text
        pop hl
        ld b,26
.print_normal
        ld a,(hl)
        cp 32
        jr c,.char_space
        cp 127
        jr c,.char_ready
.char_space
        ld a,' '
.char_ready
        call ui_putc
        inc hl
        djnz .print_normal

.row_done
        ld a,17
        call ui_putc
        xor a
        call ui_putc
        ld a,19
        call ui_putc
        xor a
        call ui_putc
        ld a,16
        call ui_putc
        ld a,7
        call ui_putc
        ret

ui_sync_text
        ld a,(API_INDEX)
        cp 12
        ret nc
        call ui_get_record_ptr
        ld de,6
        add hl,de
        ex de,hl
        ld hl,API_TEXT
        ld bc,26
        ldir
        ret

;------------------------------------------------------------------------------
; #8809 - fast X-exit helper.
; Prints ONLY the active record's VDT name directly from cache.
; BASIC still prints "CF/S1/S2 Pn " and " now active".
; This avoids the slow 26x PEEK loop in BASIC routine 5600.
;------------------------------------------------------------------------------
ui_print_active_name
        ld a,(API_ACTIVE)
        cp 12
        ret nc
        call ui_get_record_ptr
        ld de,6
        add hl,de
        push hl                         ; remember text start

        ; Find last printable non-space character.
        ; B becomes the exact number of characters to print (1..26).
        ld de,25
        add hl,de
        ld b,26
.find_last
        ld a,(hl)
        cp 33                           ; zero/control/space -> keep looking
        jr c,.previous
        cp 127
        jr c,.have_name
.previous
        dec hl
        djnz .find_last

        ; No printable non-space text -> print "EMPTY ENTRY" without padding.
        pop hl
        ld hl,ui_empty_text
        ld b,11
        jr .print_chars

.have_name
        pop hl                          ; restore text start
.print_chars
        ld a,(hl)
        cp 32
        jr c,.as_space
        cp 127
        jr c,.char_ready
.as_space
        ld a,' '
.char_ready
        call ui_putc
        inc hl
        djnz .print_chars
        ret

ui_get_record_ptr
        ld l,a
        ld h,0
        add hl,hl
        add hl,hl
        add hl,hl
        add hl,hl
        add hl,hl
        ld de,API_CACHE_BASE
        add hl,de
        ret

ui_putc
        push bc
        push de
        push hl
        rst #10
        pop hl
        pop de
        pop bc
        ret

ui_empty_text
        db "EMPTY ENTRY               "
ui_no_driver_text
        db "NO DRIVER                 "
ui_not_inserted_text
        db "not inserted              "

;==============================================================================
; Cache helper moved here so alpha10 renderer can stay fixed at #8800.
; ENTRY_GET_ACTIVE_RECORD (#801A) reaches this routine through absolute JP.
;==============================================================================

api_cache_all
        di

        ; Start with a fully empty cache and no detected drivers. This lets
        ; Full display NO DRIVER instead of aborting when only part (or none)
        ; of the resident system is available.
        xor     a
        ld      (cache_driver_mask),a
        ld      (API_DRIVER_MASK),a
        ld      (API_SLOT_MASK),a
        ld      (saved_sd_page),a
        ld      (saved_sd1_partition),a
        ld      (saved_sd2_partition),a
        ld      (saved_cf_partition),a
        ld      (standalone_cf_mode),a
        dec     a
        ld      (current_device),a
        ld      (API_ACTIVE),a

        ld      hl,API_CACHE_BASE
        ld      de,API_CACHE_BASE+1
        ld      bc,12*32-1
        xor     a
        ld      (hl),a
        ldir

        ; Load ES11 state when present. Failure is deliberately non-fatal:
        ; we still probe standalone EasyCF and render missing systems as
        ; NO DRIVER.
        call    full_load_state

        ; --- CF driver -------------------------------------------------------
        ; EasyCF 1.0/1.0.1 is a valid CF system even without the ES11 bridge,
        ; so identify it by EasyCF10 and validate its VDT independently.
        ld      a,PAGE_CF
        out     (23),a
        ld      de,EASYCF_ID
        call    check_id
        jr      nz,.cf_done

        ; The identifier is enough to say that the CF driver exists. A broken
        ; or empty VDT is NOT "NO DRIVER"; it is rendered as unusable/empty.
        ld      a,(cache_driver_mask)
        or      1
        ld      (cache_driver_mask),a

        ld      hl,CF_VDT_BASE
        call    full_validate_vdt4
        jr      c,.cf_present_no_vdt

        ld      hl,CF_VDT_BASE
        ld      de,API_CACHE_BASE
        ld      bc,4*32
        ldir

.cf_present_no_vdt

        ; If this is standalone CF, full_load_state may already have recovered
        ; the active partition and patch operands. If it did not, try once
        ; more while the CF page is mapped; failure is non-fatal for display.
        ld      a,(standalone_cf_mode)
        or      a
        call    nz,full_find_cf_lba_patch

.cf_done
        ; --- SD driver -------------------------------------------------------
        ; SD1 and SD2 share one EasySD 1.1 driver. A valid saved page exists
        ; only when ES11 state was successfully read. If that driver exists,
        ; both SD1 and SD2 systems are considered present; per-card absence is
        ; represented by their VDT contents (for example "not inserted").
        ld      a,(saved_sd_page)
        cp      PAGE_SD_ONLY_RAW
        jr      z,.sd_page_ok
        cp      PAGE_SD_MIN_RAW
        jr      c,.sd_done
        cp      PAGE_SD_MAX_RAW+1
        jr      nc,.sd_done
.sd_page_ok
        out     (23),a
        ld      de,EASYSD_ID
        call    check_driver
        jr      nz,.sd_done

        ; One resident EasySD 1.1 driver serves both SD1 and SD2. Once the
        ; driver itself is detected, neither block is "NO DRIVER" even if a
        ; card/VDT entry is absent or unusable.
        ld      a,(cache_driver_mask)
        or      6                       ; bit1 SD1 + bit2 SD2
        ld      (cache_driver_mask),a

        call    full_find_sd_vdt
        jr      c,.sd_done

        ld      de,API_CACHE_BASE+4*32
        ld      bc,8*32
        ldir

        ; Determine SD1/SD2 card presence independently from driver presence.
        ; A completely zero 4x32-byte VDT block is the representation left for
        ; an absent slot. Any non-zero byte means the slot/card produced VDT
        ; information, even when none of its partitions is BSDOS-usable.
        xor     a
        ld      (API_SLOT_MASK),a

        ld      hl,API_CACHE_BASE+4*32
        ld      bc,4*32
        call    cache_block_nonzero
        jr      z,.slot1_done
        ld      a,(API_SLOT_MASK)
        or      2
        ld      (API_SLOT_MASK),a
.slot1_done

        ld      hl,API_CACHE_BASE+8*32
        ld      bc,4*32
        call    cache_block_nonzero
        jr      z,.slot2_done
        ld      a,(API_SLOT_MASK)
        or      4
        ld      (API_SLOT_MASK),a
.slot2_done

.sd_done
        ld      a,(cache_driver_mask)
        ld      (API_DRIVER_MASK),a

        ; Derive active record only from state which is actually available.
        ld      a,#FF
        ld      (API_ACTIVE),a

        ld      a,(standalone_cf_mode)
        or      a
        jr      z,.active_es11

        ld      a,(cache_driver_mask)
        and     1
        jr      z,.finish
        ld      a,(saved_cf_partition)
        call    full_valid_partition_a
        jr      c,.finish
        dec     a
        ld      (API_ACTIVE),a
        jr      .finish

.active_es11
        ; If ES11 state was read, translate its saved device/partition locally.
        ld      a,(current_device)
        or      a
        jr      z,.active_cf
        cp      1
        jr      z,.active_sd1
        cp      2
        jr      z,.active_sd2
        jr      .finish

.active_cf
        ld      a,(cache_driver_mask)
        and     1
        jr      z,.finish
        ld      a,(saved_cf_partition)
        call    full_valid_partition_a
        jr      c,.finish
        dec     a
        ld      (API_ACTIVE),a
        jr      .finish

.active_sd1
        ld      a,(cache_driver_mask)
        and     2
        jr      z,.finish
        ld      a,(saved_sd1_partition)
        call    full_valid_partition_a
        jr      c,.finish
        add     a,3                     ; P1 -> global 4
        ld      (API_ACTIVE),a
        jr      .finish

.active_sd2
        ld      a,(cache_driver_mask)
        and     4
        jr      z,.finish
        ld      a,(saved_sd2_partition)
        call    full_valid_partition_a
        jr      c,.finish
        add     a,7                     ; P1 -> global 8
        ld      (API_ACTIVE),a

.finish
        ld      a,NORMAL_MAPPING
        out     (23),a
        xor     a
        jp      api_finish_a

;------------------------------------------------------------------------------
; Test whether BC-byte cache block at HL contains at least one non-zero byte.
; OUT: Z = block all zero, NZ = at least one non-zero byte.
; HL/BC destroyed.
;------------------------------------------------------------------------------
cache_block_nonzero
.loop
        ld      a,(hl)
        or      a
        ret     nz
        inc     hl
        dec     bc
        ld      a,b
        or      c
        jr      nz,.loop
        xor     a
        ret

        ASSERT $ < #9000
        END
