2605  0F22             >SD_INIT
2605  0F22             >;    ld b,10
2605  0F22 06 0C       >	ld b,12		;pri 20MHz byla hodnota 10 malo, pri vysunute karte je to 11 sec timeout
2605  0F24             >sd_init_loop
2605  0F24 C5          >    push bc
2605  0F25 CD 4A 0F    >    call SD_POWER_ON
2605  0F28 CD 57 0F    >    call SD_RESET
2605  0F2B FE 01       >    cp 1
2605  0F2D 20 12       >    jr nz,sd_init_fail
2605  0F2F             >    ; resp = 1
2605  0F2F CD 7D 0F    >    call SD_SEND_IF_COND
2605  0F32             >    ; 0 = OK
2605  0F32 B7          >    or a
2605  0F33 20 0C       >    jr nz,sd_init_fail
2605  0F35             >    ; read OCR
2605  0F35 CD F9 0F    >    call SD_OCR
2605  0F38 B7          >    or a
2605  0F39 20 06       >    jr nz,sd_init_fail
2605  0F3B CD 4A 0F    >    call SD_POWER_ON
2605  0F3E C1          >    pop bc
2605  0F3F AF          >    xor a                       ; no error
2605  0F40 C9          >    ret
2605  0F41             >sd_init_fail
2605  0F41 CD 4A 0F    >    call SD_POWER_ON
2605  0F44 C1          >    pop bc
2605  0F45 10 DD       >    djnz sd_init_loop
2605  0F47 3E FF       >    ld a,0xff                   ; cannot initialise
2605  0F49 C9          >    ret
2605  0F4A             >
2605  0F4A             >SD_POWER_ON
2605  0F4A             >; Set DI and CS high and apply 74 or more clock pulses to SCLK.
2605  0F4A             >; The card will enter its native operating mode and go ready to accept native command.
2605  0F4A 3E FF       >    ld a,0xff
2605  0F4C D3 E7       >    out (OUT_PORT),a
2605  0F4E             >    ; send 80 clocks = 10x8 bits
2605  0F4E 06 0A       >    ld b,10
2605  0F50 3E FF       >    ld a,0xff
2605  0F52             >1
2605  0F52 D3 EB       >    out (SPI_PORT),a
2605  0F54 10 FC       >    djnz 1B
2605  0F56 C9          >    ret
2605  0F57             >
2605  0F57             >SD_RESET
2605  0F57             >    ; activate CS for selected card
2605  0F57 3A 12 0F    >    ld a,(card_select)
2605  0F5A D3 E7       >    out (OUT_PORT),a
2605  0F5C             >    ; dummy clock
2605  0F5C 3E FF       >    ld a,0xff
2605  0F5E D3 EB       >    out (SPI_PORT),a
2605  0F60             >    ; send CMD0, arg=0, CRC=95h
2605  0F60 3E 40       >    ld a,CMD_0
2605  0F62 D3 EB       >    out (SPI_PORT),a
2605  0F64 AF          >    xor a
2605  0F65 D3 EB       >    out (SPI_PORT),a
2605  0F67 D3 EB       >    out (SPI_PORT),a
2605  0F69 D3 EB       >    out (SPI_PORT),a
2605  0F6B D3 EB       >    out (SPI_PORT),a
2605  0F6D 3E 95       >    ld a,0x95
2605  0F6F D3 EB       >    out (SPI_PORT),a
2605  0F71             >
2605  0F71 CD A7 10    >    call WAIT
2605  0F74 FE 01       >    cp 1
2605  0F76 C8          >    ret z
2605  0F77             >
2605  0F77             >SD_ERROR
