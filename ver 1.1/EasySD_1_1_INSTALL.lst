2605  0FB7 3E FF       >    ld a,0xff
2605  0FB9 D3 EB       >    out (SPI_PORT),a
2605  0FBB 3E 77       >    ld a,CMD_55
2605  0FBD D3 EB       >    out (SPI_PORT),a
2605  0FBF AF          >    xor a
