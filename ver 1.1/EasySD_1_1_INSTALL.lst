2605  0F95 D3 EB       >    out (SPI_PORT),a
2605  0F97             >
2605  0F97 CD A7 10    >    call WAIT
2605  0F9A FE 01       >    cp 1
2605  0F9C 20 D9       >    jr nz,SD_ERROR
