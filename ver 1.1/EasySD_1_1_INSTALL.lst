2605  0F7D             >SD_SEND_IF_COND
2605  0F7D 3E FF       >    ld a,0xff
2605  0F7F D3 EB       >    out (SPI_PORT),a
2605  0F81 3E 48       >    ld a,CMD_8
2605  0F83 D3 EB       >    out (SPI_PORT),a
2605  0F85 AF          >    xor a
2605  0F86 D3 EB       >    out (SPI_PORT),a
2605  0F88 AF          >    xor a                       ; more time for DIVMMC
2605  0F89 D3 EB       >    out (SPI_PORT),a
2605  0F8B 3E 01       >    ld a,1
2605  0F8D D3 EB       >    out (SPI_PORT),a
2605  0F8F 3E AA       >    ld a,0xaa
2605  0F91 D3 EB       >    out (SPI_PORT),a
