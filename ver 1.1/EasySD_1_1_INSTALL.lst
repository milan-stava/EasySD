1023+ 972B ~            RootCluster = BPB_RootClus
1024+ 972B ~
1025+ 972B ~            (obvykle 2)
1026+ 972B ~
1027+ 972B ~            První sektor Root Directory:
1028+ 972B ~            RootDirLBA =
1029+ 972B ~            FirstDataSectorAbs +
1030+ 972B ~            (RootCluster − 2) × SecPerClus
1031+ 972B ~
1032+ 972B ~
1033+ 972B ~
