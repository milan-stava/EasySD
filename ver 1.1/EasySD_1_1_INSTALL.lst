 898+ 972B              ;
 899+ 972B              ;prvni sektor partition je BOOT a tam jsou tyto zajimave udaje:
 900+ 972B              ;0Bh, 0Ch   pocet bytu na sektor
 901+ 972B              ;0Eh, 0Fh   pocet sektoru pred prvni FAT
 902+ 972B              ;10h   pocet FAT
 903+ 972B              ;11h, 12h   pocet polozek v ROOTu
 904+ 972B              ;16h, 17h   pocet sektoru ve FAT
 905+ 972B              ;prvni datovy sektor je: zacatek_partition + sektoru_pred_FAT + sektoru_ve_FAT * pocet_FAT + polozek_v_ROOT * 20h / bytu_na_sektor
