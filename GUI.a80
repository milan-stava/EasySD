;28) (Busy's routine)
HL2ASCII32
;Prevod bin->dec bez znamienka
; in: zzbin
;out: zzdec

	push	bc
bindec	ld	hl,zzdec            ;; Vynulovanie buffera dec
	ld	bc,lldec*#0100
cls1	ld	(hl),c
	inc	hl
	djnz	cls1
	ld	c,8*llbin           ;; Opakuj pre kazdy bit bin:
bndc0	call	binx2               ;; vyrotovanie bitu z bin
	ld	hl,eedec
	ld	b,lldec             ;; a zarotovanie toho bitu do dec
bndc2	dec	hl
	ld	a,(hl)
	adc	a,a
	cp	#0a
	jr	c,bndc3
	sub	#0a
bndc3	ld	(hl),a
	ccf
	djnz	bndc2
	dec	c
	jr	nz,bndc0

	ld	hl,zzdec
	ld	b,10		;; change it to ASCII
prev_ascii32
	ld	a,(hl)
	or	a
	jr	nz,asc32n
	inc	hl
	djnz	prev_ascii32

	inc	b		;osetreni 0
	dec	hl		;udelej misto pro zobrazeni "O"

asc32n	ld	d,h
	ld	e,l		;; DE=ASCII number start

asc32_n	ld	a,#30
	or	(hl)
	ld	(hl),a
	inc 	hl
	djnz	asc32_n
	pop	bc
	ret

binx2	ld	hl,zzbin            ;; Nasobenie bin dvomi
	ld	b,llbin
	xor	a
bnxx2	rl	(hl)
	inc	hl
	djnz	bnxx2
	ret

zzbin	db	#ff,#ff,#ff,#ff		;vstup v bajtech
eebin
llbin	=	eebin-zzbin

zzdec	db	0,0,0,0,0		;vystup v ASCII
	db	6,5,5,3,5
eedec
lldec	=	eedec-zzdec
	db	0			;zarážka pro tisk


;hledani prvni sectoru pro data
;prohledava se MBR, prvni partion, a hleda se v root dir. prvni datovy sector prvniho souboru
;prvni sektor disku je MBR:
;
;na 1BEh zacinaji parametry prvni partition (10h kazda)
;na 08h az 0Bh je cislo relativniho sektoru zacatku partition (nebo na 01h az 03h ve formatu hlava/sektor/cylindr)
;
;prvni sektor partition je BOOT a tam jsou tyto zajimave udaje:
;0Bh, 0Ch   pocet bytu na sektor
;0Eh, 0Fh   pocet sektoru pred prvni FAT
;10h   pocet FAT
;11h, 12h   pocet polozek v ROOTu
;16h, 17h   pocet sektoru ve FAT
;prvni datovy sektor je: zacatek_partition + sektoru_pred_FAT + sektoru_ve_FAT * pocet_FAT + polozek_v_ROOT * 20h / bytu_na_sektor


/*
1. Výpočet pro FAT16
********************
Kořenový adresář u FAT16 má pevnou velikost a leží hned za poslední FAT tabulkou.

Vzorec (číslo sektoru od začátku disku/partice):

RootSector{FAT16}=ReservedSecCnt+(NumFATs x FATSize16)

Velikost root adresáře (v sektorech) se spočítá jako (RootEntCnt × 32 + BytsPerSec - 1) / BytsPerSec, ale jeho začátek je dán čistě součtem rezervovaných sektorů a obou FAT tabulek.

2. Výpočet pro FAT32
Kořenový adresář u FAT32 nemá pevnou pozici, je to běžný cluster. Nejprve musíme spočítat začátek datové oblasti (DataSecStart) a k němu přičíst offset daný počátečním clusterem (RootClus).

Vzorec pro začátek datové oblasti (stejný jako FAT16):

DataSecStart=ReservedSecCnt+(NumFATs x FATSize32)

Vzorec pro počáteční sektor root adresáře (rootClus):

RootSector{FAT32}= DataSecStart+((RootClus-2) x SecPerClus)

(Odečítá se 2, protože clustery 0 a 1 v datové oblasti fyzicky neexistují – číslování datových clusterů začíná od 2).



Kde najít rootClus a SecPerClus (pro FAT32)
*******************************************
Obě hodnoty jsou uloženy v boot sektoru (v datové struktuře BPB – BIOS Parameter Block):

- SecPerClus (Sectors per Cluster): 1bajtová hodnota na offsetu 0x0D (decimálně 13) od začátku boot sektoru

- rootClus (Root Directory Start Cluster): 4bajtová hodnota na offsetu 0x2C (decimálně 44) od začátku boot sektoru (obvykle 2)

Výpočet počátečního sektoru Root Dir
************************************
Pro výpočty používáme tyto proměnné z boot sektoru:
- ReservedSecCnt = Počet rezervovaných sektorů (offset 0x0E (dec 14), 2 bajty)
- NumFATs = Počet FAT tabulek (offset 0x10 (dec 16), 1 bajt, obvykle 2)
- FATSize16 = Počet sektorů jedné FAT u FAT16 (offset 0x16 (dec 22), 2 bajty)
- FATSize32 = Počet sektorů jedné FAT u FAT32 (offset 0x24 (dec 36), 4 bajty)
- RootEntCnt = Maximální počet položek v root adresáři u FAT16 (offset 0x11 (dec 17), 2 bajty, obvykle 512)
- BytsPerSec = Počet bajtů na sektor (offset 0x0B (dec 11), 2 bajty, obvykle 512)
- SecPerClus = Počet sektorů na cluster (offset 0x0D (dec 13), 1 bajt)
- RootClus = Počáteční cluster root adresáře u FAT32 (offset 0x2C (dec 44), 4 bajty)

*/

/*
1. k boot sektoru se umime dostat z MBR
2. potřebné pro výpočet z boot sektoru, tyto hodnoty jsou relativni k zacatku partisny:
---------------------------------------------------------------------------------------
BPB_BytesPerSec		offset	11	delka 2
BPB_SecPerClus		offset	13	delka 1
BPB_RsvdSecCnt		offset	14	delka 2
BPB_NumFATs		offset  16	delka 1

FAT16:
    BPB_RootEntCnt	offset	17	delka 2
    BPB_FATSz16		offset	22	delka 2

FAT32:
    BPB_FATSz32		offset	36	delka 4
    BPB_RootClus	offset	44	delka 4


3. vypocet prvniho datoveho sektoru
--------------------------------
FAT16
Spočti velikost Root Directory:

RootDirSectors =
(RootEntCnt × 32) / BytesPerSector

Potom:
FirstDataSectorRel =
RsvdSecCnt +
NumFATs × FATSz16 +
RootDirSectors

Absolutni LBA:
FirstDataSectorAbs =
PartitionStartLBA +
FirstDataSectorRel


FAT32
Root Directory je součást datové oblasti.

Proto:
FirstDataSectorRel =
RsvdSecCnt +
NumFATs × FATSz32

Absolutně:
FirstDataSectorAbs =
PartitionStartLBA +
FirstDataSectorRel


4. Načti Root Directory
-----------------------
FAT16

Root Directory začíná na:
RootDirLBA =
PartitionStartLBA +
RsvdSecCnt +
NumFATs × FATSz16

Je pevně daný.

FAT32

Root Directory začíná v clusteru:
RootCluster = BPB_RootClus

(obvykle 2)

První sektor Root Directory:
RootDirLBA =
FirstDataSectorAbs +
(RootCluster − 2) × SecPerClus



5. Najdi soubor MBD / MBH
-------------------------
Projdi prvních 8 položek.

Přečti:

FAT16:
DIR_FstClusLO

FAT32:
DIR_FstClusHI
DIR_FstClusLO

Vznikne:
FirstCluster


6. Převod clusteru na LBA
-------------------------
Platí pro FAT16 i FAT32 stejně:

FirstFileLBA =
FirstDataSectorAbs +
(FirstCluster − 2) × SecPerClus

Hotovo.


Celý algoritmus
---------------
MBR
 │
 ├── PartitionStartLBA
 │
 ▼
Boot Sector
 │
 ├── SecPerClus
 ├── Reserved
 ├── FATSize
 ├── RootEntries (FAT16)
 └── RootCluster (FAT32)
 │
 ▼
FirstDataSectorAbs
 │
 ▼
Root Directory
 │
 ▼
Najdi MBD / MBH
 │
 ▼
FirstCluster
 │
 ▼
FirstFileLBA
*/

;tab_part	db	0,4,15,26	;sloupec tisku hodnot pro 4 partisny

next
	ld	hl,TEXTPARSEC
	ld	bc,#0B02
	call	T42_TEXT

;novy kod- testuje vsechny 4 partisny
;nejprve nacteme MBR

		ld	a,4		;pocet partisen
		ld	ix,BUFFER+446	;prvni partisna
		ld	b,#0C	;radek (meni se pro kazdou partisnu)
		ld	hl,VDT
		ld	(VDT_pointer+1),hl

test_partitions				;loop start
		ld	c,2		;sloupec vzdy zaciname na 2 (posouva se spolu s tiskem)
		push	af		;A= poradove cislo partisny (4-0)
		push	ix		;zacatek udaje o partisne v MBR
		push	bc		;radek+sloupec

		ld	ix,BUFFER
		ld	hl,0
		ld	d,h
		ld	e,h
		call	SD_READ

		pop	bc
		pop	ix
		push	ix
		push	bc		

