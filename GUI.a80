	call	T42_TEXT
	inc	c
	ld	hl,TEXT19
;	ld	bc,#1303
	call	T42_TEXT

Endinentify
;projed partisny, zda jsou vsechny platne
	call	check_for_valid
	jp	z,end_easy

	ld	a,(@autoconfig)
	or	a
	jp	nz,manual_partition_selection

;automatic_partition_selection
	ld	a,(@partition)
	call	test_partition		;test just selected partition
	jr	nz, fp1

;Z=invalid, seek for valid one
;neni platna, hledej prvni platnou a nainstluj  ji
	call	check_for_valid
	jr	nz,found_partition

;žádná platná partition. Co s tim? Vynulujeme VDT tabulku a partisn nechame, protoze pak se do VDT tabulky vepise 0
	ld	hl,VDT
	ld	de,VDT+1
	ld	bc,255
	ld	(hl),l
	ldir
	jr	end_easy		;nenasli jsme platnou partisnu
/*
vp1	ld	hl,TEXT_NO_VALID
	ld	bc,#1602
	call	T42_TEXT
	xor	a
	jr	ayn
*/
  
found_partition
	ld	(@partition),a		;dame ji do configu, odtud si ji pak vezme hlavni prog v konfig casti bsdosu

fp1	ld	hl,TEXT_CLR
	ld	bc,#1602
	call	T42_TEXT
	ld	hl,TEXT100
	ld	bc,#1602
	call	T42_TEXT

valid_partition
	ld	a,(@partition)
	ld	h,0
	ld	l,a
	call	NUMBER0
	ld	hl,TEXT_PRESS_KEY
	ld	bc,#161A
	call	T42_TEXT

autoinstall_yes_no
	ld	a,(@autoinstall)
	or	a
ayn	call	nz,ANYKEY
	IFDEF ELEMENT
		ld	hl,TEXT_CLR
		ld	bc,#1602
		call	T42_TEXT
		ld	hl,TEXT_AUTOSYS
		ld	bc,#160C
		call	T42_TEXT
	ENDIF
	ret
; navrat

;------------------------------------------------------------
; eLeMeNt only: service #30 returned, so AUTOSYS was not started.
; Replace the status line, wait for acknowledgement and return
; to MAIN, which will continue with the BSROM reset fallback.
AUTOSYS_NOT_FOUND
	ld	hl,TEXT_CLR
	ld	bc,#1602
	call	T42_TEXT
	ld	hl,TEXT_AUTOSYS_NOT_FOUND
	ld	bc,#1606
	call	T42_TEXT
	call	ANYKEY
	ret

test_partition				;IN=A=partition number 1-4, OUT=Z=invalid partition, NZ=valid
	ld	de,32			;testuj zvolenou partisnu (v @partition), zda je platna
;	ld	a,(@partition)
	ld	b,a
	ld	hl,VDT-32
loop1	add	hl,de
	djnz	loop1
	bit	1,(hl)
	ret
;	jr	nz,fp1			;NZ=set partition (from autoconfig or manual) is valid

;IN=noothing, OUT=NZ=valid, Z=invalid
check_for_valid
	ld	de,32			; kazdy VDT zaznam ma presne 32 bajtu
	ld	hl,VDT		
	ld	a,1
	ld	b,4
find_valid:
        bit	1,(hl)
	ret	nz 
;       jr      nz,found_partition
	add	hl,de
	inc	a
        djnz    find_valid
	xor	a			; zadna platna partition -> Z
	ret

end_easy
	ld	hl,TEXT_NO_VALID
	ld	bc,#1602
	call	T42_TEXT

end_easy_exit
	IFDEF ELEMENT		;stisk EDIT=konec, v pripade EL, ktery neni jeste inicializovany, musime udelat 128K reset
	xor	a
	jp	#3978
	ELSE

	pop	hl		;navratova adresa
	ret			;navrat do BASICu
	ENDIF
;user menu
;priprava k menu, rutina IINKEY vraci v A kod klavesy, #B=nahoru, #A=dolu
;definice
cursor		equ %00001000		;item with cursor (dark blue cursor)
no_curs		equ %11110111		;item without cursor

page		equ 3		;we will move around 4 items
cursor_w_stadr	dw #5981	;start address of cursor
cursor_w_curad	dw #5981	;current address of cursor
cursor_len	equ 29
wind_curs_item	db #55		;current start cursor position of the window (0-page)
;item_pg_start	dw #5555	;;;;;start address of first dir item on displayed page

key_enter	ld	a,(wind_curs_item)
		inc	a
		call	test_partition
		jp	nz,found_partition	;NZ=we found the valid one

		ld	hl,TEXT_CLR
		ld	bc,#1602
		push	bc
		call	T42_TEXT

		ld	hl,TEXT_PART_NOUSE
		ld	bc,#1605
		call	T42_TEXT

		call	ANYKEY

		ld	hl,TEXT_CLR
		pop	bc
		call	T42_TEXT

		jr	 mps1		;zachovej kurzor, kde je

;		call	undraw_cursor

manual_partition_selection
		xor	a	;inicializace
		ld	(wind_curs_item),a
		ld	hl,(cursor_w_stadr)
		ld	(cursor_w_curad),hl

		call	draw_cursor

mps1		ld	hl,TEXT_MAKE_SELEC
		ld	bc,#1603
		call	T42_TEXT
;key detection loop
iik		call	KEYSCAN
		ld	de,32
		cp	#B
		call	z,key_up
		cp	#A
		call	z,key_down
		cp	13
		jr	z,key_enter
		cp	7
		jr	z,end_easy		;EDIT pressed, end EasySD
		jr	iik

key_up		ld	hl,wind_curs_item
		ld	a,(hl)
		or	a
		ret	z		;Z=already first line
		dec	(hl)
		call	undraw_cursor
		ld	hl,(cursor_w_curad)
		or	a
		sbc	hl,de
		ld	(cursor_w_curad),hl
		call	draw_cursor
		ret

key_down	ld	hl,wind_curs_item
		ld	a,(hl)
		cp	page
		ret	z
		inc	(hl)
		call	undraw_cursor
		ld	hl,(cursor_w_curad)
		add	hl,de
		ld	(cursor_w_curad),hl
		call	draw_cursor
		ret

undraw_cursor	ld	hl,(cursor_w_curad)
		ld	a,(hl)
		and	no_curs
;		and	%11110111
		jr	dc_1
draw_cursor	ld	hl,(cursor_w_curad)
		ld	a,(hl)
;		or	%00001000
		or	cursor

dc_1		ld	b,cursor_len
dc_2		ld	(hl),a
		inc	hl
		djnz	dc_2
		xor	a			;A=0 to avoid artifical key press
		ret
/*
undraw_cursor	ld	a,unmark_no_curs
		jr	dc_1
draw_cursor	ld	a,unmark_cursor
dc_1		ld	hl,(cursor_w_curad)
		ld	b,cursor_len
dc_2		ld	(hl),a
		inc	hl
		djnz	dc_2
		xor	a			;A=0 to avoid artifical key press
		ret
*/
