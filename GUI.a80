;Nejdriv rozhodneme, zda LBA 0 neni primo FAT boot sektor (superfloppy).
;Teprve kdyz neni, smime oblast od offsetu 446 interpretovat jako MBR tabulku.
;Kontroly se delaji primo v BUFFERu, protoze IX v tomto miste ukazuje na MBR entry.

		ld	a,(BUFFER+0)		;boot jump EB xx 90 nebo E9 xx xx
		cp	#EB
		jr	z,sf_check_bps
		cp	#E9
		jr	nz,not_superfloppy

sf_check_bps
		ld	hl,(BUFFER+11)	;BytesPerSector musi byt 512 = #0200
		ld	de,#0200
		or	a
		sbc	hl,de
		jr	nz,not_superfloppy

		ld	a,(BUFFER+13)	;SecPerClus nesmi byt 0
		or	a
		jr	z,not_superfloppy

		ld	hl,(BUFFER+14)	;ReservedSectorCount nesmi byt 0
		ld	a,h
		or	l
		jr	z,not_superfloppy

		ld	a,(BUFFER+16)	;NumFATs nesmi byt 0
		or	a
		jr	z,not_superfloppy

		ld	hl,(BUFFER+510)	;boot signature 55 AA
		ld	de,#AA55
		or	a
		sbc	hl,de
		jr	nz,not_superfloppy

;Rozliseni FAT16/FAT32 podle struktury BPB.
		ld	hl,(BUFFER+17)	;RootEntCnt: FAT16 !=0, FAT32 =0
		ld	a,h
		or	l
		jr	nz,sf_fat16

		ld	hl,(BUFFER+22)	;FATSz16: FAT16 !=0, FAT32 =0
		ld	a,h
		or	l
		jr	nz,sf_fat16

		ld	hl,(BUFFER+36)	;u FAT32 musi byt FATSz32 nenulove
		ld	de,(BUFFER+38)
		ld	a,h
		or	l
		or	d
		or	e
		jr	z,not_superfloppy

;Superfloppy FAT32
sf_fat32
		ld	hl,fat_type
		set	0,(hl)
		ld	a,4+8			;bit2=superfloppy, bit3=FAT32
		jr	sf_type_ready

;Superfloppy FAT16
sf_fat16
		ld	hl,fat_type
		res	0,(hl)
		ld	a,4			;bit2=superfloppy, bit3=0=FAT16

sf_type_ready
		ld	hl,(VDT_pointer+1)
		ld	(hl),a

;U superfloppy vypiseme nejen SFl, ale i skutecny FAT typ.
;Bit 3 info bajtu: 0=FAT16, 1=FAT32.
		ld	hl,TEXT_SFL16
		bit	3,a
		jr	z,sf_text_ready
		ld	hl,TEXT_SFL32

sf_text_ready
		pop	bc			;obnov tiskovou pozici stejne jako part_text
		call	T42_TEXT
		dec	c			;TEXT_SFL16/32 je o 4 znaky delsi nez F16/F32
		dec	c			;vrat tiskovou pozici pro dalsi sloupec
		dec	c
		dec	c

;Superfloppy ma jen jeden filesystem. Upravime ulozeny citac smycky na 1,
;aby se po jeho zpracovani netestovaly dalsi tri fiktivni MBR polozky.
		pop	ix			;puvodni pointer na prvni MBR entry
		pop	af			;puvodne A=4
		ld	a,1
		push	af
		push	ix

		ld	hl,0			;Boot sector superfloppy je absolutni LBA 0
		ld	de,0
		jp	MBRno

not_superfloppy
;LBA 0 neni FAT boot sektor, muzeme ho interpretovat jako MBR.
;MBR je v bufferu
		ld	a,(ix+4)		;test, zda je partisna vubec pritomna
		or	a			;0= partisna neni obsazena
		jp	z,no_partition

;	set	0,(ix-1)	;nastav priznak FAT32
	ld	hl,fat_type
	set	0,(hl)
	ld	b,9		;bity 0,3=1= FAT32
	ld	hl,TEXT_FAT32	;test typu oddilu, bud FAT16/32/other
;	ld	bc,#0c12
	cp	#B		;pro typ oddilu FAT32
	jp	z,part_text
	cp	#C
	jp	z,part_text

	ld	hl,fat_type
	res	0,(hl)
;	res	0,(ix-1)	;nastav priznak FAT16
	ld	hl,TEXT_FAT16
	ld	b,1		;bit 1=1, bit 3=0= FAT16
	cp	6		;pro typ oddilu FAT16
	jp	z,part_text
	cp	4
	jp	z,part_text
	cp	#E
	jp	z,part_text	

; Nepodporovane filesystemy se pokusime pojmenovat.
; VDT info zustava 0, takze jsou stale pro EasySD nepouzitelne.
	cp	#05			; Extended partition (CHS)
	jp	z,part_extended
	cp	#0F			; Extended partition (LBA)
	jp	z,part_extended
	cp	#07			; HPFS/NTFS/exFAT - rozlisime z boot sektoru
	jp	z,part_type_07
	cp	#83			; Linux native (ext2/ext3/ext4...)
	jp	z,part_linux
	cp	#EE			; GPT protective MBR
	jp	z,part_gpt

part_other
	ld	hl,TEXT_OTHER
	ld	b,0
	jr	part_text

part_linux
	ld	hl,TEXT_LINUX
	ld	b,0
	jr	part_text

part_extended
	ld	hl,TEXT_EXTENDED
	ld	b,0
	jr	part_text

part_gpt
	ld	hl,TEXT_GPT
	ld	b,0
	jr	part_text

; MBR type #07 je spolecny pro NTFS i exFAT.
; Nacteme pouze boot sektor teto partition do BUFFER2, abychom neprepsali MBR v BUFFERu.
; OEM ID je od offsetu +3: "NTFS    " nebo "EXFAT   ".
part_type_07
	push	ix
	; SD_READ expects HL=upper 16 bits LBA, DE=lower 16 bits LBA
	ld	e,(ix+8)
	ld	d,(ix+9)
	ld	l,(ix+10)
	ld	h,(ix+11)
	ld	ix,BUFFER2
	call	SD_READ
	pop	ix

	ld	a,(BUFFER2+3)
	cp	'N'
	jr	nz,part_check_exfat
	ld	a,(BUFFER2+4)
	cp	'T'
	jr	nz,part_check_exfat
	ld	a,(BUFFER2+5)
	cp	'F'
	jr	nz,part_check_exfat
	ld	a,(BUFFER2+6)
	cp	'S'
	jr	nz,part_check_exfat
	ld	hl,TEXT_NTFS
	ld	b,0
	jr	part_text

part_check_exfat
	ld	a,(BUFFER2+3)
	cp	'E'
	jr	nz,part_other
	ld	a,(BUFFER2+4)
	cp	'X'
	jr	nz,part_other
	ld	a,(BUFFER2+5)
	cp	'F'
	jr	nz,part_other
	ld	a,(BUFFER2+6)
	cp	'A'
	jr	nz,part_other
	ld	a,(BUFFER2+7)
	cp	'T'
	jr	nz,part_other
	ld	hl,TEXT_EXFAT
	ld	b,0

part_text
	push	hl
	ld	a,b
	ld	hl,(VDT_pointer+1)
	ld	(hl),a
	pop	hl
	pop	bc
	call	T42_TEXT

; Pokud je typ partition OTHER, zde zpracovani konci.
; Info bajt VDT je 0, tedy partition je pro EasySD nepouzitelna.
; Nesmime pokracovat do load_boot, jinak bychom cizí filesystem
; (NTFS/exFAT/...) interpretovali jako FAT a poskodili i zarovnani VDT.
	push	bc			;tiskova pozice pro ep2
	ld	hl,(VDT_pointer+1)
	ld	a,(hl)
	or	a
	jr	nz,partition_is_fat
	ld	bc,32			;preskoc cely VDT zaznam OTHER
	jp	ep3

partition_is_fat
	pop	bc			;FAT cesta ma BC dale mimo stack jako dosud

					;ted hledame boot sektor pro dany oddil
		ld	hl,(BUFFER2-2)
		ld	de,#AA55		;znacka platneho zaznamu MBR
		or	a
		sbc	hl,de
		jr	z,load_boot	;Z=tabulka MBR je platna

;Neni FAT boot sektor ani platna MBR signatura.
		jr	not_boot

not_boot	pop	bc		;nejde ani o boot sektor, medium nema smysluplna data, konec
		pop	ix
		pop	af

		ld	hl,(VDT_pointer+1)
		ld	(hl),0		;info bajt=0

		ld	hl,TEXT_NODATA
		call	T42_TEXT
		di
		halt			;zatim
;vytisknout, ze medium nema smylsuplna data a konec

; pravděpodobně FAT Boot Sector
/*stary test davame pryc
		ld	hl,0		;jeste puvodni test MBR (puvodni EasyHdd)
		ld	d,h
		ld	e,h
		ld	a,(ix+0)	;je oddil bootovaci? Pokud ano, vycti boot sektor,pokud ne, bude boot v sektoru 0
		and	127
		jr	nz,MBRno
		ld	a,(ix+2)	;ale toto moc nechapu, pro se testuje CHS?
		and	a
		jr	z,MBRno
*/



load_boot	ld	l,(ix+8)
		ld	h,(ix+9)	;nizsi
		ld	e,(ix+10)
		ld	d,(ix+11)	;vyssi


MBRno		ld	(bootsec1+1),de	;pro MBRno, vyplnujeme vse 0
		ld	(bootsec+1),hl	;schovame cislo bootsektoru pro budouci vypocet


;mame boot sektor, jdeme ho nahrat a taky vypsat na obrazovku
		ld	(zzbin),hl
		ld	(zzbin+2),de
		push	hl
		push	de
;		push	bc		;BC=tiskova pozice
		call	HL2ASCII32
;		pop	bc
		inc	c		;posunuli jsme tiskovou pozici

		ld	hl,zzdec+9
		set	7,(hl)
		ld	hl,zzdec
;		ld	bc,#0B10

mbs1		ld	a,(hl)
		or	a
		jr	nz,mbs2
		inc	hl
		inc	c
		jr	mbs1

mbs2		call	T42_TEXT	;vypis jeho cislo

		pop	hl
		pop	de		;HLDE=boot sektor

		inc	c
		push	bc		;posun tiskovou pozici

		ld	ix,BUFFER
		call	SD_READ		;nacti boot na adresu v IX (BUFFER)

/*toto bylo na zacatku, kdyz jsem si to potreboval vizualizovat
		ld	hl,BUFFER+11	;prenes hodnoty z boot sektoru potrebne pro vypocet
		ld	de,BPB_BytesPerSec	
		ld	bc,8
		ldir
		ld	hl,BUFFER+22
		ld	(BPB_FATSz16),hl
		ld	hl,BUFFER+36
		ld	bc,4
		push	bc
		ldir
		ld	hl,BUFFER+44
		pop	bc
		ldir

;hodnoty z bootu
BPB_BytesPerSec		dw	#5555	;offset	11	delka 2
BPB_SecPerClus		db	#55	;offset	13	delka 1
BPB_RsvdSecCnt		dw	#5555	;offset	14	delka 2
BPB_NumFATs		db	#55	;offset 16	delka 1

FAT16:
BPB_RootEntCnt		dw	#5555	;offset	17	delka 2
BPB_FATSz16		dw	#5555	;offset	22	delka 2

FAT32:
BPB_FATSz32		dw	#5555,#5555	;offset	36	delka 4
BPB_RootClus		dw	#5555,#5555	;offset	44	delka 4
*/


;3. Výpočet prvního datového sektoru
;pocet FAT x velikost FAT
		ld	l,(ix+17)	;pouze pro FAT16. pocet polozek v Root diru, rovnou vypocitame pocet polozek
		ld	h,(ix+18)	;(pocet polozek*32)/512=pocet sektoru
		
		ld	b,4		;vpocet si zjednodusime
lb2_f16		srl	h
		rr	l
		djnz	lb2_f16
		ld	(RootEntCnt+1),hl	;

		ld	a,(ix+13)	;pocet sektoru na cluster
		ld	(l1F+1),a

		bit	0,(ix-1)	;jdeme pocitat, nejprve počet FATx delka FAT
		ld	l,(ix+22)	;FAT16-pocet sektoru FAT
		ld	h,(ix+23)
		ld	de,0
		jr	z,lb1_f16		
		ld	l,(ix+36)	;FAT32- pocet sektoru FAT
		ld	h,(ix+37)
		ld	e,(ix+38)
		ld	d,(ix+39)
lb1_f16		ld	a,(ix+16)	;pocet FAT tabulek
		call	MUL32x8		;nasobeni 32x8, vysledek je HL'DE'

;pricteme k tomu pocet rezervovanych sektoru
		ld	c,(ix+14)	;pocet rezervovanych sektoru
		ld	b,(ix+15)
		call	ADD32_16	;scitani 32+16, out HLDE
		exx			;vysledek je v HLDE
;mame FirstDataSectorRel
					;jeste pricist sektory od bootu
;pricteme k tomu PartitionStartLBA (boot sektor)
bootsec		ld	hl,#5555	;nizsi
bootsec1	ld	de,#5555	;vyssi
		call	ADD32_32	;vysledek je v HLDE

;uschovej absolutni zacatek datove oblasti. U FAT32 se RootDir muze nachazet
;v jinem clusteru nez 2, proto se pozdeji MBD musi pocitat od FirstDataLBA,
;nikoli od RootDirLBA.
		ld	(FirstDataLBA),hl
		ld	(FirstDataLBA+2),de

; FAT16: HLDE uz obsahuje spravny RootDir LBA.
; FAT32 pomocne vypocty nize by HLDE znicily.
		bit     0,(ix-1)
		jr      z,load_root_dir

;udaje potrebne pro robustni prohledani FAT32 root directory
		ld	a,(ix+13)
		ld	(FAT32_SecPerClus),a
		ld	l,(ix+44)
		ld	h,(ix+45)
		ld	(FAT32_CurCluster),hl
		ld	l,(ix+46)
		ld	h,(ix+47)
		ld	(FAT32_CurCluster+2),hl

;FirstFATLBA = PartitionStartLBA + ReservedSectors
		ld	hl,(bootsec+1)
		ld	de,(bootsec1+1)
		ld	c,(ix+14)
		ld	b,(ix+15)
		add	hl,bc
		jr	nc,.fatlba_no_carry
		inc	de
.fatlba_no_carry
		ld	(FAT32_FirstFATLBA),hl
		ld	(FAT32_FirstFATLBA+2),de

;hotovo pro FAT16. HLDE= root dir pro FAT16


		bit	0,(ix-1)
		jr	z,load_root_dir

		exx
					;pro FAT32 musime pokracovat
		ld	l,(ix+44)	;first cluster number of the root directory
		ld	h,(ix+45)
		ld	e,(ix+46)
		ld	d,(ix+47)
;odecteme 2, protoze pokud je cluster ve FAT32=2, pak zacatek root dir je hned za FAT2, jako u FAT16
		ld	a,2
		call	SUB32_8		
		ld	a,(ix+13)
		call	MUL32x8
		call	ADD32_32
					;HLDE=root dir pro FAT32

load_root_dir	
/*toto je spatne, tohle cislo nechceme tisknout, budeme tisknout soubor do tretiho sloupce
		pop	bc		;tiskova pozice, nechame ji venku, nic ji neposkozuje
		push	hl
		push	de		;dame to bokem

		ld	(zzbin),hl	;nejprve tisk
		ld	(zzbin+2),de

		call	HL2ASCII32
		ld	hl,zzdec+9
		set	7,(hl)
		ld	hl,zzdec
;		ld	bc,#0B1B
;		pop	bc
lrd1		ld	a,(hl)
		or	a
		jr	nz,lrd2
		inc	hl
		inc	c
		jr	lrd1

lrd2		call	T42_TEXT	;vypis jeho cislo
					;... a load a vyhledani souboru .MBD/.MBH
		inc	c

		pop	hl
		pop	de		;HLDE=Root Dir FAT32/FAT16
;uschovame ho, bude ještě potřeba, je to start DIRs sektoru pro FAT16, nebo start datovch sektoru pro FAT32

		push	hl		
		push	de

		push	bc		;tiskova pozice

*/
		pop	bc
		ex	de,hl
		push	hl
		push	de
		push	bc		;BC=tiskova pozice

;	ld	ix,BUFFER
;;;	ld	a,%00000000	;master

;FAT32: neber prvni MBD podle poradi directory entries.
;Projdi cely root cluster chain a vyber MBD/MBH s NEJNIZSIM start clusterem,
;tj. fyzicky prvni image na karte.
	ld	a,(fat_type)
	bit	0,a
	jr	z,.scan_fat16_old

	call	FAT32_FIND_LOWEST_MBD
	ld	hl,(VDT_pointer+1)
	or	a
	jp	nz,platne
	jr	mbd_not_found

.scan_fat16_old
	call	SD_READ

	ld	b,8		;; FAT16 zustava beze zmeny: prvnich 8 polozek
	ld	de,32		;; kazda polozka ma 32 bytes
	ld	hl,(VDT_pointer+1)
nextfile
	ld	a,(ix+08h)
	cp	"M"
	jr	nz, neplatne
	ld	a,(ix+09h)
	cp	"B"
	jr	nz, neplatne
	ld	a,(ix+0ah)
	cp	"H"
	jp	z, platne
	cp	"D"
	jp	z, platne
neplatne
	add	ix,de
	djnz	nextfile

mbd_not_found
	res	1,(hl)		;nastav priznak, ze jde o nepouzitelny oddil, nema MBD soubor

	ld	hl,TEXT_NODATA
	pop	bc		;tiskova pozice
	call	T42_TEXT	;tisk "No Data"= soubor MBD/MBH neni pritomen

	; Cely radek teto partition obarvime cervene.
	; B obsahuje cislo aktualniho textoveho radku.
	; Atributova oblast ZX zacina na #5800, polozky menu od sloupce 1.
	push	bc
	ld	a,b
	ld	hl,#5801
	ld	de,32
	ld	b,a
no_data_red_seek
	add	hl,de
	djnz	no_data_red_seek
	ld	b,cursor_len	; stejne dlouhy radek jako kurzor (29 atributu)
	ld	a,66		; bright red ink, black paper
no_data_red_fill
	ld	(hl),a
	inc	hl
	djnz	no_data_red_fill
	pop	bc

	; MBD/MBH se nenasel. Na zasobniku jsou jeste dve 16bitove
	; poloviny ulozeneho RootDir LBA. Pres l1F uz nesmime pokracovat,
	; protoze l1F ocekava na vrcholu zasobniku znovu BC a pocita LBA
	; neexistujiciho souboru. Uklidime RootDir a vratime BC tak, jak ho
	; ocekava end_partition/ep2.
	pop	de		;zahod ulozene DE RootDir LBA
	pop	hl		;zahod ulozene HL RootDir LBA
	push	bc		;ep2 bude znovu delat POP BC

	; No Data je stale jeden kompletni 32B VDT zaznam.
	; Musime posunout VDT_pointer na nasledujici partition, jinak
	; se dalsi platna partition zapise do stejneho VDT zaznamu.
	ld	hl,(VDT_pointer+1)
	ld	bc,32
	jp	ep3


;------------------------------------------------------------------------------
; FAT32_FIND_LOWEST_MBD
; Projde CELÝ ALOKOVANY FAT32 root directory cluster chain a z nalezenych MBD/MBH
; vybere soubor s nejmensim start clusterem = fyzicky prvni MBD.
;
; OUT:
;   A=0  ... MBD/MBH nenalezen
;   A=1  ... nalezen, IX -> FAT32_BestEntry (32B kopie directory entry)
;
; Pouziva BUFFER pro directory sektor, BUFFER2 pro sektor FAT.
;------------------------------------------------------------------------------
FAT32_FIND_LOWEST_MBD
	xor	a
	ld	(FAT32_Found),a
	ld	hl,#FFFF
	ld	(FAT32_BestCluster),hl
	ld	(FAT32_BestCluster+2),hl

.f32_cluster_loop
	; DirLBA = FirstDataLBA + (CurCluster-2) * SecPerClus
	; Pouzij existujici 32bit math rutiny; pouze platne Z80 instrukce.
	ld	hl,(FAT32_CurCluster)
	ld	de,(FAT32_CurCluster+2)
	ld	a,2
	call	SUB32_8
	ld	a,(FAT32_SecPerClus)
	call	MUL32x8
	exx
	ld	hl,(FirstDataLBA)
	ld	de,(FirstDataLBA+2)
	call	ADD32_32

	ld	(FAT32_DirLBA),hl
	ld	(FAT32_DirLBA+2),de

	ld	a,(FAT32_SecPerClus)
	ld	(FAT32_SectorsLeft),a

.f32_sector_loop
	ld	de,(FAT32_DirLBA)
	ld	hl,(FAT32_DirLBA+2)
	ld	ix,BUFFER
	call	SD_READ

	ld	b,16			; cely 512B sektor = 16 x 32B entries
	ld	ix,BUFFER

.f32_entry_loop
	ld	a,(ix+0)
	or	a
	jp	z,.f32_next_entry	; 00 = volna/nepouzita polozka; projdeme cely alokovany root chain
	cp	#E5
	jp	z,.f32_next_entry	; deleted

	ld	a,(ix+11)
	cp	#0F
	jr	z,.f32_next_entry	; LFN
	bit	3,a
	jr	nz,.f32_next_entry	; volume label
	bit	4,a
	jr	nz,.f32_next_entry	; directory

	ld	a,(ix+8)
	cp	"M"
	jr	nz,.f32_next_entry
	ld	a,(ix+9)
	cp	"B"
	jr	nz,.f32_next_entry
	ld	a,(ix+10)
	cp	"D"
	jr	z,.f32_candidate
	cp	"H"
	jr	nz,.f32_next_entry

.f32_candidate
	; FAT32 start cluster: HI word @20, LO word @26
	ld	l,(ix+26)
	ld	h,(ix+27)
	ld	e,(ix+20)
	ld	a,(ix+21)
	and	#0F
	ld	d,a

	; cluster 0/1 neni platny datovy cluster
	ld	a,d
	or	e
	or	h
	jr	nz,.f32_compare
	ld	a,l
	cp	2
	jr	c,.f32_next_entry

.f32_compare
	; unsigned 32bit: DEHL < BestCluster ?
	; candidate-Best, carry z horniho slova znamena candidate < Best.
	push	de
	push	hl
	ld	bc,(FAT32_BestCluster)
	or	a
	sbc	hl,bc
	ex	de,hl
	ld	bc,(FAT32_BestCluster+2)
	sbc	hl,bc
	pop	hl
	pop	de
	jr	nc,.f32_next_entry

.f32_new_best
	ld	(FAT32_BestCluster),hl
	ld	(FAT32_BestCluster+2),de

	push	bc			; zachovej B = pocitadlo directory entries
	push	ix
	pop	hl
	ld	de,FAT32_BestEntry
	ld	bc,32
	ldir
	pop	bc
	ld	a,1
	ld	(FAT32_Found),a

.f32_next_entry
	ld	de,32
	add	ix,de
	dec	b
	jp	nz,.f32_entry_loop

	; dalsi sektor stejneho root clusteru
	ld	hl,FAT32_DirLBA
	inc	(hl)
	jr	nz,.f32_lba_inc_done
	inc	hl
	inc	(hl)
	jr	nz,.f32_lba_inc_done
	inc	hl
	inc	(hl)
	jr	nz,.f32_lba_inc_done
	inc	hl
	inc	(hl)
.f32_lba_inc_done

	ld	a,(FAT32_SectorsLeft)
	dec	a
	ld	(FAT32_SectorsLeft),a
	jp	nz,.f32_sector_loop

	; Nacti FAT entry pro aktualni root cluster.
	; FAT32 ma 128 zaznamu/sektor => FAT sector = cluster >> 7.
	; CurCluster je little-endian 32bit; FAT32 pouziva jen 28 bitu.
	ld	a,(FAT32_CurCluster)
	ld	h,a
	ld	a,(FAT32_CurCluster+1)
	ld	l,a
	ld	a,(FAT32_CurCluster+2)
	ld	e,a
	ld	d,0
	add	hl,hl
	rl	e
	rl	d
	ld	h,l
	ld	l,e
	ld	e,d
	ld	d,0

	; DEHL = cluster>>7; pricteme absolutni LBA prvni FAT.
	ld	bc,(FAT32_FirstFATLBA)
	add	hl,bc
	ex	de,hl
	ld	bc,(FAT32_FirstFATLBA+2)
	adc	hl,bc
	ex	de,hl

	ex	de,hl			; SD_READ: HL=upper, DE=lower
	ld	ix,BUFFER2
	call	SD_READ

	; offset v FAT sektoru = (cluster & 127)*4
	ld	a,(FAT32_CurCluster)
	and	#7F
	add	a,a
	add	a,a
	ld	l,a
	ld	h,0
	ld	de,BUFFER2
	add	hl,de

	ld	e,(hl)
	inc	hl
	ld	d,(hl)
	inc	hl
	ld	c,(hl)
	inc	hl
	ld	a,(hl)
	and	#0F
	ld	b,a			; BCDE = next cluster (B highest)

	; EOC >= 0FFFFFF8, bad cluster 0FFFFFF7 take also as end.
	ld	a,b
	cp	#0F
	jr	nz,.f32_store_next
	ld	a,c
	cp	#FF
	jr	nz,.f32_store_next
	ld	a,d
	cp	#FF
	jr	nz,.f32_store_next
	ld	a,e
	cp	#F7
	jr	nc,.f32_directory_end

.f32_store_next
	; 0/1 = invalid chain => konec
	ld	a,b
	or	c
	or	d
	jr	nz,.f32_next_valid
	ld	a,e
	cp	2
	jr	c,.f32_directory_end
.f32_next_valid

	ld	(FAT32_CurCluster),de
	ld	h,b
	ld	l,c
	ld	(FAT32_CurCluster+2),hl
	jp	.f32_cluster_loop

.f32_directory_end
	ld	a,(FAT32_Found)
	or	a
	ret	z
	ld	ix,FAT32_BestEntry
	ld	a,1
	ret

;Skutečná fyzická pozice souboru na disku se spočítá tak, že se od čísla clusteru odečte 2, to se vynásobí počtem sektorů na cluster a přičte se začátek datové oblasti. Stejne pro FAT16 i FAT32.

platne	set	1,(hl)
	pop	bc		;tiskova pozice
	push	ix
	pop	hl
	set	7,(ix+10)
	call	T42_TEXT	;vypis jeho nazev
	push	bc		;tiskova pozice
	ld	l,(ix+26)	;;cluster na kterem zacina soubor
	ld	h,(ix+27)
	ld	e,(ix+20)
	ld	d,(ix+21)	;hlde=cluster of a file
	ld	a,2		;nutno odecist 2
	call	SUB32_8

l1F	ld	a,#55		;pocet sektoru na cluster
	call	MUL32x8		;vysledek v HLDE
	exx				;offset souboru presun do alternativnich registru
	pop	bc		;tiskova pozice
	pop	hl
	pop	de		;HLDE=Root Dir FAT32/FAT16
	push	bc		;tiskova pozice

	; V tomto miste uz IX ukazuje na adresarovou polozku MBD, proto nelze
	; testovat FAT typ pres (ix+0). Pouzij globalni priznak fat_type.
	ld	a,(fat_type)
	bit	0,a
	jr	z,l1F_fat16

	; FAT32: zakladem pro prevod clusteru souboru je FirstDataLBA,
	; nikoli RootDirLBA (RootClus nemusi byt 2).
	ld	hl,(FirstDataLBA)
	ld	de,(FirstDataLBA+2)
	call	ADD32_32
	jr	end_partition

				;FAT16: k RootDirLBA nejprve pricteme offset souboru
l1F_fat16	call	ADD32_32

				;pak jeste velikost pevneho Root Directory
	exx

RootEntCnt	ld	hl,#5555
		call	ADD32_32

				;v HLDE je prvni sektor image MBD/MBH, i pro FAT32:)

/*
osetrit:
- DONE neni MBR- pak bude svitit jen jeden radek ve vyisu, a bude snaha datekovat FAT16/FAT32/other
- DONE partisna neni FAT16/FAT32- nech sviti napis "oth" a skoci se na detekci dalsi partisny
- DONE partisna je FAT16/FAT32, ale soubor se nenasel- pak necht sviti cervene No File.
- nyni se automaticky vezme prvni partisna, do VDT, ale chceme tam dat user defined, tzn, pridat kurzor!!!

Nasledne tyto 3 stavy se musi vepsat do VDT tabulky


nova specifikace VDT:
- disk muze mit max 4 primarni partisny. Udaje o nich jsou v MBR v nultem sektoru disku.
- budou dve VDT tabulky pro master a slave= 5x32= 256 bajtu= celkova delka VDT tabulky

- struktura 1 zaznamu (z osmi) ve VDT tabulce:
;offset	pocet	popis
**********************
;0	1	info bajt
;1	4	first LBA sector of first MBD/MBH file on disk
;2	1	reserved
;3	26	user defined text


info bajt o oddilu rika:
;bit 0		0= oddil FAT16/32 jakozto MBR neexistuje
		1= oddil FAT16/32 jakozto MBR existuje
;bit 1		1= pouzitelny oddil pro speccy (tj. obsahuje jako prvni MBD soubor, lze ho pouzit)
		0= nepouzitelny oddil pro speccy (tj. neobsahuje MBD soubor)
;bit 2		0= pokud je bit 1 nulovy, pak 0=zadna smysluplna data nejsou na disku pritomna, 1=jde o disk FAT16/FAT32 bez MBR (bit 3 je pak platny). Pokud je bit 1 nenulovy, pak 0= oddil se nepouziva, 1= oddil se pouziva*
;bit 3		0= FAT16, 1=FAT32 (volitelne)
;bity 4-7	rezervovane
;*v BSDOSu muze soucasne fungovat jen jeden oddil

*/

end_partition
;		cp	4
;		jr	nz,ep2			;NZ= nejdo o prvni partisnu

/*
;zatim budou data ve vsech partisnach
;pokud je General setting nastavena autoconfigurace, tak ulozi vypocteny prvni datovy sector
;		ld	c,a
		ld	a,(@autoconfig)
		or	a
;		ld	a,c
;		jr	z,nemenfirstdatasectorm1
		jr	z,ep2
;davame to pryc, koncepce autoconfigu bude jina, bude auto, nebo manualne
*/

		ld	b,h
		ld	c,l		;dame HL do BC, abychomm mohli vyplnovat VDT tabulku

		ld	hl,(VDT_pointer+1)	;zjistime, zda se nasel MBD soubor
		bit	1,(hl)
		jr	z,ep2			;Z=neobashuje MBD soubor

		ld	h,b
		ld	l,c

		pop	bc		;BC=tiskova pozice
						;obsahuje, tak vypiseme na obrazovku jeho cislo
		push	hl
		push	de			;BCDE= prvni sektor MBD souboru

		ld	(zzbin),hl	;nejprve tisk
		ld	(zzbin+2),de

		call	HL2ASCII32
		ld	hl,zzdec+9
		set	7,(hl)
		ld	hl,zzdec
;		ld	bc,#0B1B
;		pop	bc
lrd1		ld	a,(hl)
		or	a
		jr	nz,lrd2
		inc	hl
		inc	c
		jr	lrd1


lrd2		inc	c		;jeste posun, aby cislo nebylo nalepeno na predchozi text, pokud bude cislo 10 mist
		call	T42_TEXT	;vypis jeho cislo

		pop	de
		pop	hl			;HLDE=prvni sektor MBD souboru

		push	bc		;schovej tiskovou pozici
		ld	c,l
		ld	b,h		

VDT_pointer	ld	hl,#5555
		inc	hl
		ld	(hl),c
		inc	hl
		ld	(hl),b
		inc	hl
		ld	(hl),e
		inc	hl
		ld	(hl),d
		ld	bc,28
ep3		add	hl,bc
		ld	(VDT_pointer+1),hl	;datove sektory jsou vepsany do tabulky, tabulka je pripravena na dalsi zapis

;		ld	de,VDT+5
;		ex	de,hl
;		ld	(hl),e
;		inc	hl
;		ld	(hl),d

ep2		pop	bc			;BC=tiskova pozice
		pop	ix
		pop	af

		inc	b			;zvys poradovy radek
		ld	de,16
		add	ix,de			;move pointer to another partition
		dec	a
ep1		jp	nz,test_partitions		;moc daleko, musim vymyslet jinak

		jr	nemenfirstdatasectorm1

no_partition	;ld	b,#C			;nulovy zaznam v MBR
		;ld	c,1
		pop	bc			;tiskova pozice
		push	bc			;tiskova pozice- znovu ji ulozime
		ld	hl,TEXT_PART_EMPTY
		call	T42_TEXT
		xor	a
		ld	hl,(VDT_pointer+1)
		ld	(hl),a		;nastav bity ve VDT k teto partisne na 0
		ld	bc,32			; VDT zaznam ma 32 bajtu; HL je zde na offsetu 0
		jr	ep3

