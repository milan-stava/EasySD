1 REM EasySD/EasyCF Switcher 1.1 Full GUI ALPHA 9 CURSOR
2 REM alpha5 backend + ASM renderer; no-flicker 26-char editor + cursor
3 REM ARROWS or 7/6 = move, ENTER = activate, E = edit name, X = exit
4 CLEAR 32767
5 LOAD "" CODE 32768
6 BORDER 0: PAPER 0: INK 7: CLS
10 LET wt=32788: LET ac=32791: LET ca=32794
20 LET da=34816: LET dr=34819: LET sy=34822
30 LET ai=36864: LET tx=36870: LET er=36896: LET ar=36897: LET us=36900: LET cb=37120
40 PRINT AT 9,6; INK 6; BRIGHT 1;"Reading VDT..."
50 LET z=USR ca
60 IF PEEK er<>0 THEN GO TO 9000
70 LET a=PEEK ar: LET s=a: IF s>11 THEN LET s=0
80 POKE us,s
90 GO SUB 3000
100 GO TO 1000
1000 REM ----- KEY LOOP -----
1010 LET k$=INKEY$: IF k$="" THEN GO TO 1010
1020 IF k$=CHR$ 11 OR k$="7" THEN GO TO 1100
1030 IF k$=CHR$ 10 OR k$="6" THEN GO TO 1200
1040 IF k$="e" OR k$="E" THEN GO SUB 6500: GO SUB 6000: GO TO 1000
1050 IF k$="x" OR k$="X" THEN GO TO 9500
1060 IF CODE k$=13 THEN GO SUB 6500: GO SUB 7000: GO TO 1000
1070 GO SUB 6500: GO TO 1000
1100 REM ----- HELD UP: FAST, INFO ONLY AFTER RELEASE -----
1110 LET o=s: LET s=s-1: IF s<0 THEN LET s=11
1120 GO SUB 4300: PAUSE 1
1130 LET k$=INKEY$
1140 IF k$=CHR$ 11 OR k$="7" THEN GO TO 1110
1150 GO SUB 5000
1160 GO TO 1000
1200 REM ----- HELD DOWN: FAST, INFO ONLY AFTER RELEASE -----
1210 LET o=s: LET s=s+1: IF s>11 THEN LET s=0
1220 GO SUB 4300: PAUSE 1
1230 LET k$=INKEY$
1240 IF k$=CHR$ 10 OR k$="6" THEN GO TO 1210
1250 GO SUB 5000
1260 GO TO 1000
3000 REM ----- DRAW STATIC SCREEN + ASM MENU -----
3010 CLS
3020 PRINT AT 0,6; INK 6; BRIGHT 1;"SWITCHER 1.1 FULL"
3030 PRINT AT 1,0; INK 5; BRIGHT 1;"CYAN=OK"; INK 7; BRIGHT 0;"  "; INK 2; BRIGHT 1;"RED=NO"; INK 7; BRIGHT 0;"  "; INK 6; BRIGHT 1;"*=ACTIVE"
3040 POKE us,s: LET z=USR da
3050 PRINT AT 18,0; PAPER 0; INK 7; BRIGHT 0;"ENTER=use E=edit X=exit"
3060 PRINT AT 19,0;"ARROWS or 7/6 = move"
3070 GO SUB 5000
3080 RETURN
4000 REM ----- ASM DRAW ONE MENU ROW, I=1..12 -----
4010 POKE ai,i-1: POKE us,s: LET z=USR dr
4020 RETURN
4300 REM ----- FAST CURSOR MOVE: ONLY OLD+NEW ROW -----
4310 POKE us,s
4320 POKE ai,o: LET z=USR dr
4330 POKE ai,s: LET z=USR dr
4340 RETURN
5000 REM ----- SELECTED INFO DIRECTLY FROM CACHE -----
5010 PRINT AT 15,0; PAPER 0; INK 7; BRIGHT 0;"                                "
5020 PRINT AT 15,0;"Selected: ";
5030 LET i=s+1: GO SUB 5200
5040 LET b=cb+s*32
5050 LET l=PEEK (b+1)+256*PEEK (b+2)+256*256*PEEK (b+3)+256*256*256*PEEK (b+4)
5060 PRINT AT 16,0;"                                "
5070 PRINT AT 16,0;"LBA: ";l
5080 PRINT AT 21,0;"                                "
5090 RETURN
5200 REM ----- PRINT SHORT ID FOR I -----
5210 LET p=i: LET d=0
5220 IF i>4 THEN LET d=1: LET p=i-4
5230 IF i>8 THEN LET d=2: LET p=i-8
5240 IF d=0 THEN PRINT "CF P";p
5250 IF d=1 THEN PRINT "S1 P";p
5260 IF d=2 THEN PRINT "S2 P";p
5270 RETURN
5400 REM ----- BUILD SHORT ID D$ FOR I -----
5410 LET p=i: LET d=0
5420 IF i>4 THEN LET d=1: LET p=i-4
5430 IF i>8 THEN LET d=2: LET p=i-8
5440 IF d=0 THEN LET d$="CF P"+CHR$ (48+p)
5450 IF d=1 THEN LET d$="S1 P"+CHR$ (48+p)
5460 IF d=2 THEN LET d$="S2 P"+CHR$ (48+p)
5470 RETURN
5500 REM ----- RESTORE BOTTOM HELP -----
5510 PRINT AT 18,0; PAPER 0; INK 7; BRIGHT 0;"ENTER=use E=edit X=exit         "
5520 PRINT AT 19,0;"ARROWS or 7/6 = move            "
5530 PRINT AT 20,0;"                                "
5540 PRINT AT 21,0;"                                "
5550 RETURN
5600 REM ----- READ ONE 26B NAME FROM CACHE INTO T$ -----
5610 LET b=cb+s*32+6: LET t$="                          ": LET nz=0
5620 FOR j=1 TO 26
5630 LET c=PEEK (b+j-1)
5640 IF c<>0 THEN LET nz=1: LET t$(j)=CHR$ c
5650 NEXT j
5660 IF nz=0 THEN LET t$="": RETURN
5670 LET q=26
5680 IF q>0 AND t$(q)=" " THEN LET q=q-1: GO TO 5680
5690 IF q=0 THEN LET t$="": RETURN
5700 LET t$=t$( TO q)
5710 RETURN
6000 REM ----- EDITOR: HARD LIMIT 26 CHARS, NO FLICKER + CURSOR -----
6010 PAPER 0: INK 7: BRIGHT 0
6020 GO SUB 5600
6025 PRINT AT 19,0;"DEL=backspace  ENTER=save"
6030 PRINT AT 20,0;"Empty line + ENTER = EMPTY ENTRY"
6040 PRINT AT 21,0;"Name:                          "
6050 PRINT AT 21,5;t$
6055 PRINT AT 21,5+LEN t$; INVERSE 1;" "; INVERSE 0
6060 LET k$=INKEY$: IF k$="" THEN GO TO 6060
6070 LET q=CODE k$
6080 IF q=13 THEN GO TO 6300
6090 IF q=12 OR q=8 THEN GO TO 6200
6100 IF q<32 OR q>126 THEN GO SUB 6500: GO TO 6060
6110 IF LEN t$>=26 THEN BEEP 1/50,-5: GO SUB 6500: GO TO 6060
6120 PRINT AT 21,5+LEN t$;k$: LET t$=t$+k$: PRINT AT 21,5+LEN t$; INVERSE 1;" "; INVERSE 0
6130 GO SUB 6500: GO TO 6060
6200 IF LEN t$=0 THEN GO SUB 6500: GO TO 6060
6210 LET q=LEN t$: PRINT AT 21,5+q;" "
6220 IF q=1 THEN LET t$="": GO TO 6240
6230 LET t$=t$( TO q-1)
6240 PRINT AT 21,5+LEN t$; INVERSE 1;" "; INVERSE 0: GO SUB 6500: GO TO 6060
6300 GO SUB 6500
6310 POKE ai,s
6320 FOR j=0 TO 25: POKE tx+j,0: NEXT j
6330 FOR j=1 TO LEN t$: POKE tx+j-1,CODE t$(j): NEXT j
6340 LET z=USR wt
6350 IF PEEK er<>0 THEN GO SUB 8000: GO SUB 5500: RETURN
6360 LET z=USR sy
6370 LET i=s+1: GO SUB 4000
6380 GO SUB 5500
6390 GO SUB 5000
6400 RETURN
6500 REM ----- WAIT UNTIL KEY RELEASED FOR ACTIONS -----
6510 IF INKEY$<>"" THEN GO TO 6510
6520 RETURN
7000 REM ----- ACTIVATE SELECTED RECORD -----
7010 LET b=cb+s*32: LET f=PEEK b: LET v=INT(f/2)-2*INT(f/4)
7020 IF v=0 THEN PRINT AT 21,0; INK 2; BRIGHT 1;"Partition is not usable.       ": BEEP 1/20,-5: PAUSE 20: GO SUB 5000: RETURN
7030 LET oa=a: POKE ai,s
7040 LET z=USR ac
7050 IF PEEK er<>0 THEN GO SUB 8000: RETURN
7060 LET a=s: POKE ar,a
7070 IF oa<=11 THEN LET i=oa+1: GO SUB 4000
7080 LET i=a+1: GO SUB 4000
7090 PRINT AT 21,0; INK 5; BRIGHT 1;"Partition activated.           ": BEEP 1/25,5: PAUSE 15
7100 GO SUB 5000
7110 RETURN
8000 REM ----- SHOW BACKEND ERROR -----
8010 LET q=PEEK er
8020 PRINT AT 21,0; INK 2; BRIGHT 1;"Backend error ";q;"                "
8030 BEEP 1/10,-10: PAUSE 40
8040 RETURN
9000 REM ----- BACKEND/INSTALLATION ERROR -----
9010 CLS
9020 PRINT AT 8,2; INK 2; BRIGHT 1;"Switcher backend not ready"
9030 PRINT AT 10,2; INK 7;"RESULT = ";PEEK er
9040 PRINT AT 12,2;"EasyCF 1.0.1 + EasySD 1.1"
9050 PRINT AT 13,2;"must already be installed."
9060 STOP
9500 REM ----- EXIT MESSAGE BEFORE STOP -----
9510 PAPER 0: INK 7: BRIGHT 0
9520 CLS
9525 IF a>11 THEN PRINT "No active partition.": STOP
9530 LET i=a+1: GO SUB 5400
9540 PRINT INK 5; BRIGHT 1;d$;" ";
9545 LET z=USR (sy+3)
9550 PRINT " now active"
9560 STOP
